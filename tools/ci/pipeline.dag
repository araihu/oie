source=$(host | directory .)
mods=$(cache-volume oie-ci-go-mod-v1)
builds=$(cache-volume oie-ci-go-build-v1)
lintCache=$(cache-volume oie-ci-golangci-lint-v1)
go=$(container | from golang:1.27.3-bookworm@sha256:dc0963f32053e4bc451d24d87e3892d42d01021b61f093e98eb95c0352bb84b0 | with-mounted-cache /go/pkg/mod $mods | with-mounted-cache /root/.cache/go-build $builds | with-mounted-cache /root/.cache/golangci-lint $lintCache | with-env-variable GOWORK off | with-directory /src $source | with-workdir /src)
docker=$(container | from docker:28-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d)
dockerCLI=$($docker | file /usr/local/bin/docker)
plugins=$($docker | directory /usr/local/libexec/docker/cli-plugins)
checked=$($go | with-file /usr/local/bin/docker $dockerCLI | with-directory /usr/local/libexec/docker/cli-plugins $plugins | with-exec -- make check test-race build build-cli | with-exec -- go build -o bin/oie-mock ./cmd/oie-mock)
$checked | stdout

xmppConfig=$($source | file dev/xmpp/prosody.cfg.lua)
xmppStart=$($source | file dev/xmpp/start.sh)
xmppImage=$(container | from prosodyim/prosody:13.0@sha256:c54842dec520463e3557a2d26df3312338003feb4cc943afa92d287a30c02b58 | without-entrypoint | with-file /etc/prosody/prosody.cfg.lua $xmppConfig | with-file /opt/oie/start.sh $xmppStart | with-env-variable OIE_CI_RUN_ID "$OIE_CI_RUN_ID" | with-exec -- sh -c 'mkdir -p /var/lib/prosody/certs && openssl req -x509 -newkey rsa:2048 -nodes -days 30 -subj /CN=localhost -addext subjectAltName=DNS:localhost,IP:127.0.0.1 -keyout /var/lib/prosody/certs/localhost.key -out /var/lib/prosody/certs/localhost.crt')
ca=$($xmppImage | file /var/lib/prosody/certs/localhost.crt)
xmpp=$($xmppImage | with-env-variable OIE_CI_RUN_ID "$OIE_CI_RUN_ID" | without-exposed-port 80 | without-exposed-port 443 | without-exposed-port 5269 | without-exposed-port 5280 | without-exposed-port 5281 | without-exposed-port 5347 | with-exposed-port 5222 | as-service --args=sh,/opt/oie/start.sh)
$go | with-service-binding xmpp $xmpp | with-file /tmp/xmpp-ca.crt $ca | with-env-variable OIE_XMPP_INTEGRATION 1 | with-env-variable OIE_XMPP_CA_FILE /tmp/xmpp-ca.crt | with-env-variable OIE_XMPP_ENDPOINT xmpp:5222 | with-env-variable OIE_CI_RUN_ID "$OIE_CI_RUN_ID" | with-exec -- go test -race -count=1 -v ./tests/xmpp | stdout

npmCache=$(cache-volume oie-ci-npm-v1)
playwright=$(cache-volume oie-ci-playwright-1.62.1)
package=$($source | file tests/browser/package.json)
lock=$($source | file tests/browser/package-lock.json)
app=$($checked | file /src/bin/oie)
mock=$($checked | file /src/bin/oie-mock)
browser=$(container | from node:24.19.0-bookworm-slim@sha256:3638d9a6fe4030bd716be989438248074489337ba3275657f93595428be4fc03 | with-mounted-cache /root/.npm $npmCache | with-mounted-cache /root/.cache/ms-playwright $playwright | with-workdir /src/tests/browser | with-file package.json $package | with-file package-lock.json $lock | with-exec -- npm ci | with-exec -- npx playwright install --with-deps chromium | with-directory /src $source | with-file /src/bin/oie $app | with-file /src/bin/oie-mock $mock | with-file /tmp/xmpp-ca.crt $ca | with-workdir /src | with-service-binding xmpp $xmpp | with-env-variable OIE_XMPP_CA_FILE /tmp/xmpp-ca.crt | with-env-variable OIE_XMPP_ENDPOINT xmpp:5222 | with-env-variable OIE_CI_RUN_ID "$OIE_CI_RUN_ID" | with-exec --expect=ANY -- sh -c 'mkdir -p tests/browser/artifacts; sh tools/ci/browser.sh > tests/browser/artifacts/ci.log 2>&1; result=$?; printf "%s\n" "$result" > /tmp/oie-browser-exit; cat tests/browser/artifacts/ci.log; exit "$result"')
$browser | stdout
$browser | directory /src/tests/browser/artifacts | export "$OIE_CI_ARTIFACTS"
$browser | with-exec -- sh -c 'test "$(cat /tmp/oie-browser-exit)" = 0' | stdout
