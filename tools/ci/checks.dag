source=$(host | directory .)
mods=$(cache-volume oie-ci-go-mod-v1)
builds=$(cache-volume oie-ci-go-build-v1)
lintCache=$(cache-volume oie-ci-golangci-lint-v1)
go=$(container | from golang:1.27.3-bookworm@sha256:dc0963f32053e4bc451d24d87e3892d42d01021b61f093e98eb95c0352bb84b0 | with-mounted-cache /go/pkg/mod $mods | with-mounted-cache /root/.cache/go-build $builds | with-mounted-cache /root/.cache/golangci-lint $lintCache | with-env-variable GOWORK off | with-directory /src $source | with-workdir /src)
go=$($go | with-exec -- sh -c 'apt-get update -qq && apt-get install -y --no-install-recommends ffmpeg && rm -rf /var/lib/apt/lists/*')
docker=$(container | from docker:28-cli@sha256:625d9431a9f54c5a2bc90f24f0e1c3d55b1349fd857dd85035f98c2c9acbdd4d)
dockerCLI=$($docker | file /usr/local/bin/docker)
plugins=$($docker | directory /usr/local/libexec/docker/cli-plugins)
checked=$($go | with-file /usr/local/bin/docker $dockerCLI | with-directory /usr/local/libexec/docker/cli-plugins $plugins | with-exec -- make check test-race build build-cli | with-exec -- go build -o bin/oie-mock ./cmd/oie-mock)
$checked | stdout
