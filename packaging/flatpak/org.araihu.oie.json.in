{
  "app-id": "org.araihu.oie",
  "runtime": "org.gnome.Platform",
  "runtime-version": "50",
  "sdk": "org.gnome.Sdk",
  "command": "oie-desktop",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--socket=pulseaudio",
    "--device=dri",
    "--talk-name=org.kde.StatusNotifierWatcher"
  ],
  "build-options": {
    "no-debuginfo": true
  },
  "modules": [
    {
      "name": "oie",
      "only-arches": ["x86_64"],
      "buildsystem": "simple",
      "build-commands": [
        "install -Dm755 bin/oie-desktop /app/bin/oie-desktop",
        "sed 's|@OIE_EXEC@|oie-desktop|' share/applications/org.araihu.oie.desktop > org.araihu.oie.desktop",
        "install -Dm644 org.araihu.oie.desktop /app/share/applications/org.araihu.oie.desktop",
        "install -Dm644 share/icons/hicolor/512x512/apps/org.araihu.oie.png /app/share/icons/hicolor/512x512/apps/org.araihu.oie.png",
        "install -Dm644 org.araihu.oie.metainfo.xml /app/share/metainfo/org.araihu.oie.metainfo.xml",
        "mkdir -p /app/share/doc",
        "cp -R share/doc/oie /app/share/doc/",
        "chmod -R a+rX /app/share/doc/oie"
      ],
      "sources": [
        {
          "type": "archive",
          "url": "https://github.com/araihu/oie/releases/download/v@VERSION@/oie_v@VERSION@_linux_amd64.tar.gz",
          "sha256": "@LINUX_SHA256@",
          "strip-components": 0
        },
        {
          "type": "file",
          "path": "org.araihu.oie.metainfo.xml"
        }
      ]
    }
  ]
}
