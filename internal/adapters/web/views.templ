package web

import (
	"github.com/araihu/goshtoso/components/appshell"
"github.com/araihu/goshtoso/components/accordion"
	"github.com/araihu/goshtoso/components/avatar"
	"github.com/araihu/goshtoso/components/button"
"github.com/araihu/goshtoso/components/card"
		"github.com/araihu/goshtoso/components/chatbubble"
	"github.com/araihu/goshtoso/components/drawer"
	"github.com/araihu/goshtoso/components/dropdown"
	"github.com/araihu/goshtoso/components/emptystate"
	"github.com/araihu/goshtoso/components/head"
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/components/link"
"github.com/araihu/goshtoso/components/popover"
	"github.com/araihu/goshtoso/components/sidebar"
	"github.com/araihu/goshtoso/components/textarea"
	"github.com/araihu/goshtoso/components/textinput"
 "github.com/araihu/goshtoso/components/toggle"
"github.com/araihu/goshtoso/components/form"
selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/oie/internal/adapters/httpapi/engineapi"
	"strconv"
)

func navigation(v view, id string) sidebar.Config {
 footer:=profile(v,id)
 if id=="mobile-navigation" {footer=nil}
	return sidebar.Config{
		Logo: brand(v), LogoHref: v.href("section", "chats", "chat", "", "q", "", "filter", "all"), DisableSkipLink: true, RootClass: "oie-navigation", FooterSlot: footer,
		Items: []sidebar.Item{
			{ID: "chats", Label: v.Text.Chats, Href: v.href("section", "chats", "chat", "", "q", "", "filter", "all"), Icon: glyph(heroicons.Icon16SolidQueueList), Active: v.Section == "chats", LinkAttrs: applicationNavigationAttrs()},
			{ID: "media", Label: v.Text.SharedMedia, Href: v.href("section", "media", "chat", "", "q", "", "filter", "all"), Icon: glyph(heroicons.Icon16SolidRectangleGroup), Active: v.Section == "media", LinkAttrs: applicationNavigationAttrs()},
			{ID: "archived", Label: v.Text.Archived, Href: v.href("section", "archived", "chat", "", "q", "", "filter", "all"), Icon: glyph(heroicons.Icon16SolidFolder), Active: v.Section == "archived", LinkAttrs: applicationNavigationAttrs()},
			{ID: "favorites", Label: v.Text.Favorites, Href: v.href("section", "favorites", "chat", "", "q", "", "filter", "all"), Icon: glyph(heroicons.Icon16SolidStar), Active: v.Section == "favorites", LinkAttrs: applicationNavigationAttrs()},
		},
	}
}

templ glyph(symbol icon.Symbol) {
	@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: symbol, Decorative: true, RootClass: "oie-icon"})
}

templ brand(v view) {
<span class="oie-brand">
<img class="oie-brand-logo oie-brand-logo-light" src={templ.URL(brandURL("logo-light.svg"))} alt="" aria-hidden="true" width="96" height="36"/>
<img class="oie-brand-logo oie-brand-logo-dark" src={templ.URL(brandURL("logo-dark.svg"))} alt="" aria-hidden="true" width="96" height="36"/>
<span class="sr-only">{v.Text.AppName}</span>
</span>
}

templ page(v view) {
	<!DOCTYPE html>
	<html lang={ v.Locale } data-theme="goshtoso" data-mode={ v.Theme } class={ templ.KV("dark", v.Theme == "dark") }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{v.Text.AppName}</title>
			<link rel="icon" type="image/svg+xml" href={templ.URL(brandURL("favicon.svg"))}/>
<link rel="icon" type="image/png" sizes="32x32" href={templ.URL(brandURL("favicon-32.png"))}/>
<link rel="icon" type="image/png" sizes="16x16" href={templ.URL(brandURL("favicon-16.png"))}/>
<link rel="apple-touch-icon" sizes="180x180" href={templ.URL(brandURL("apple-touch-icon-180.png"))}/>
<link rel="manifest" href={templ.SafeURL("/manifest.webmanifest?lang="+v.Locale)}/>
<meta name="theme-color" content="#6092ab"/>
			<script src="/ui/runtime.js"></script>
<script src="/ui/theme.js"></script>
<script src="/ui/formatting.js"></script>
			@head.Dependencies(head.WithLocalRuntime())
			<link rel="stylesheet" href="/ui/app.css"/>
			<link rel="stylesheet" href="/ui/video.css"/>
<link rel="stylesheet" href="/ui/document.css"/>
<link rel="stylesheet" href="/ui/emoji-picker.css"/>
<script src="/ui/actions.js" defer></script>
<script src="/ui/stars.js" defer></script>
<script src="/ui/previews.js" defer></script>
<script src="/ui/videos.js" defer></script>
<script src="/ui/documents.js" defer></script>
<script src="/ui/shared-content.js" defer></script>
<script src="/ui/live.js" defer></script>
<script src="/ui/emoji-picker.js" defer></script>
<script src="/ui/navigation.js"></script>
if v.DevBuildID!="" {
<script src="/ui/dev-reload.js" data-build-id={v.DevBuildID} defer></script>
}
<meta name="oie-csrf" content={v.CSRF}/>
		</head>
		<body data-open-drawer={v.initialDrawer()} data-engine-id={v.EngineID} data-event-cursor={v.EventCursor} data-conversation-id={v.ChatID} data-account-id={selectedAccountID(v)} data-focus-message={v.FocusMessage} data-context-newer={strconv.FormatBool(v.ContextHasNewer)} data-context-missing={strconv.FormatBool(v.ContextMissing)} data-mock={strconv.FormatBool(v.Preview)}>
@appFragment(v)
		</body>
	</html>
}

// Application state travels with each shell fragment; the head/runtime persists.
templ appFragment(v view) {
<div id="oie-app" hx-history-elt data-route-loading={v.Text.NavLoading} data-route-error={v.Text.NavFailed} data-route-locale={v.Locale} data-route-theme={v.Theme} data-csrf={v.CSRF} data-open-drawer={v.initialDrawer()} data-engine-id={v.EngineID} data-event-cursor={v.EventCursor} data-conversation-id={v.ChatID} data-account-id={selectedAccountID(v)} data-focus-message={v.FocusMessage} data-context-newer={strconv.FormatBool(v.ContextHasNewer)} data-context-missing={strconv.FormatBool(v.ContextMissing)} data-mock={strconv.FormatBool(v.Preview)}>
<p class="oie-live-status" data-navigation-status role="status" aria-live="polite" hidden></p>
@liveCopy(v)
if v.Section=="media" {
@avatarData(v)
}
<div class="oie-live-status" data-live-status role="status" aria-live="polite" hidden></div>
if v.ErrorMessage!="" {
<div class="oie-native-error" role="alert" tabindex="-1" data-native-error>
{v.ErrorMessage}
if v.FormTarget=="send" && (v.Unavailable||v.NotFound) {
@nativeRecovery(v)
}
</div>
}
			<h1 class="sr-only">{v.Text.AppName}</h1>
			@appshell.AppShell(appshell.Config{RootClass: "oie-shell", MainClass: "oie-main", SidebarClass: "oie-sidebar", Sidebar: sidebar.Sidebar(navigation(v,"desktop")), Content: workspace(v), RootAttrs: templ.Attributes{"data-open-chat": strconv.FormatBool(v.ChatOpen)}})
			@settings(v)
			@accounts(v)
@newConversation(v)
@imageViewer(v)
@documentViewer(v)
@roomSessionDialog(v)

if v.Section=="media" {
@conversationDetails(v)
}
</div>
}

templ profile(v view,id string) {
<div class="oie-profile">
@popover.Popover(popover.Config{ID:"account-switcher-"+id,Trigger:accountTrigger(v),Content:accountMenu(v),Placement:popover.PlacementTopStart,Role:"dialog",Label:v.Text.SwitchAccount,RootClass:"oie-account-switcher",PanelClass:"oie-account-popover",TrapFocus:true})
</div>
}

templ accountTrigger(v view){
@button.Button(button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-profile-trigger"),button.WithAttrs(templ.Attributes{"aria-label":v.Text.SwitchAccount,"data-account-switcher":""})){
@profileAvatar(v,v.AccountFilter,v.account(v.AccountFilter).Address,avatar.Config{Name:v.activeAccountName(),Size:avatar.SizeXS})
<span class="oie-profile-identity"><strong>{v.activeAccountName()}</strong><small>{v.activeAccountAddress()}</small></span>
@glyph(heroicons.Icon16SolidEllipsisHorizontal)
}
}

templ accountMenu(v view){
<div class="oie-account-menu">
<nav aria-label={v.Text.SwitchAccount}>
@link.Link(v.href("account","","chat",""),link.WithRootClass("oie-account-choice"),link.WithAttrs(templ.Attributes{"data-switch-account":"","aria-current":strconv.FormatBool(v.AccountFilter=="")})){
<span class="oie-account-all">@glyph(heroicons.Icon16SolidQueueList)</span>
<span class="oie-profile-identity"><strong>{v.Text.AllAccounts}</strong></span>
if v.AccountFilter=="" {
<span class="oie-account-selected" aria-label={v.Text.Active}>@glyph(heroicons.Icon16SolidCheckCircle)</span>
}
}
for _,a:=range v.Accounts {
@link.Link(v.href("account",a.Id,"chat",""),link.WithRootClass("oie-account-choice"),link.WithAttrs(templ.Attributes{"data-switch-account":a.Id,"aria-current":strconv.FormatBool(v.AccountFilter==a.Id)})){
@accountAvatar(v,a,avatar.SizeXS)
<span class="oie-profile-identity"><strong>{a.Label}</strong><small>{a.Address}</small></span>
<span class="oie-account-indicators">
if v.AccountFilter==a.Id {
<span class="oie-account-selected" aria-label={v.Text.Active}>@glyph(heroicons.Icon16SolidCheckCircle)</span>
}
<span data-account-unread={a.Id} class="oie-unread-count" aria-label={v.Text.Unread+": "+strconv.Itoa(v.AccountUnread[a.Id])} hidden?={v.AccountUnread[a.Id]==0}>{strconv.Itoa(v.AccountUnread[a.Id])}</span>
</span>
}
}
</nav>
<div class="oie-account-actions" x-data="{}">
@link.Link(v.addAccountHref(),link.WithRootClass("oie-account-action"),link.WithAttrs(templ.Attributes{"data-add-account":""})){ {v.Text.AddAccount} }
@link.Link(v.accountsHref(""),link.WithRootClass("oie-account-action"),link.WithAttrs(templ.Attributes{"data-open-accounts":""})){ {v.Text.ManageAccounts} }
if v.AccountFilter!="" && connectionState(v,v.AccountFilter)!="not_connected" && connectionState(v,v.AccountFilter)!="unknown" {
@form.Form(form.Config{ID:"",Action:"/ui/accounts/disconnect",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"disconnect"}}){
@mutationFields(v,"disconnect-"+v.AccountFilter,newOperationKey())
<input type="hidden" name="accountId" value={v.AccountFilter}/>
@button.Button(button.WithType("submit"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-account-action")){ {v.Text.Disconnect} }
<div data-form-feedback role="status"></div>
}
}
</div>
</div>
}

templ workspace(v view) {
if v.Section=="media"{
@sharedWorkspace(v)
}else{
	<div id="workspace" class={ "oie-workspace",templ.KV("oie-chat-open",v.ChatOpen) }>
		<section class="oie-list-pane" aria-label={ v.Text.Chats }>
			<div class="oie-list-heading">
				<div class="oie-mobile-nav">
					@sidebar.Overlay(sidebar.OverlayConfig{ID: "mobile-navigation", Sidebar: navigation(v,"mobile-navigation"), TriggerLabel: v.Text.OpenNavigation, Trigger: glyph(heroicons.Icon16SolidBars3)})
				</div>
				<h2>
					switch v.Section {
						case "archived":
							{ v.Text.Archived }
						case "favorites":
							{ v.Text.Favorites }
						case "media":
							{ v.Text.SharedMedia }
						default:
							{ v.Text.Chats }
					}
				</h2>
				<div x-data="{}">
					@button.Button(button.WithRootClass("oie-icon-button oie-new-chat"), button.WithAttrs(templ.Attributes{"aria-label": v.Text.NewChat, "title": v.Text.NewChat,"data-new-conversation":""}), button.WithAlpine(&button.AlpineConfig{OnClick: "$dispatch('drawer:open', {id: 'newchat'})"})) {
						@glyph(heroicons.Icon16SolidPlus)
					}
				</div>

			</div>
			if v.Preview {
				<p class="oie-preview-label">{ v.Text.Preview }</p>
			}
<form action="/" method="get" class="oie-search" role="search">
<input type="hidden" name="account" value={v.AccountFilter}/>
				<input type="hidden" name="section" value={ v.Section }/>
				<input type="hidden" name="filter" value={ v.Filter }/>
				@textinput.TextInput(textinput.Config{ID: "conversation-search", Name: "q", Value: v.Query, Type: textinput.TypeSearch, Placeholder: v.Text.SearchChats, InputAttrs: templ.Attributes{"style": "padding-left:2.5rem;border-radius:1.4rem;background:var(--oie-raised);border-color:var(--oie-border);color:var(--oie-text)"}})
			</form>
			<nav class="oie-filters" aria-label={ v.Text.Chats }>
				@filterLink(v, "all", v.Text.All)
				@filterLink(v, "unread", v.Text.Unread)
				@filterLink(v, "favorites", v.Text.Favorites)
				@filterLink(v, "groups", v.Text.Groups)
			</nav>
<div id="history-status" class="oie-history-status" role="status">@historyBanner(v)</div>
<div class="oie-conversation-scroll" id="conversation-list" data-version={v.conversationListVersion()}>
@conversationList(v)
</div>
			<div class="oie-list-account" x-data="{}">
@profile(v,"compact")
@button.Button(button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-icon-button"),button.WithAttrs(templ.Attributes{"aria-label":v.Text.Settings,"data-footer-settings":""}),button.WithAlpine(&button.AlpineConfig{OnClick:"$dispatch('drawer:open', {id: 'settings'})"})){@glyph(heroicons.Icon16SolidCog6Tooth)}
</div>
			<div class="oie-list-footer" x-data="{}">
				<span class={ "oie-status-dot",templ.KV("oie-status-error",v.Unavailable) } aria-hidden="true"></span>
				<span>{ v.Role }</span>
				@button.Button(button.WithAppearance(button.AppearancePlain), button.WithRootClass("oie-icon-button"), button.WithAttrs(templ.Attributes{"aria-label": v.Text.Settings,"data-footer-settings":""}), button.WithAlpine(&button.AlpineConfig{OnClick: "$dispatch('drawer:open', {id: 'settings'})"})) {
					@glyph(heroicons.Icon16SolidCog6Tooth)
				}
			</div>
		</section>
@conversationPane(v)
	</div>
}
}

templ menuTrigger(label string) {
	@button.Button(button.WithAppearance(button.AppearancePlain), button.WithRootClass("oie-icon-button"), button.WithAttrs(templ.Attributes{"aria-label": label, "title": label})) {
		@glyph(heroicons.Icon16SolidEllipsisHorizontal)
	}
}

templ filterLink(v view, key, label string) {
	@link.Link(v.href("filter", key, "chat", ""), link.WithRootClass("oie-filter"), link.WithAttrs(templ.Attributes{"aria-current": strconv.FormatBool(v.Filter == key), "data-filter": key})) {
		{ label }
	}
}

templ conversationRow(v view, c engineapi.Conversation) {
	<li>
		@link.Link(v.href("chat", c.Id,"message","","infoView","","infoType","","infoCursor","","infoQuery","","infoFocus","","lang",v.Locale,"theme",v.Theme), link.WithRootClass("oie-chat-link"), link.WithAttrs(templ.Attributes{"data-conversation-id": c.Id, "aria-current": strconv.FormatBool(v.Selected != nil && v.Selected.Id == c.Id)})) {
			@profileAvatar(v,c.AccountId,c.Address,avatar.Config{Name: c.Title, Initials: chatInitials(c), Size: avatar.SizeSM, RootClass: "oie-chat-avatar"})
			<div class="oie-row-content">
				<div class="oie-row-top"><strong>{ c.Title }</strong><time datetime={ c.UpdatedAt.Format("2006-01-02T15:04:05Z07:00") }>{ c.UpdatedAt.Format("15:04") }</time></div>
				<div class="oie-row-bottom">
					<span>{ c.LastMessage }</span>
					if c.UnreadCount>0 {
						<span class="oie-unread-count" aria-label={ v.Text.Unread + ": " + strconv.Itoa(c.UnreadCount) }>{ strconv.Itoa(c.UnreadCount) }</span>
					} else if c.Favorite {
						<span class="oie-pin" title={ v.Text.Favorites }>@glyph(heroicons.Icon16SolidStar)</span>
					}
				</div>
if len(v.Accounts)>1 {
<small class="oie-row-account">{v.accountLabel(c.AccountId)}</small>
}
			</div>
		}
	</li>
}

templ chatHeader(v view) {
	<header class="oie-chat-header" id="chat-header" data-version={v.headerVersion()} x-data="{}">
		@link.Link(v.href("chat", ""), link.WithRootClass("oie-back-button"), link.WithAttrs(templ.Attributes{"aria-label": v.Text.Back})) {
			@glyph(heroicons.Icon16SolidChevronLeft)
		}
		@profileAvatar(v,v.Selected.AccountId,v.Selected.Address,avatar.Config{Name: v.Selected.Title, Initials: chatInitials(*v.Selected), Size: avatar.SizeXS})
		<div class="oie-chat-identity"><h2>{ v.Selected.Title }</h2><p>{v.accountLabel(v.Selected.AccountId)} · {v.connectionLabel(v.Selected.AccountId)}</p></div>
		@button.Button(button.WithAppearance(button.AppearancePlain), button.WithRootClass("oie-icon-button"), button.WithAttrs(templ.Attributes{"aria-label": v.Text.Details, "title": v.Text.Details,"data-open-details":""}), button.WithAlpine(&button.AlpineConfig{OnClick: "$dispatch('drawer:open', {id: 'details'})"})) {
			@glyph(heroicons.Icon16SolidInformationCircle)
		}
{{ sections:=[]dropdown.Section{{Items:[]dropdown.Item{{Label:v.Text.Details,OnClick:"$dispatch('drawer:open', {id: 'details'})"},{Label:v.Text.Settings,OnClick:"$dispatch('drawer:open', {id: 'settings'})"}}}} }}
if v.Selected.Kind=="room" {
{{ sections=append(sections,dropdown.Section{Items:[]dropdown.Item{{ID:"chat-room-actions",Label:v.Text.RoomActions,OnClick:"$dispatch('modal:open', {id: 'room-session-dialog'})"},{ID:"chat-leave-room",Label:v.Text.LeaveRoom,Icon:glyph(heroicons.Icon16SolidArrowTopRightOnSquare),OnClick:"$dispatch('oie:leave-room')",Disabled:v.RoomSession==nil||!v.RoomSession.Active||!v.messagingImplemented("room_messaging")}}}) }}
}
		@dropdown.Dropdown(dropdown.Config{ID:"chat-options",Label:v.Text.More,Trigger:menuTrigger(v.Text.More),MenuAlign:dropdown.AlignEnd,Sections:sections})
	</header>
}

templ message(v view,m messageView,grouped bool){
<div class={"oie-message",templ.KV("oie-message-own",m.IsOwn),templ.KV("oie-message-grouped",grouped)} tabindex="-1" data-message-id={m.Id} data-starred={strconv.FormatBool(v.StarsKnown&&v.Stars[m.Id].Starred)} data-send-state={string(m.SendState)} data-created-at={m.CreatedAt.Format("2006-01-02T15:04:05Z07:00")} data-message-source={originalMessageJSON(m.OriginalText)}>
@viewerSource(v,m)
if m.Attachment!=nil {
<div class="oie-media-message">@card.Card(card.Config{Image:m.Attachment.PreviewUrl,ImageAlt:m.Attachment.Title,Title:m.Attachment.Title,Description:m.Attachment.Description,Density:card.DensityCompact,RootClass:"oie-media-card"})</div>
}else{
<div class="oie-message-content">
if !m.IsOwn && !grouped {
@profileAvatar(v,m.AccountId,v.messageAvatarAddress(m),avatar.Config{Name:m.Sender.DisplayName,Initials:initials(m.Sender.DisplayName),Size:avatar.SizeSM})
}
@chatbubble.ChatBubble(chatbubble.Config{Side:messageSide(m.IsOwn),Message:m.OriginalText,MessageContent:messageBubbleBody(v,m,grouped),RootClass:"oie-bubble",Grouped:grouped})
<span class="oie-message-star-indicator" data-message-star-indicator hidden?={!v.StarsKnown||!v.Stars[m.Id].Starred} role="img" aria-label={v.Text.StarMessage}>@glyph(heroicons.Icon16SolidStar)</span>
</div>
}

if m.IsOwn {
<div class="oie-message-meta"><time datetime={m.CreatedAt.Format("2006-01-02T15:04:05Z07:00")}>{m.CreatedAt.Format("15:04")}</time>
<span data-message-status title={statusHint(v,m.SendState)}>{v.stateLabel(m.SendState)}</span>
if m.SendState=="queued" && !v.Preview {
@form.Form(form.Config{ID:"cancel-"+m.Id,Action:"/ui/messages/cancel",Method:"post",RootClass:"oie-cancel-form",RootAttrs:templ.Attributes{"data-oie-action":"cancel","data-cancel-message":""}}){
@mutationFields(v,"cancel-"+m.Id,newOperationKey())
<input type="hidden" name="messageId" value={m.Id}/><input type="hidden" name="expectedRevisionId" value={m.RevisionId}/>
@button.Button(button.WithType("submit"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"aria-label":v.Text.CancelSend})){ {v.Text.CancelSend} }
<div data-form-feedback role="status" aria-live="polite"></div>
}
}
</div>
}
</div>
}
func statusHint(v view,state engineapi.MessageSendState)string{if state=="submitted"{return v.Text.SubmittedHint};if state=="unknown"{return v.Text.UnknownHint};return v.stateLabel(state)}

func messageSide(own bool) chatbubble.Side {
	if own {
		return chatbubble.Sent
	}
	return chatbubble.Received
}

func selectedAccountID(v view)string{if v.Selected!=nil{return v.Selected.AccountId};return ""}

templ composer(v view){
<form id="send-message-form" action="/ui/messages/send" method="post" data-oie-action="send" data-send-allowed={strconv.FormatBool(v.sendAllowed())} data-compose-allowed={strconv.FormatBool(v.composeAllowed())} data-reply-allowed={strconv.FormatBool(v.replyAllowed())}>
@mutationFields(v,"send",sendKey(v))
<input type="hidden" name="conversationId" value={v.ChatID}/><input type="hidden" name="accountId" value={selectedAccountID(v)}/>
<input type="hidden" name="replyToMessageId" value=""/>
@composerReply(v)
<div class="oie-composer">
@button.Button(button.Disabled(),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-icon-button"),button.WithAttrs(templ.Attributes{"aria-label":v.Text.Attach,"title":v.Text.MediaUnavailable})){@glyph(heroicons.Icon16SolidPlus)}
@textarea.Textarea(textarea.Config{ID:"message-composer",Name:"originalText",Value:v.field("originalText"),Rows:1,Placeholder:v.Text.Message,Disabled:!v.composeAllowed(),RootClass:"oie-composer-input",InputAttrs:templ.Attributes{"aria-label":v.Text.Message,"style":"resize:none;field-sizing:content;min-height:var(--oie-composer-control-size,2.75rem);line-height:1.25rem;padding-block:calc((var(--oie-composer-control-size,2.75rem) - 1.25rem - 2px)/2);max-height:min(12rem,30dvh);overflow-y:auto;background:var(--oie-raised);border-color:var(--oie-border);border-radius:1.5rem;color:var(--oie-text)"}})
@emojiPicker(v)
@button.Button(button.WithType("submit"),button.WithRootClass("oie-icon-button oie-send"),button.WithAttrs(templ.Attributes{"aria-label":v.Text.Send,"data-send-message":"","disabled":!v.sendAllowed()})){@glyph(heroicons.Icon16SolidArrowUp)}
</div>
<div class="oie-composer-feedback" data-form-feedback role="status" aria-live="polite"></div>
</form>
}
func sendKey(v view)string{if v.FormTarget=="send"&&v.field("operationKey")!=""{return v.field("operationKey")};return newOperationKey()}

templ settings(v view) {
	@drawer.Drawer(drawer.Config{ID: "settings", Title: v.Text.Settings}) {
		<div class="oie-settings">
			<h2>{ v.Text.Appearance }</h2>
			<p>{ v.Text.ThemeHelp }</p>
			<div class="oie-settings-links" aria-label={ v.Text.Appearance }>
				@link.Link(v.href("theme", "system")) {
					{ v.Text.System }
				}
				@link.Link(v.href("theme", "light")) {
					{ v.Text.Light }
				}
				@link.Link(v.href("theme", "dark")) {
					{ v.Text.Dark }
				}
			</div>
			<h2>{ v.Text.Languages }</h2>
			<p>{ v.Text.LanguageHelp }</p>
			<div class="oie-settings-links" aria-label={ v.Text.Languages }>
				@link.Link(v.href("lang", "en")) {
					{ v.Text.English }
				}
				@link.Link(v.href("lang", "pt-BR")) {
					{ v.Text.Portuguese }
				}
			</div>
			<h2>{v.Text.DevicePreferences}</h2>
@toggle.Toggle(toggle.Config{ID:"render-markdown",Label:v.Text.RenderMarkdown,Checked:true,RootClass:"oie-device-toggle",InputAttrs:templ.Attributes{"data-render-markdown":"","aria-describedby":"render-markdown-help"}})
<p id="render-markdown-help">{v.Text.RenderMarkdownHelp}</p>
@toggle.Toggle(toggle.Config{ID:"auto-image-downloads",Label:v.Text.AutoImageDownloads,Checked:true,RootClass:"oie-device-toggle",InputAttrs:templ.Attributes{"data-auto-image-downloads":"","aria-describedby":"auto-image-downloads-help"}})
<p id="auto-image-downloads-help">{v.Text.AutoImageDownloadsHelp}</p>
<p class="oie-settings-note" data-device-preference-warning role="status" hidden>{v.Text.DevicePreferenceUnavailable}</p>
<h2>{ v.Text.EngineState }</h2>
			<p>{ v.Role }</p>
			if v.Preview {
				<p class="oie-settings-note">{ v.Text.PreviewOnly }</p>
			}
		</div>
	}
}

templ accounts(v view){
@drawer.Drawer(drawer.Config{ID:"accounts",Title:v.Text.Accounts,PanelClass:v.accountDrawerClass()}){
<div class={"oie-account-workspace",templ.KV("oie-account-list-workspace",v.accountScreen()=="list")}>
switch v.accountScreen() {
case "add":
@accountBack(v)
<div class="oie-account-intro"><h2>{v.Text.AddAccount}</h2><p>{v.Text.AddAccountHelp}</p></div>
@form.Form(form.Config{ID:"register-account-form",Action:"/ui/accounts/register",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"register"}}){
@mutationFields(v,"register",registerKey(v))
@textinput.TextInput(textinput.Config{ID:"register-address",Name:"address",Label:v.Text.AccountAddress,Placeholder:v.Text.AddressPlaceholder,Value:v.field("address"),Required:true,Autocomplete:"username"})
@textinput.TextInput(textinput.Config{ID:"register-label",Name:"label",Label:v.Text.AccountLabel,Placeholder:v.Text.LabelPlaceholder,Value:v.field("label"),Required:true})
@button.Button(button.WithType("submit")){ {v.Text.RegisterAccount} }
<div data-form-feedback role="status" aria-live="polite"></div>
}
case "capabilities":
@accountCapabilities(v)
case "detail":
@accountBack(v)
if a:=v.account(v.managedAccountID());a.Address!="" {
<div id="account-blocks">@accountDetail(v,a)</div>
}else if v.Unavailable {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.Unavailable,Description:v.Text.UnavailableBody})
@link.Link(v.accountsHref(v.managedAccountID())){ {v.Text.Retry} }
}else{
@emptystate.EmptyState(emptystate.Config{Title:v.Text.AccountMissing,Description:v.Text.AccountHelp})
}
default:
<div id="account-overview">@accountOverview(v)</div>
<footer class="oie-account-list-footer">
@link.Link(v.addAccountHref(),link.WithAppearance(link.AppearanceButton),link.WithRootClass("oie-add-account"),link.WithAttrs(templ.Attributes{"data-account-add":""})){@glyph(heroicons.Icon16SolidPlus)<span>{v.Text.AddAccount}</span>}
</footer>
}
</div>
}
}
func registerKey(v view)string{if v.FormTarget=="register"&&validOperationKey(v.field("operationKey")){return v.field("operationKey")};return newOperationKey()}
templ accountBack(v view){
@link.Link(v.accountsHref(""),link.WithRootClass("oie-account-back"),link.WithAttrs(templ.Attributes{"data-account-back":""})){@glyph(heroicons.Icon16SolidChevronLeft)<span>{v.Text.BackToAccounts}</span>}
}
templ accountOverview(v view){
if v.Unavailable {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.Unavailable,Description:v.Text.UnavailableBody})
@link.Link(v.accountsHref("")){ {v.Text.Retry} }
}else if len(v.Accounts)==0 {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.EmptyTitle,Description:v.Text.AddAccountHelp})
}else{
<nav class="oie-account-list" aria-label={v.Text.ManageAccounts}>
for _,a:=range v.Accounts {
@link.Link(v.accountsHref(a.Id),link.WithRootClass("oie-account-summary"),link.WithAttrs(templ.Attributes{"data-manage-account":a.Id})){
@profileAvatar(v,a.Id,a.Address,avatar.Config{Name:a.Label,Size:avatar.SizeSM})
<span class="oie-profile-identity"><strong>{a.Label}</strong><small>{a.Address}</small><small>{v.connectionLabel(a.Id)}</small></span>
@glyph(heroicons.Icon16SolidChevronRight)
}
}
</nav>
}
}
templ mutationFields(v view,target,key string){
<input type="hidden" name="csrf" value={v.CSRF}/><input type="hidden" name="engineId" value={v.EngineID}/><input type="hidden" name="returnTo" value={v.href()}/><input type="hidden" name="formTarget" value={target}/><input type="hidden" name="operationKey" value={key}/>
}
templ accountDetail(v view,a engineapi.Account){
<section class="oie-account-detail" data-account-id={a.Id}>
<header class="oie-account-detail-heading">
@accountAvatar(v,a,avatar.SizeLG)
<div><h2>{a.Label}</h2><p>{a.Address}</p></div>
</header>
<p class="oie-history-status">{v.historyCaption(a.Id)}</p>
<div id={"connection-error-"+a.Id} role="status" aria-live="polite">
if problem:=v.connectionError(a.Id);problem!="" {
<p class="oie-field-error">{problem}</p>
}
</div>
@accountConnectionControls(v,a.Id)
@link.Link(v.capabilitiesHref(a.Id),link.WithRootClass("oie-capabilities-link"),link.WithAttrs(templ.Attributes{"data-account-capabilities":a.Id})){<span><strong>{v.Text.Capabilities}</strong><small>{v.Text.CapabilitiesIntro}</small></span>@glyph(heroicons.Icon16SolidChevronRight)}
</section>
}
templ accountAvatar(v view,a engineapi.Account,size avatar.Size){
<div class="inline-flex shrink-0" data-account-status={a.Id} data-connection-state={connectionState(v,a.Id)} title={v.connectionLabel(a.Id)} role="img" aria-label={v.connectionLabel(a.Id)}>
@profileAvatar(v,a.Id,a.Address,avatar.Config{Name:a.Label,Size:size,Status:connectionAvatarStatus(v,a.Id)})
</div>
}
templ accountConnectionControls(v view,id string){
<div id={"connection-controls-"+id} data-connection-state={connectionState(v,id)}>
if state:=connectionState(v,id);state=="not_connected"||state=="error" {
@form.Form(form.Config{ID:"connect-"+id,Action:"/ui/accounts/connect",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"connect","data-connect-account":""}}){
@mutationFields(v,"connect-"+id,newOperationKey())
<input type="hidden" name="accountId" value={id}/>
@textinput.TextInput(textinput.Config{ID:"password-"+id,Name:"password",Type:textinput.TypePassword,Label:v.Text.Password,Required:true,Autocomplete:"current-password",HelperText:v.Text.PasswordHelp})
@accordion.Accordion(accordion.AccordionConfig{ID:"connection-advanced-"+id,RootClass:"oie-account-advanced",Items:[]accordion.AccordionItem{{ID:"endpoint-advanced-"+id,Title:v.Text.AdvancedConnection,Content:connectionEndpoint(v,id),InitiallyExpanded:connectionField(v,id,"endpoint")!=""}}})
@button.Button(button.WithType("submit")){ {v.Text.Connect} }
<div data-form-feedback role="status" aria-live="polite"></div>
}
}
@disconnectAction(v,id)
</div>
}
templ connectionEndpoint(v view,id string){
@textinput.TextInput(textinput.Config{ID:"endpoint-"+id,Name:"endpoint",Label:v.Text.Endpoint,HelperText:v.Text.EndpointHelp,Value:connectionField(v,id,"endpoint")})
}
templ disconnectAction(v view,id string){
if state:=connectionState(v,id);state=="connected"||state=="connecting"||state=="error" {
@form.Form(form.Config{ID:"disconnect-"+id,Action:"/ui/accounts/disconnect",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"disconnect","data-disconnect-account":""}}){
@mutationFields(v,"disconnect-"+id,newOperationKey())
<input type="hidden" name="accountId" value={id}/>
@button.Button(button.WithType("submit"),button.WithAppearance(button.AppearancePlain)){ {v.Text.Disconnect} }
<div data-form-feedback role="status" aria-live="polite"></div>
}
}
}
func connectionField(v view,id,key string)string{if v.FormTarget=="connect-"+id{return v.field(key)};return ""}
func connectionState(v view,id string)string{if c:=v.Connections[id];c.Known{return string(c.Value.State)};return "unknown"}
func accountOptions(v view,all bool)[]selectfield.Option{
 out:=[]selectfield.Option{}
 if all{out=append(out,selectfield.Option{Value:"",Label:v.Text.AllAccounts,Selected:v.AccountFilter==""})}
 selected:=v.AccountFilter;if !all{selected=v.selectedAccount()}
 for _,a:=range v.Accounts{out=append(out,selectfield.Option{Value:a.Id,Label:a.Label+" · "+a.Address,Selected:selected==a.Id})};return out
}
templ newConversation(v view){
@drawer.Drawer(drawer.Config{ID:"newchat",Title:v.Text.NewChat}){
<div class="oie-settings">
if len(v.Accounts)==0 {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.EmptyTitle,Description:v.Text.NoChatsBody})
@link.Link(v.addAccountHref()){ {v.Text.AddAccount} }
}else{
@form.Form(form.Config{ID:"new-conversation-form",Action:"/ui/conversations/open",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"open"}}){
@mutationFields(v,"open",newOperationKey())
<div id="newchat-account-select">@selectfield.Select(selectfield.Config{ID:"sending-account",Name:"accountId",Label:v.Text.ChooseAccount,Options:accountOptions(v,false),Required:true})</div>
@textinput.TextInput(textinput.Config{ID:"peer-address",Name:"address",Label:v.Text.PeerAddress,Placeholder:v.Text.AddressPlaceholder,Value:v.field("address"),Required:true})
@button.Button(button.WithType("submit")){ {v.Text.StartConversation} }
<div data-form-feedback role="status" aria-live="polite"></div>
}
}
</div>
}
}
templ liveCopy(v view){
<div id="oie-star-copy" hidden data-star={v.Text.StarMessage} data-unstar={v.Text.UnstarMessage} data-retry={v.Text.RetryStar} data-uncertain={v.Text.StarUncertain} data-storage={v.Text.StarStorageUnavailable}></div>
<div id="oie-star-status" class="sr-only" role="status" aria-live="polite"></div>
<p id="oie-star-storage-warning" class="oie-star-warning" role="status" hidden>{v.Text.StarStorageUnavailable}</p>
<div id="oie-formatting-copy" hidden data-copy={v.Text.CopyOriginal} data-copied={v.Text.MessageCopied} data-failed={v.Text.CopyFailed}></div>
<div id="oie-copy-status" class="sr-only" role="status" aria-live="polite"></div>
<div id="oie-preview-copy" hidden data-refresh-failed={v.Text.RefreshPreviewFailed} data-refresh-loading={v.Text.PreviewLoading} data-loading={v.Text.LoadingImage} data-image={v.Text.ImageView} data-not-downloaded={v.Text.ImageNotDownloaded} data-failed={v.Text.ImageDownloadFailed}></div>
<div id="oie-live-copy" hidden data-reply-unavailable={v.Text.ReplyUnavailable} data-reply-preparing={v.Text.ReplyPreparing} data-reply-locked={v.Text.ReplyLocked} data-room-command-unknown={v.Text.RoomCommandUnknown} data-saving={v.Text.Saving} data-invalid-message={v.Text.InvalidMessage} data-pending={v.Text.PendingAcceptance} data-storage-unavailable={v.Text.DraftStorageUnavailable} data-locked={v.Text.DraftLocked} data-retry={v.Text.RetrySubmission} data-send={v.Text.Send} data-live-ready={v.Text.LiveReady} data-live-retry={v.Text.LiveRetry} data-live-connecting={v.Text.LiveConnecting} data-latest={v.Text.JumpToLatest} data-new-messages={v.Text.NewMessages} data-engine-changed={v.Text.EngineChanged} data-today={v.Text.Today}></div>
}
templ liveRegions(v view){
<div id="oie-live-regions" data-engine-id={v.EngineID} data-event-cursor={v.EventCursor} data-conversation-id={v.ChatID} data-account-id={selectedAccountID(v)} data-focus-message={v.FocusMessage} data-context-newer={strconv.FormatBool(v.ContextHasNewer)} data-context-missing={strconv.FormatBool(v.ContextMissing)} data-unavailable={strconv.FormatBool(v.Unavailable)} data-accounts-version={v.accountVersion()}>
@avatarData(v)
if v.Section!="media"{
@starData(v)
}
if v.Selected!=nil {
if v.InfoView=="shared" || v.InfoView=="stars" {
<div id="live-info-content" data-info-view={v.InfoView}>@chatInfoContent(v)</div>
}
<div id="live-conversation-details" data-details-conversation={v.Selected.Id}>
<div id="live-details-identity" data-version={v.detailsVersion("identity")}>@detailsIdentity(v)</div>
<div id="live-details-account" data-version={v.detailsVersion("account")}>@detailsAccount(v)</div>
<div id="live-details-metadata" data-version={v.detailsVersion("metadata")}>@detailsMetadata(v)</div>
<div id="live-details-participants" data-version={v.detailsVersion("participants")}>@detailsParticipants(v)</div>
</div>
}
<div id="live-room-session">@roomSessionStatus(v)</div>
<div id="live-context-notice">@contextNotice(v)</div>
if v.Section=="media"{
<div id="live-shared-content"><div id="live-shared-status">@sharedStatus(v)</div><div id="live-shared-results" data-version={v.sharedVersion()}>@sharedItems(v)</div><div id="live-shared-pagination">@sharedPagination(v)</div></div>
}
<div id="live-history-status">@historyBanner(v)</div>
<div id="live-list" data-version={v.conversationListVersion()}>@conversationList(v)</div>
<div id="live-timeline" data-version={v.timelineVersion()}>@timeline(v)</div>
<div id="live-header" data-version={v.headerVersion()}>
if v.Selected!=nil {
@chatHeader(v)
}
</div>
<div id="live-account-blocks">
if v.accountScreen()=="detail" {
if a:=v.account(v.managedAccountID());a.Address!="" {
@accountDetail(v,a)
}
}
</div>
<div id="live-account-overview">@accountOverview(v)</div>
if v.accountScreen()=="capabilities" {
<div id="live-account-capabilities">@capabilityContent(v)</div>
}
<div id="live-account-menu">@accountMenu(v)</div>
<div id="live-newchat-account">@selectfield.Select(selectfield.Config{ID:"sending-account",Name:"accountId",Label:v.Text.ChooseAccount,Options:accountOptions(v,false),Required:true})</div>
</div>
}

templ conversationList(v view){
if v.Unavailable {
<div class="oie-list-state">
@emptystate.EmptyState(emptystate.Config{Title:v.Text.Unavailable,Description:v.Text.UnavailableBody})
@link.Link(v.href()){ {v.Text.Retry} }
</div>
}else if len(v.Chats)==0 {
<div class="oie-list-state">
if v.Query!=""||v.Filter!="all" {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.NoResults,Description:v.Text.NoResultsBody})
}else{
@emptystate.EmptyState(emptystate.Config{Title:v.Text.NoChats,Description:v.Text.NoChatsBody})
}
</div>
}else{
<ul class="oie-conversations">
for _,c:=range v.Chats {
@conversationRow(v,c)
}
</ul>
}
}

templ timeline(v view){
<div class="oie-day-divider"><span>{v.Text.Today}</span></div>
for index,m:=range v.Messages {
@message(v,m,index>0&&v.Messages[index-1].Sender.Id==m.Sender.Id&&v.Messages[index-1].Sender.DisplayName==m.Sender.DisplayName&&v.Messages[index-1].IsOwn==m.IsOwn&&v.Messages[index-1].Attachment==nil&&m.Attachment==nil)
}
}

templ nativeRecovery(v view){
<form action="/ui/messages/send" method="post" class="oie-native-recovery">
@mutationFields(v,"send",v.field("operationKey"))
<input type="hidden" name="conversationId" value={v.field("conversationId")}/><input type="hidden" name="accountId" value={v.field("accountId")}/>
@textarea.Textarea(textarea.Config{ID:"native-retained-message",Name:"originalText",Label:v.Text.Message,Value:v.field("originalText"),ReadOnly:true,Rows:4})
@button.Button(button.WithType("submit")){ {v.Text.RetrySubmission} }
</form>
}

templ historyBanner(v view){
if v.AccountFilter!="" {
{v.historyCaption(v.AccountFilter)}
}else{
for _,a:=range v.Accounts {
if h,ok:=v.Histories[a.Id];ok&&(h.State=="syncing"||h.State=="partial"||h.State=="error") {
<p>{a.Label}: {v.historyCaption(a.Id)}</p>
}
}
}
}

// The scope belongs to Oie. Avatar's public SrcExpr consumes a fixed expression;
// opaque addresses are escaped HTML data, never JavaScript source.
templ profileAvatar(v view,account,address string,cfg avatar.Config){
{{
 cfg.Src=v.avatarSource(account,address);cfg.SrcExpr="oieAvatarSrc"
 fallback:=cfg;fallback.Src="";fallback.SrcExpr=""
}}
<div class="oie-avatar-scope" data-avatar-account={account} data-avatar-address={address} data-avatar-src={cfg.Src} x-data="{oieAvatarSrc: $el.dataset.avatarSrc}">
<div class="oie-avatar-initials" data-avatar-initials x-show="!oieAvatarSrc">@avatar.Avatar(fallback)</div>
<template x-if="oieAvatarSrc">@avatar.Avatar(cfg)</template>
</div>
}

templ avatarData(v view){
<div id="oie-avatar-data" hidden>
for _,account:=range v.AvatarAccounts {
<div data-avatar-loaded-account={account}></div>
}
for identity,hash:=range v.Avatars {
<div data-avatar-entry data-account-id={identity.Account} data-address={identity.Address} data-hash={hash}></div>
}
</div>
}

// The public rich-content slot owns the header and corner control together, so
// positioning never depends on ChatBubble's private row or bubble selectors.
templ messageBubbleBody(v view,m messageView,grouped bool){
<div class={"oie-message-body",templ.KV("oie-message-body-compact",m.IsOwn||grouped)} data-message-bubble={m.Id}>
<div class="oie-message-menu-slot" data-message-menu-slot={m.Id}>
@dropdown.Dropdown(dropdown.Config{ID:"message-menu-"+m.Id,Label:v.Text.MessageActions,Trigger:messageMenuTrigger(v,m.Id),RootClass:"oie-message-menu",MenuAlign:dropdown.AlignEnd,Sections:messageActions(v,m.Id)})
</div>
if !m.IsOwn && !grouped {
<div class="oie-message-heading"><strong>{m.Sender.DisplayName}</strong><time datetime={m.CreatedAt.Format("2006-01-02T15:04:05Z07:00")}>{m.CreatedAt.Format("15:04")}</time></div>
}
@messageBody(v,m)
</div>
}

// Rendered and original projections share one public ChatBubble content slot.
// A device preference switches visibility without replacing message rows.
templ messageBody(v view,m messageView){
@replyCard(v,m)
<div data-message-presentation data-presentation-known={strconv.FormatBool(m.PresentationKnown)} data-presentation-version={originalMessageJSON(m.presentationText())}>
<div class="oie-rendered-message" data-rendered-message>
if m.Formatted!=nil {
@m.Formatted
}else{
<div class="oie-plain-fallback">{m.presentationText()}</div>
}
</div>
<div class="oie-original-message" data-original-message>{m.presentationText()}</div>
</div>
<div class="oie-message-previews" data-message-previews={m.Id}>
for _,p:=range v.MessagePreviews[m.Id] {
@messagePreview(v,p)
}
</div>
<div data-message-videos={m.Id}>
for _,item:=range v.messageVideos(m.Id) {
@videoCard(v,item)
}
</div>
if messageEdited(m) {
<small class="oie-message-edited" data-message-edited data-edited-at={messageEditedAt(m)}>{v.Text.Edited}</small>
}
}


templ starData(v view){
<div id="oie-star-data" hidden data-known={strconv.FormatBool(v.StarsKnown)}>
for _,star:=range v.Stars {
<div data-star-state data-star-source={star.MessageId} data-starred={strconv.FormatBool(star.Starred)} data-revision={starRevision(star)}></div>
}
</div>
}
templ starButton(v view,id string){
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithRootClass("oie-star-message"),button.WithAttrs(templ.Attributes{"data-star-message":id,"data-starred":strconv.FormatBool(v.Stars[id].Starred),"aria-label":v.starLabel(id),"title":v.starLabel(id),"aria-pressed":strconv.FormatBool(v.Stars[id].Starred),"hidden":!v.StarsKnown,"disabled":!v.StarsKnown})){
@glyph(heroicons.Icon16SolidStar)
}
}

templ messageMenuTrigger(v view,id string){
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-menu-chevron"),button.WithAttrs(templ.Attributes{"data-message-menu-trigger":id,"aria-label":v.Text.MessageActions,"title":v.Text.MessageActions})){@glyph(heroicons.Icon16SolidChevronDown)}
}
templ viewerSource(v view,m messageView){
<template data-viewer-source={m.Id}>
<div class="oie-viewer-source" data-viewer-source-id={m.Id}>
@profileAvatar(v,m.AccountId,v.messageAvatarAddress(m),avatar.Config{Name:m.Sender.DisplayName,Initials:initials(m.Sender.DisplayName),Size:avatar.SizeXS})
<div class="oie-viewer-sender"><strong title={m.Sender.DisplayName}>{m.Sender.DisplayName}</strong><time data-viewer-date datetime={m.CreatedAt.Format("2006-01-02T15:04:05Z07:00")}>{m.CreatedAt.Format("2006-01-02 15:04")}</time></div>
</div>
</template>
}

templ replyCard(v view,m messageView){
if m.Reply!=nil {
if replyNavigable(m.Reply) {
@link.Link(v.replyHref(m),link.WithRootClass("oie-reply-link"),link.WithAttrs(templ.Attributes{"data-reply-target":*m.Reply.MessageId,"data-reply-conversation":m.ConversationId})){
@card.Card(card.Config{Title:v.replySender(m.Reply),Body:replyExcerpt(v,m.Reply),Density:card.DensityCompact,RootClass:"oie-reply-card"})
}
}else{
<div data-reply-unavailable>@card.Card(card.Config{Title:v.replySender(m.Reply),Body:replyExcerpt(v,m.Reply),Density:card.DensityCompact,RootClass:"oie-reply-card"})</div>
}
}
}
templ replyExcerpt(v view,r *engineapi.MessageReply){
<p class="oie-reply-excerpt">{r.Excerpt}</p>
if !replyNavigable(r){
<small class="oie-reply-unavailable">{v.Text.OriginalUnavailable}</small>
}
}
templ contextNotice(v view){
if v.ContextMissing {
<p>{v.Text.OriginalUnavailable} @link.Link(v.latestHref(),link.WithAttrs(templ.Attributes{"data-return-latest":""})){ {v.Text.JumpToLatest} }</p>
}
}
