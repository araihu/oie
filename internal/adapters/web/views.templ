package web

import (
	"github.com/araihu/goshtoso/components/appshell"
"github.com/araihu/goshtoso/components/accordion"
	"github.com/araihu/goshtoso/components/avatar"
	"github.com/araihu/goshtoso/components/button"
"github.com/araihu/goshtoso/components/card"
		"github.com/araihu/goshtoso/components/chatbubble"
	"github.com/araihu/goshtoso/components/drawer"
	"github.com/araihu/goshtoso/components/dropdown"
	"github.com/araihu/goshtoso/components/emptystate"
	"github.com/araihu/goshtoso/components/fileinput"
	"github.com/araihu/goshtoso/components/head"
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/oie/internal/adapters/web/appicons"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/components/modal"
"github.com/araihu/goshtoso/components/popover"
	"github.com/araihu/goshtoso/components/sidebar"
	"github.com/araihu/goshtoso/components/spinner"
	"github.com/araihu/goshtoso/components/tooltip"
	"github.com/araihu/goshtoso/components/textarea"
	"github.com/araihu/goshtoso/components/textinput"
	"github.com/araihu/goshtoso/components/toast"
 "github.com/araihu/goshtoso/expressions"
"github.com/araihu/goshtoso/components/form"
selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/oie/internal/adapters/httpapi/engineapi"
	"strconv"
	"strings"
)

func navigation(v view, id string) sidebar.Config {
	cfg := sidebar.Config{
		DisableSkipLink: true, RootClass: "oie-navigation", FooterSlot: navigationFooter(v,id),
		Items: []sidebar.Item{
			{ID: "chats", Label: v.Text.Chats, Href: v.href("section", "chats", "chat", "", "q", "", "filter", "all"), Icon: appicons.Icon(appicons.Config{Symbol: appicons.IconHeroicons16SolidChatBubbleLeft, Decorative: true, RootClass: "oie-icon"}), Active: v.Section == "chats" || v.Section == "archived", LinkAttrs: sidebarNavigationAttrs()},

            {ID: "media", Label: v.Text.SharedMedia, Href: v.href("section", "media", "chat", "", "q", "", "filter", "all"), Icon: glyph(heroicons.Icon16SolidRectangleGroup), Active: v.Section == "media", LinkAttrs: sidebarNavigationAttrs()},
			{ID: "favorites", Label: v.Text.Favorites, Href: v.favoritesHref(""), Icon: glyph(heroicons.Icon16SolidStar), Active: v.Section == "favorites", LinkAttrs: sidebarNavigationAttrs()},
		},
	}
	if !v.Preview {
		cfg.Items = append(cfg.Items, sidebar.Item{ID:"scheduled", Label:v.Text.Scheduled, Href:v.scheduleHref(""), Icon:glyph(heroicons.Icon16SolidClock), Active:v.Section=="scheduled", LinkAttrs:sidebarNavigationAttrs()})
	}
	if id == "mobile-navigation" {
		cfg.Logo = brand(v)
		cfg.LogoHref = v.href("section", "chats", "chat", "", "q", "", "filter", "all")
	}
	return cfg
}

templ desktopNavigation(v view) {
	@sidebar.Sidebar(navigation(v,"desktop"))
	<div class="oie-sidebar-splitter" role="separator" tabindex="0" aria-orientation="vertical" aria-controls="desktop-navigation" aria-label={v.Text.Navigation} data-sidebar-splitter></div>
}

templ sourceDesktopNavigation(v view) {
	<div id="desktop-navigation">@sidebar.Sidebar(navigation(v,"desktop"))</div>
}

templ navigationControl(v view) {
	@button.Button(button.WithRootClass("oie-icon-button oie-sidebar-toggle"), button.WithAttrs(templ.Attributes{
		"type": "button", "data-sidebar-toggle": "", "aria-controls": "desktop-navigation",
		"data-expand-label": v.Text.ExpandNavigation, "data-collapse-label": v.Text.CollapseNavigation,
		"aria-expanded": "true", "aria-label": v.Text.CollapseNavigation, "title": v.Text.CollapseNavigation,
	})) {
		@glyph(heroicons.Icon16SolidBars3)
	}
	<div class="oie-mobile-nav">
		@sidebar.Overlay(sidebar.OverlayConfig{ID: "mobile-navigation", Sidebar: navigation(v,"mobile-navigation"), TriggerLabel: v.Text.OpenNavigation, TriggerClass: "oie-mobile-nav-trigger", PanelClass: "oie-mobile-nav-panel", Trigger: glyph(heroicons.Icon16SolidBars3)})
	</div>
}

templ glyph(symbol icon.Symbol) {
	@icon.Icon(icon.Config{SpriteURL: heroicons.SpriteURL, Symbol: symbol, Decorative: true, RootClass: "oie-icon"})
}

templ brand(v view) {
<span class="oie-brand">
<img class="oie-brand-logo oie-brand-logo-light" src={templ.URL(brandURL("logo-light.svg"))} alt="" aria-hidden="true" width="96" height="36"/>
<img class="oie-brand-logo oie-brand-logo-dark" src={templ.URL(brandURL("logo-dark.svg"))} alt="" aria-hidden="true" width="96" height="36"/>
<span class="sr-only">{v.Text.AppName}</span>
</span>
}

templ page(v view) {
	<!DOCTYPE html>
	<html lang={ v.Locale } data-theme="goshtoso" data-mode={ v.Theme } class={ templ.KV("dark", v.Theme == "dark") }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover"/>
			<title>{v.Text.AppName}</title>
			<link rel="icon" type="image/svg+xml" href={templ.URL(brandURL("favicon.svg"))}/>
<link rel="icon" type="image/png" sizes="32x32" href={templ.URL(brandURL("favicon-32.png"))}/>
<link rel="icon" type="image/png" sizes="16x16" href={templ.URL(brandURL("favicon-16.png"))}/>
<link rel="apple-touch-icon" sizes="180x180" href={templ.URL(brandURL("apple-touch-icon-180.png"))}/>
<link rel="manifest" href={templ.SafeURL("/manifest.webmanifest?lang="+v.Locale)}/>
<meta name="theme-color" content="#6092ab"/>
			<script src="/ui/runtime.js"></script><script src="/ui/viewport.js" defer></script><script src="/ui/inbox-cache.js"></script><script src="/ui/event-stream.js"></script><script src="/ui/presentation-time.js" defer></script>
<script src="/ui/theme.js"></script>
<script src="/ui/sidebar.js"></script>
<script src="/ui/formatting.js"></script>
<script src="/ui/forwarding.js" defer></script>
<script src="/ui/message-retractions.js" defer></script>
<script src="/ui/room-entry.js"></script>
<script src="/ui/room-management.js"></script>
			@head.Dependencies(head.WithLocalRuntime())
			<link rel="stylesheet" href={templ.URL(versionedStylesheetURL("/ui/app.css",stylesheet))}/>
<link rel="stylesheet" href={templ.URL(versionedStylesheetURL("/ui/message-search.css",messageSearchStylesheet))}/>
<link rel="stylesheet" href="/ui/conversation-search.css"/>
			<link rel="stylesheet" href="/ui/shared-actions.css"/><link rel="stylesheet" href="/ui/message-star.css"/>
<link rel="stylesheet" href="/ui/timeline.css"/>
<link rel="stylesheet" href="/ui/video.css"/>
<link rel="stylesheet" href={templ.URL(versionedStylesheetURL("/ui/document.css",documentStylesheet))}/>
<link rel="stylesheet" href="/ui/emoji-picker.css"/><link rel="stylesheet" href="/ui/mentions.css"/>
<script src="/ui/actions.js" defer></script><script src="/ui/notifications.js" defer></script>
<script src="/ui/masonry.js" defer></script>
<script src="/ui/stars.js" defer></script>
<script src="/ui/reactions.js" defer></script><link rel="stylesheet" href="/ui/reactions.css"/>
<script src="/ui/sender.js" defer></script>
<script src="/ui/message-history.js" defer></script>
<link rel="stylesheet" href="/ui/message-history.css"/>
<link rel="stylesheet" href="/ui/message-correction.css"/>
<script src="/ui/conversation-preferences.js" defer></script>
<script src="/ui/contacts.js" defer></script>
<script src="/ui/typing.js" defer></script>
<script src="/ui/message-search.js" defer></script>
<script src="/ui/conversation-search.js" defer></script>
<script src="/ui/previews.js" defer></script>
<script src="/ui/videos.js" defer></script>
<script src="/ui/message-audio.js" defer></script>
<script src="/ui/video-thumbnails.js" defer></script>
<script src="/ui/cache.js" defer></script>
<script src="/ui/documents.js" defer></script>
<script src="/ui/shared-content.js" defer></script>
<script src="/ui/shared-actions.js" defer></script>
<script src="/ui/room-archive.js" defer></script>
<script src="/ui/timeline.js" defer></script>
<script src="/ui/reset-data.js" defer></script>
if v.OfflineHistory {
<script src="/ui/offline-history.js" defer></script>
}
<script src="/ui/live.js" defer></script><script src="/ui/draft-link-preview.js" defer></script><link rel="stylesheet" href="/ui/draft-link-preview.css"/><script src="/ui/scheduling.js" defer></script><link rel="stylesheet" href="/ui/scheduling.css"/><script src="/ui/read-state.js" defer></script>
<script src="/ui/emoji-picker.js" defer></script><script src="/ui/emoji-completion.js" defer></script><script src="/ui/mentions.js" defer></script>
<script src="/ui/navigation.js"></script>
if v.DevBuildID!="" {
<script src="/ui/dev-reload.js" data-build-id={v.DevBuildID} defer></script>
}
<meta name="oie-csrf" content={v.CSRF}/>
<noscript><style>#composer-split{display:none}.oie-cancel-form{display:flex!important}.oie-message-meta:has(>.oie-cancel-form){margin-top:4px}</style></noscript>
		</head>
		<body data-reset-complete={v.Text.DeleteDataComplete} data-open-drawer={v.initialDrawer()} data-engine-id={v.EngineID} data-event-cursor={v.EventCursor} data-conversation-id={v.ChatID} data-account-id={selectedAccountID(v)} data-first-unread={v.FirstUnread} data-focus-message={v.FocusMessage} data-context-newer={strconv.FormatBool(v.ContextHasNewer)} data-context-missing={strconv.FormatBool(v.ContextMissing)} data-mock={strconv.FormatBool(v.Preview)}>
@appFragment(v)
		</body>
	</html>
}

// Application state travels with each shell fragment; the head/runtime persists.
templ appFragment(v view) {
<div id="oie-app" hx-history-elt { appRouteAttrs(v)... }>
@toast.ToastContainer(toast.ContainerConfig{}).WithExpressions(expressions.Toast{DismissLabel:v.Text.Close,DismissAriaLabel:v.Text.Close})
<h1 class="sr-only">{v.Text.AppName}</h1>
@appshell.AppShell(appshell.Config{RootClass: "oie-shell", MainClass: "oie-main", SidebarClass: "oie-sidebar", Sidebar: desktopNavigation(v), SidebarAttrs: templ.Attributes{"id": "desktop-navigation"}, Content: routeContent(v), RootAttrs: templ.Attributes{"data-open-chat": strconv.FormatBool(v.ChatOpen)}})
</div>
}

func appRouteAttrs(v view) templ.Attributes {
	return templ.Attributes{
		"data-shared-account":v.AccountFilter,"data-route-error":v.Text.NavFailed,"data-route-locale":v.Locale,"data-route-theme":v.Theme,"data-csrf":v.CSRF,
		"data-open-drawer":v.initialDrawer(),"data-engine-id":v.EngineID,"data-event-cursor":v.EventCursor,"data-conversation-id":v.ChatID,"data-account-id":selectedAccountID(v),
		"data-first-unread":v.FirstUnread,"data-focus-message":v.FocusMessage,"data-context-newer":strconv.FormatBool(v.ContextHasNewer),"data-context-missing":strconv.FormatBool(v.ContextMissing),"data-mock":strconv.FormatBool(v.Preview),
	}
}

templ sourceRouteFragment(v view) {
<div id="oie-app" data-source-route { appRouteAttrs(v)... }>
@sourceDesktopNavigation(v)
@routeContent(v)
</div>
}

templ routeContent(v view) {
<div id="oie-route" class="oie-route" data-open-chat={strconv.FormatBool(v.ChatOpen)} data-engine-unavailable?={v.Unavailable}>
if !v.CompactSource {
<div data-route-shared-copy>
@liveCopy(v)
<p class="sr-only" data-read-status data-read-failed={v.Text.ReadFailed} role="status" aria-live="polite" hidden></p>
<div data-shared-action-copy hidden data-failed={v.Text.SharedActionFailed} data-copied={v.Text.SharedLinkCopied} data-downloading={v.Text.SharedDownloading}></div>
<div class="sr-only" data-live-status role="status" aria-live="polite" hidden></div>
</div>
}
if v.Section=="media" {
@avatarData(v)
}
if v.ErrorMessage!="" && !v.accountEditorHasError() {
<div class="oie-native-error" role="alert" tabindex="-1" data-native-error>
{v.ErrorMessage}
if v.PreferenceRecovery {
@nativeConversationPreferenceRecovery(v)
}
if v.FormTarget=="send" && (v.Unavailable||v.NotFound) {
@nativeRecovery(v)
}
</div>
}
			@workspaceWithLoading(v)
if !v.CompactSource {
<div data-route-settings>
@settings(v)
if v.CanResetData {
@destructiveActions(v)
}
@about(v)
</div>
}
			@accounts(v)
@newConversation(v)
if !v.Preview {
@roomEntryDrawer(v,false)
@roomEntryDrawer(v,true)
}
if !v.CompactSource {
<div data-route-viewers>
@quickMessageSearch(v)
@imageViewer(v)
@documentViewer(v)
</div>
}
@reactionPicker(v)
if !v.Preview {
@forwardDialog(v)
@retractMessageDialog(v)
}



if v.Section=="media" {
@conversationDetails(v)
}
</div>
}

templ profile(v view,id string) {
<div class="oie-profile">
@popover.Popover(popover.Config{ID:"account-switcher-"+id,Trigger:accountTrigger(v),Content:accountMenu(v),Placement:popover.PlacementTopStart,Role:"dialog",Label:v.Text.SwitchAccount,RootClass:"oie-account-switcher",PanelClass:"oie-account-popover",TrapFocus:true})
</div>
}

templ accountTrigger(v view){
{{ border := v.AccountAvatarBorders[v.AccountFilter] }}
@button.Button(button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-profile-trigger"),button.WithAttrs(templ.Attributes{"aria-label":v.Text.SwitchAccount,"data-account-switcher":"","data-active-account-name":v.activeAccountName(),"data-account-avatar-border":border})){
@profileAvatar(v,v.AccountFilter,v.account(v.AccountFilter).Address,avatar.Config{Name:v.activeAccountName(),Size:avatar.SizeXS,Border:border!="",BorderColor:border})
<span class="oie-profile-identity"><strong>{v.activeAccountName()}</strong><small>{v.activeAccountAddress()}</small></span>
@glyph(heroicons.Icon16SolidEllipsisHorizontal)
}
}

templ accountMenu(v view){
<div class="oie-account-menu">
<nav aria-label={v.Text.SwitchAccount}>
@link.Link(v.href("account","","chat",""),link.WithRootClass("oie-account-choice"),link.WithAttrs(templ.Attributes{"data-switch-account":"","aria-current":strconv.FormatBool(v.AccountFilter=="")})){
<span class="oie-account-all">@glyph(heroicons.Icon16SolidQueueList)</span>
<span class="oie-profile-identity"><strong>{v.Text.AllAccounts}</strong></span>
if v.AccountFilter=="" {
<span class="oie-account-selected" aria-label={v.Text.Active}>@glyph(heroicons.Icon16SolidCheckCircle)</span>
}
}
for _,a:=range v.Accounts {
@link.Link(v.href("account",a.Id,"chat",""),link.WithRootClass("oie-account-choice"),link.WithAttrs(templ.Attributes{"data-switch-account":a.Id,"aria-current":strconv.FormatBool(v.AccountFilter==a.Id)})){
@accountAvatar(v,a,avatar.SizeXS)
<span class="oie-profile-identity"><strong data-account-name={a.Id}>{a.Label}</strong><small>{a.Address}</small></span>
<span class="oie-account-indicators">
if v.AccountFilter==a.Id {
<span class="oie-account-selected" aria-label={v.Text.Active}>@glyph(heroicons.Icon16SolidCheckCircle)</span>
}
<span data-account-unread={a.Id} class="oie-unread-count" aria-label={v.Text.Unread+": "+strconv.Itoa(v.AccountUnread[a.Id])} hidden?={v.AccountUnread[a.Id]==0}>{strconv.Itoa(v.AccountUnread[a.Id])}</span>
</span>
}
}
</nav>
<div class="oie-account-actions" x-data="{}">
@link.Link(v.addAccountHref(),link.WithRootClass("oie-account-action"),link.WithAttrs(templ.Attributes{"data-add-account":""})){ {v.Text.AddAccount} }
@link.Link(v.accountsHref(""),link.WithRootClass("oie-account-action"),link.WithAttrs(templ.Attributes{"data-open-accounts":""})){ {v.Text.ManageAccounts} }
if v.AccountFilter!="" && connectionState(v,v.AccountFilter)!="not_connected" && connectionState(v,v.AccountFilter)!="unknown" {
@form.Form(form.Config{ID:"",Action:"/ui/accounts/disconnect",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"disconnect"}}){
@mutationFields(v,"disconnect-"+v.AccountFilter,newOperationKey())
<input type="hidden" name="accountId" value={v.AccountFilter}/>
@button.Button(button.WithType("submit"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-account-action")){ {v.Text.Disconnect} }
<div data-form-feedback role="status"></div>
}
}
</div>
</div>
}

templ workspaceWithLoading(v view) {
@workspace(v)
if v.Section!="media" {
@sharedSkeleton(v,true)
}
}

templ workspace(v view) {
if v.NativeMessageSearch {
@messageSearchWorkspace(v)
}else if v.Section=="media"{
@sharedWorkspace(v)
}else if v.Section=="scheduled" {
@scheduledWorkspace(v)
}else if v.Section=="favorites" {
@favoritesWorkspace(v)
}else{
	<div id="workspace" class={ "oie-workspace",templ.KV("oie-chat-open",v.ChatOpen) }>
		<section class="oie-list-pane" aria-label={ v.Text.Chats }>
			<div class="oie-list-heading">
				@navigationControl(v)
				<h2>
					switch v.Section {
						case "archived":
							{ v.Text.Archived }
						case "media":
							{ v.Text.SharedMedia }
						default:
							{ v.Text.Chats }
					}
				</h2>
				@dropdown.Dropdown(dropdown.Config{ID:"new-conversation-menu",Label:v.Text.NewChat,Trigger:newConversationTrigger(v),MenuAlign:dropdown.AlignEnd,Sections:[]dropdown.Section{{Items:newConversationActions(v)}}})

			</div>
			if v.Preview {
				<p class="oie-preview-label">{ v.Text.Preview }</p>
			}
<form id="conversation-filter-form" action="/search" method="get" class="oie-search" role="search" data-global-search-form>
<input type="hidden" name="account" value={v.AccountFilter}/>
<input type="hidden" name="accountId" value={v.AccountFilter}/>
<input type="hidden" name="lang" value={v.Locale}/><input type="hidden" name="theme" value={v.Theme}/>
				<input type="hidden" name="section" value={ v.Section }/>
				<input type="hidden" name="filter" value={ v.Filter }/>
				{{ searchValue := v.Query; if v.GlobalMessageSearch { searchValue = v.MessageSearch.Query } }}
				@textinput.TextInput(textinput.Config{ID: "conversation-search", Name: "q", Value: searchValue, Type: textinput.TypeSearch, Placeholder: v.Text.SearchEverything, InputAttrs: templ.Attributes{"aria-label":v.Text.SearchEverything,"aria-keyshortcuts":"Control+K Meta+K","style": "padding-inline-end:2.5rem;border-radius:1.4rem;background:var(--oie-raised);border-color:var(--oie-border);color:var(--oie-text)"}})
				@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-icon-button oie-global-search-cancel"),button.WithAttrs(templ.Attributes{"data-message-search-close":"","aria-label":v.Text.SearchCancel,"title":v.Text.SearchCancel,"hidden":!v.GlobalMessageSearch})){@glyph(heroicons.Icon16SolidXMark)}
			</form>
@messageSearchSlot(v)
@inboxList(v)
			<div class="oie-list-account" x-data="{}">
@profile(v,"compact")

</div>
		</section>
@conversationPane(v)
	</div>
}
}

templ menuTrigger(label string) {
	@button.Button(button.WithAppearance(button.AppearancePlain), button.WithRootClass("oie-icon-button"), button.WithAttrs(templ.Attributes{"aria-label": label, "title": label})) {
		@glyph(heroicons.Icon16SolidEllipsisHorizontal)
	}
}

templ inboxList(v view) {
<div id="conversation-list-default" class="oie-list-default" data-inbox-scope={v.conversationScope()} data-inbox-filter={v.Filter} hidden?={v.GlobalMessageSearch}>
			<nav class="oie-filters" aria-label={ v.Text.Chats } hidden?={ v.Section == "archived" }>
				@filterLink(v, "all", v.Text.All)
				@filterLink(v, "unread", v.Text.Unread)
				@filterLink(v, "favorites", v.Text.Favorites)
				@filterLink(v, "groups", v.Text.Groups)
			</nav>
			@archivedRow(v)
<div class="oie-conversation-scroll" id="conversation-list" data-inbox-cache-scope={v.inboxCacheScope()} data-inbox-cursor={v.EventCursor} data-inbox-reuse?={v.ReuseInbox} data-version={v.conversationListVersion()}>
if !v.ReuseInbox {
@conversationList(v)
}
</div>
</div>
}

templ archivedRow(v view) {
	{{
		attrs := sidebarNavigationAttrs()
		destination := "archived"
		if v.Section == "archived" {
			destination = "chats"
			attrs["data-active"] = ""
			attrs["aria-label"] = v.Text.ArchivedBackToChats
		}
	}}
	@link.Link(v.href("section", destination, "chat", "", "q", "", "filter", "all"), link.WithRootClass("oie-archived-row"), link.WithAttrs(attrs)) {
		@appicons.Icon(appicons.Config{Symbol: appicons.IconHeroiconsArchive16SolidArchiveBoxArrowDown, Decorative: true, RootClass: "oie-icon"})
		<span>{ v.Text.Archived }</span>
		if v.Section == "archived" {
			<span class="oie-archived-close">@glyph(heroicons.Icon16SolidXMark)</span>
		}
	}
}

templ filterLink(v view, key, label string) {
	@link.Link(v.filterHref(key), link.WithRootClass("oie-filter"), link.WithAttrs(templ.Attributes{"aria-current": strconv.FormatBool(v.Filter == key), "data-filter": key})) {
		{ label }
	}
}

templ conversationRow(v view, c engineapi.Conversation) {
	{{ attrs := navigationAttrs("conversation-pane", "conversation", "outerHTML settle:0ms show:none") }}
	{{ attrs["data-conversation-id"] = c.Id }}
	{{ attrs["aria-current"] = strconv.FormatBool(v.ChatID == c.Id) }}
	{{ roomLabel, roomIndicator := v.roomStatusPresentation(c.RoomStatus) }}
	{{ border := v.AccountAvatarBorders[c.AccountId] }}
	<li data-conversation-row={c.Id} data-version={v.conversationRowVersion(c)}
		if c.Request == nil && c.LatestMessagePageCount != nil && *c.LatestMessagePageCount >= 0 && *c.LatestMessagePageCount <= timelinePageSize {
			data-latest-message-page-count={strconv.Itoa(*c.LatestMessagePageCount)}
		}
	>
		@link.Link(v.href("chat", c.Id,"message","","infoView","","infoType","","infoCursor","","infoQuery","","infoFocus","","lang",v.Locale,"theme",v.Theme), link.WithRootClass("oie-chat-link"), link.WithAttrs(attrs)) {
			@avatarScope(v,c.AccountId,c.Address,avatar.Config{Name:c.Title,Initials:chatInitials(c),Size:avatar.SizeSM,RootClass:"oie-chat-avatar",Status:roomIndicator,Border:border!="",BorderColor:border},true)
			<div class="oie-row-content">
				<div class="oie-row-top"><strong>{ c.Title }</strong><time datetime={ c.UpdatedAt.Format("2006-01-02T15:04:05Z07:00") }>{ c.UpdatedAt.Format("15:04") }</time></div>
				<div class="oie-row-bottom">
					<span>{ v.requestLabel(c) }</span>
					if roomLabel != "" && c.Request == nil {
						if roomIndicator == avatar.StatusSuccess {
							<span class="sr-only" data-room-status-label>{ roomLabel }</span>
						} else {
							<span class="oie-row-room-status" data-room-status-label title={ roomLabel }>{ roomLabel }</span>
						}
					}
					if c.Kind=="room" {
						<span class="oie-row-mention-slot">
							if c.UnreadMention!=nil && *c.UnreadMention {
								<span class="oie-row-mention" data-unread-mention role="img" aria-label={ v.Text.UnreadMention } title={ v.Text.UnreadMention }>{ "@" }</span>
							}
						</span>
					}
					if c.UnreadCount>0 {
						<span class="oie-unread-count" aria-label={ v.Text.Unread + ": " + strconv.Itoa(c.UnreadCount) }>{ strconv.Itoa(c.UnreadCount) }</span>
					} else if hasUnread(c) {
						<span class="oie-unread-count oie-unread-reminder" role="img" aria-label={v.Text.Unread}></span>
					}
					if c.Favorite {
						<span class="oie-conversation-favorite" role="img" aria-label={ v.Text.Favorites } title={ v.Text.Favorites }>@glyph(heroicons.Icon16SolidHeart)</span>
					}
				</div>
if len(v.Accounts)>1 {
<small class="oie-row-account">{v.accountLabel(c.AccountId)}</small>
}
			</div>
		}
	</li>
}

templ chatHeader(v view) {
	{{ roomLabel, roomIndicator := v.roomStatusPresentation(v.selectedRoomStatus()) }}
	{{ border := v.AccountAvatarBorders[v.Selected.AccountId] }}
	<header class="oie-chat-header" id="chat-header" data-version={v.headerVersion()} x-data="{}">
@conversationPreferenceData(v)
if v.requestKind()=="" {
<noscript>@link.Link(v.messageSearchHref(v.Selected.AccountId,v.Selected.Id)){ {v.Text.SearchMessages} }</noscript>
}
		@link.Link(v.href("chat", ""), link.WithRootClass("oie-back-button"), link.WithAttrs(templ.Attributes{"aria-label": v.Text.Back})) {
			@glyph(heroicons.Icon16SolidChevronLeft)
		}
		<div class="oie-chat-avatar">
			@profileAvatar(v,v.Selected.AccountId,v.Selected.Address,avatar.Config{Name: v.Selected.Title, Initials: chatInitials(*v.Selected), Size: avatar.SizeXS, Status: roomIndicator, Border:border!="", BorderColor:border})
			if v.requestKind()=="" {
				@button.Button(
					button.WithType("button"),
					button.WithAppearance(button.AppearancePlain),
					button.WithRootClass("oie-chat-avatar-trigger"),
					button.WithAttrs(templ.Attributes{"aria-label": v.Text.Details, "aria-haspopup": "dialog", "title": v.Text.Details}),
					button.WithAlpine(&button.AlpineConfig{OnClick: "$el.focus({preventScroll:true}); $dispatch('drawer:open', {id:'details'})"}),
				) {}
			}
		</div>
		<div class="oie-chat-identity">
			<h2>{ v.Selected.Title }</h2>
			if roomLabel != "" && v.requestKind() == "" {
				<p title={ roomLabel }><span data-room-status-label>{ roomLabel }</span> · { v.accountLabel(v.Selected.AccountId) }</p>
			} else if v.conversationRemoved() {
				<p>{ v.Text.ConversationRemoved } · { v.accountLabel(v.Selected.AccountId) }</p>
			} else {
				<p>{ v.accountLabel(v.Selected.AccountId) } · { v.connectionLabel(v.Selected.AccountId) }</p>
			}
		</div>
if v.requestKind()=="" {
{{ sections:=[]dropdown.Section{{Items:[]dropdown.Item{{ID:"chat-conversation-details",Label:v.Text.Details,Icon:glyph(heroicons.Icon16SolidInformationCircle),OnClick:"$dispatch('oie:conversation-drawer-open','details')"}}}} }}
if !v.conversationRemoved() {
{{ sections=append(sections,v.conversationPreferenceSection()) }}
}
{{ sections=append(sections,dropdown.Section{Items:[]dropdown.Item{{ID:"chat-search-messages",Label:v.Text.SearchMessages,Icon:glyph(heroicons.Icon16SolidMagnifyingGlass),OnClick:"$dispatch('oie:conversation-search-open')"}}}) }}
if v.conversationSchedulesAvailable() {
{{ sections[0].Items=append(sections[0].Items,dropdown.Item{Label:v.Text.Scheduled,Icon:glyph(heroicons.Icon16SolidClock),OnClick:"$dispatch('oie:conversation-drawer-open','conversation-schedules')"}) }}
}
if v.Selected.Kind=="room" && !v.conversationRemoved() {
{{ roomItems:=[]dropdown.Item{{ID:"chat-manage-room",Label:v.Text.RoomManage,Icon:glyph(heroicons.Icon16SolidCog6Tooth),OnClick:"void 0"}} }}
if v.canInviteToRoom() {
{{ roomItems=append(roomItems,dropdown.Item{ID:"chat-invite-room",Label:v.Text.RoomInvitePeople,Icon:glyph(heroicons.Icon16SolidUsers),OnClick:"void 0"}) }}
}
{{ roomItems=append(roomItems,dropdown.Item{ID:"chat-leave-room",Label:v.Text.LeaveRoom,Icon:roomExitIcon(),OnClick:"$dispatch('oie:leave-room')",Disabled:!v.canLeaveRoom()}) }}
if v.canJoinRoom() {
{{ roomItems=append(roomItems,dropdown.Item{ID:"chat-join-room",Label:v.Text.JoinRoom,Icon:appicons.Icon(appicons.Config{Symbol:appicons.IconHeroiconsRoomEntry16SolidArrowLeftEndOnRectangle,Decorative:true,RootClass:"oie-icon"}),OnClick:"$dispatch('oie:join-saved-room')"}) }}
}
if v.canRemoveFromChats() {
{{ roomItems=append(roomItems,v.removeFromChatsItem("chat-remove-room")) }}
}
{{ sections=append(sections,dropdown.Section{Items:roomItems}) }}
} else if v.canRemoveFromChats() {
{{ sections=append(sections,dropdown.Section{Items:[]dropdown.Item{v.removeFromChatsItem("chat-remove-direct")}}) }}
}
		@dropdown.Dropdown(dropdown.Config{ID:"chat-options",Label:v.Text.More,Trigger:menuTrigger(v.Text.More),MenuAlign:dropdown.AlignEnd,Sections:sections})
}
	</header>
}

templ message(v view,m messageView,grouped,groupEnd bool){
{{ position := messageTimelineTime(m.Message) }}
<div class={"oie-message",templ.KV("oie-message-own",m.IsOwn),templ.KV("oie-message-mentioned",m.mentionsYou()),templ.KV("oie-message-grouped",grouped),templ.KV("oie-message-group-end",groupEnd)} tabindex="-1" data-message-id={m.Id} data-read-eligible={strconv.FormatBool(!m.IsOwn&&(m.Historical==nil||!*m.Historical))} data-starred={strconv.FormatBool(v.StarsKnown&&v.Stars[m.Id].Starred)} data-send-state={string(m.SendState)} data-created-at={position.Format("2006-01-02T15:04:05Z07:00")} data-created-ms={strconv.FormatInt(position.UnixMilli(),10)} data-timeline-release?={m.TimelineAt!=nil} data-message-revision={m.RevisionId} data-message-previews-known={strconv.FormatBool(m.PresentationKnown&&m.VideosKnown)} data-message-account={m.AccountId} data-message-conversation={m.ConversationId} data-message-sender={m.Sender.Id} data-message-sender-name={m.Sender.DisplayName} data-message-groupable={strconv.FormatBool(m.Attachment==nil)} data-message-version={v.messageVersion(m)} data-message-source={originalMessageJSON(m.OriginalText)}>
@viewerSource(v,m)
if m.Attachment!=nil {
<div class="oie-media-message">@card.Card(card.Config{Image:m.Attachment.PreviewUrl,ImageAlt:m.Attachment.Title,Title:m.Attachment.Title,Description:m.Attachment.Description,Density:card.DensityCompact,RootClass:"oie-media-card"})</div>
}else{
<div class="oie-message-content">
if !m.IsOwn {
@senderAvatar(v,m)
}
@chatbubble.ChatBubble(chatbubble.Config{Side:messageSide(m.IsOwn),Message:m.OriginalText,MessageContent:messageBubbleBody(v,m,grouped),RootClass:"oie-bubble",Grouped:grouped})
</div>
}

if m.IsOwn {
<div class="oie-message-meta">
if m.Attachment!=nil {
<time datetime={position.Format("2006-01-02T15:04:05Z07:00")}>{position.Format("15:04")}</time>
}
if pendingSendMutable(m.Message) && !v.Preview {
@form.Form(form.Config{ID:"cancel-"+m.Id,Action:"/ui/messages/cancel",Method:"post",RootClass:"oie-cancel-form",RootAttrs:templ.Attributes{"data-oie-action":"cancel","data-cancel-message":""}}){
@mutationFields(v,"cancel-"+m.Id,newOperationKey())
<input type="hidden" name="messageId" value={m.Id}/><input type="hidden" name="expectedRevisionId" value={m.RevisionId}/>
@button.Button(button.WithType("submit"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"aria-label":v.Text.CancelSend})){ {v.Text.CancelSend} }
<div data-form-feedback role="status" aria-live="polite"></div>
}
}
</div>
}
</div>
}
func sendIndicatorLabel(v view,state engineapi.MessageSendState)string{if state=="submitted"{return v.Text.SendAccepted};if state=="unknown"{return v.Text.SendUnconfirmed};return v.stateLabel(state)}

func messageSide(own bool) chatbubble.Side {
	if own {
		return chatbubble.Sent
	}
	return chatbubble.Received
}

func selectedAccountID(v view)string{if v.Selected!=nil{return v.Selected.AccountId};return ""}

templ composer(v view){
<form id="send-message-form" action={templ.URL(composerAction(v))} method="post" data-oie-action="send" x-data="{}" data-schedule-composer?={v.scheduleAllowed()} data-editing-schedule?={v.ScheduleEdit!=nil} data-attachment-allowed={strconv.FormatBool(v.attachmentAllowed())} data-send-allowed={strconv.FormatBool(v.sendAllowed())} data-compose-allowed={strconv.FormatBool(v.composeAllowed())} data-reply-allowed={strconv.FormatBool(v.replyAllowed())} data-edit-allowed={strconv.FormatBool(v.messagingImplemented("send_corrections"))} data-edit-target-url={v.editTargetHref("")} data-latest-edit-message={v.latestEditMessage()}>
@mutationFieldsAt(v,"send",sendKey(v),composerReturn(v))
if v.scheduleAllowed() {
@scheduleFields(v)
}
<input type="hidden" name="conversationId" value={v.ChatID}/><input type="hidden" name="accountId" value={selectedAccountID(v)}/><input type="hidden" name="expectedConversationKind" value={string(v.Selected.Kind)}/>
<input type="hidden" name="replyToMessageId" value=""/>
@composerEdit(v)
<span class="sr-only" data-edit-announcement role="status" aria-live="polite"></span>
<div class="oie-edit-status" data-edit-last-status role="status" aria-live="polite" hidden><span data-edit-last-copy></span> @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithAttrs(templ.Attributes{"data-edit-last-check":""})){<span>{v.Text.EditCheckStatus}</span>}</div>
<div class="oie-composer-overlay">
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithRootClass("oie-draft-switch"),button.WithAttrs(templ.Attributes{"data-draft-switch":"","data-pending-label":v.Text.ViewOfflineSend,"data-draft-label":v.Text.SwitchDraft,"hidden":true})){ {v.Text.SwitchDraft} }
if !v.Preview && v.Selected.Kind == "direct" && v.Selected.Request==nil && !removedConversation(v.Selected) && v.composeAllowed() && v.messagingImplemented("typing") {
<span class="oie-typing-notice" data-typing-notice role="status" hidden>{v.Text.TypingNotice}</span>
}
@jumpLatestButton(v)
<div class="oie-composer-auxiliary">
if v.composeAllowed() {
@draftLinkPreview(v)
}
@composerReply(v)
if v.scheduleAllowed() {
@composerAttachments(v)
}
<div class="oie-composer-feedback" data-form-feedback role="status" aria-live="polite"></div>
</div>
</div>
@pendingSendTemplate(v)
<div class="oie-composer">
<div class="oie-composer-field">
@textarea.Textarea(textarea.Config{ID:"message-composer",Name:"originalText",Value:v.field("originalText"),Rows:1,Disabled:!v.composeAllowed(),RootClass:"oie-composer-input",InputAttrs:templ.Attributes{"aria-label":v.Text.Message,"style":"resize:none;field-sizing:content;min-height:var(--oie-composer-control-size,2.75rem);line-height:1.25rem;padding-block:calc((var(--oie-composer-control-size,2.75rem) - 1.25rem - 2px)/2);max-height:min(12rem,calc(var(--oie-workspace-height,100dvh) * .3));overflow-y:auto;background:var(--oie-raised);border-color:var(--oie-border);border-radius:1.5rem;color:var(--oie-text)"}})
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-icon-button oie-edit-cancel"),button.WithAttrs(templ.Attributes{"data-edit-cancel":"","hidden":true,"aria-label":v.Text.CancelEdit,"title":v.Text.CancelEdit})){@glyph(heroicons.Icon16SolidXMark)}
if v.scheduleAllowed() {
@composerAudio(v)
}
<div class="oie-composer-emoji">@emojiPicker(v)</div>
</div>
@mentionPicker(v)
@emojiCompletion(v)
if v.scheduleAllowed() {
@scheduleControl(v)
<noscript>
@composerSendButton(v,false)
</noscript>
} else {
@composerSendButton(v,true)
}
</div>
</form>
if v.conversationSchedulesAvailable() {
@scheduleDialog(v)
}
}
templ composerSendButton(v view,live bool) {
@button.Button(button.WithType("submit"),button.WithRootClass("oie-icon-button oie-send"),button.WithAttrs(templ.Attributes{"aria-label":v.Text.Send,"data-send-message":live,"disabled":!v.sendAllowed()})){@glyph(heroicons.Icon16SolidArrowUp)}
}
templ jumpLatestButton(v view) {
{{ unread := v.timelineUnread() }}
<button type="button" class="oie-jump-latest" data-jump-latest data-unread-label={v.Text.Unread}
	aria-label={v.Text.JumpToLatest} hidden?={!v.ContextHasNewer&&!v.ContextMissing&&v.FirstUnread==""}
	if unread > 0 {
		aria-description={v.Text.Unread + ": " + strconv.Itoa(unread)}
	}
>
	@glyph(heroicons.Icon16SolidArrowDown)
	<span class="oie-jump-latest-badge" data-jump-latest-badge aria-hidden="true" hidden?={unread <= 0}>
		if unread > 99 {
			+99
		} else if unread > 0 {
			{strconv.Itoa(unread)}
		}
	</span>
</button>
}
func sendKey(v view)string{if v.FormTarget=="send"&&v.field("operationKey")!=""{return v.field("operationKey")};return newOperationKey()}

// Keep Goshtoso's drawers, including their focus and dismissal behavior.
func workspaceDrawer(config drawer.Config) templ.Component {
 config.PanelClass = strings.TrimSpace("oie-drawer " + config.PanelClass)
 return drawer.Drawer(config)
}

templ accounts(v view){
@workspaceDrawer(drawer.Config{ID:"accounts",Title:v.accountDrawerTitle(),PanelClass:v.accountDrawerClass()}){
@accountWorkspace(v)
}
}
templ accountWorkspace(v view){
<div id="account-workspace" data-engine-id={v.EngineID} data-panel-class={v.accountDrawerClass()} data-panel-title={v.accountDrawerTitle()} class={"oie-account-workspace",templ.KV("oie-account-list-workspace",v.accountScreen()=="list"),templ.KV("oie-account-detail-workspace",v.accountScreen()=="detail")}>
switch v.accountScreen() {
case "add":
@accountBack(v)
<div class="oie-account-intro"><h2>{v.Text.AddAccount}</h2><p>{v.Text.AddAccountHelp}</p></div>
@form.Form(form.Config{ID:"register-account-form",Action:"/ui/accounts/register",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"register"}}){
@mutationFields(v,"register",registerKey(v))
@textinput.TextInput(textinput.Config{ID:"register-address",Name:"address",Label:v.Text.AccountAddress,Placeholder:v.Text.AddressPlaceholder,Value:v.field("address"),Required:true,Autocomplete:"username"})
@textinput.TextInput(textinput.Config{ID:"register-label",Name:"label",Label:v.Text.AccountLabel,Placeholder:v.Text.LabelPlaceholder,Value:v.field("label"),Required:true})
@button.Button(button.WithType("submit")){ {v.Text.RegisterAccount} }
<div data-form-feedback role="status" aria-live="polite"></div>
}
case "capabilities":
@accountCapabilities(v)
case "contacts":
@accountContacts(v)
case "remove":
if a:=v.account(v.managedAccountID());a.Address!="" && !v.Preview && !v.Unavailable {
@accountRemoval(v,a)
}else if v.Unavailable {
@accountBack(v)
@emptystate.EmptyState(emptystate.Config{Title:v.Text.Unavailable,Description:v.Text.UnavailableBody})
@link.Link(v.removeAccountHref(v.managedAccountID())){ {v.Text.Retry} }
}else{
@accountBack(v)
@emptystate.EmptyState(emptystate.Config{Title:v.Text.AccountMissing})
}
case "detail":
@accountProfileBack(v)
if a:=v.account(v.managedAccountID());a.Address!="" {
<div id="account-blocks">@accountDetail(v,a)</div>
}else if v.Unavailable {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.Unavailable,Description:v.Text.UnavailableBody})
@link.Link(v.accountsHref(v.managedAccountID())){ {v.Text.Retry} }
}else{
@emptystate.EmptyState(emptystate.Config{Title:v.Text.AccountMissing,Description:v.Text.AccountHelp})
}
default:
<div id="account-overview">@accountOverview(v)</div>
<footer class="oie-account-list-footer">
@link.Link(v.addAccountHref(),link.WithAppearance(link.AppearanceButton),link.WithRootClass("oie-add-account"),link.WithAttrs(templ.Attributes{"data-account-add":""})){@glyph(heroicons.Icon16SolidPlus)<span>{v.Text.AddAccount}</span>}
</footer>
}
</div>
}
func registerKey(v view)string{if v.FormTarget=="register"&&validOperationKey(v.field("operationKey")){return v.field("operationKey")};return newOperationKey()}
templ accountBack(v view){
@link.Link(v.accountsHref(""),link.WithRootClass("oie-account-back"),link.WithAttrs(templ.Attributes{"data-account-back":""})){@glyph(heroicons.Icon16SolidChevronLeft)<span>{v.Text.BackToAccounts}</span>}
}
func (v view) accountDrawerTitle() string {
 if v.accountScreen() == "detail" { return v.Text.AccountProfile }
 if v.accountScreen() == "contacts" { return v.Text.ContactsTitle }
 return v.Text.Accounts
}
templ accountProfileBack(v view) {
 @link.Link(v.accountsHref(""), link.WithRootClass("oie-profile-back"), link.WithAttrs(templ.Attributes{"data-account-back":"", "aria-label":v.Text.BackToAccounts, "title":v.Text.BackToAccounts})) {
  @glyph(heroicons.Icon16SolidChevronLeft)
 }
}
templ accountOverview(v view){
if v.Unavailable {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.Unavailable,Description:v.Text.UnavailableBody})
@link.Link(v.accountsHref("")){ {v.Text.Retry} }
}else if len(v.Accounts)==0 {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.EmptyTitle,Description:v.Text.AddAccountHelp})
}else{
<nav class="oie-account-list" aria-label={v.Text.ManageAccounts}>
for _,a:=range v.Accounts {
@link.Link(v.accountsHref(a.Id),link.WithRootClass("oie-account-summary"),link.WithAttrs(templ.Attributes{"data-manage-account":a.Id})){
@profileAvatar(v,a.Id,a.Address,avatar.Config{Name:a.Label,Size:avatar.SizeSM})
<span class="oie-profile-identity"><strong>{a.Label}</strong><small>{a.Address}</small><small>{v.connectionLabel(a.Id)}</small></span>
@glyph(heroicons.Icon16SolidChevronRight)
}
}
</nav>
}
}
templ mutationFields(v view,target,key string){
@mutationFieldsAt(v,target,key,v.href())
}
templ mutationFieldsAt(v view,target,key,destination string){
<input type="hidden" name="csrf" value={v.CSRF}/><input type="hidden" name="engineId" value={v.EngineID}/><input type="hidden" name="returnTo" value={destination}/><input type="hidden" name="formTarget" value={target}/><input type="hidden" name="operationKey" value={key}/>
}
templ accountDetail(v view,a engineapi.Account) {
 <section class="oie-account-detail" data-account-id={a.Id}
  if v.accountEditorHasError() && v.FormTarget=="account-label-"+a.Id {
   x-init="$nextTick(() => $dispatch('modal:open', {id: 'account-name-dialog'}))"
  } else if v.accountEditorHasError() && v.FormTarget=="account-avatar-"+a.Id {
   x-init="$nextTick(() => $dispatch('modal:open', {id: 'account-photo-dialog'}))"
  }
 >
  <div id="account-detail-scroll" class="oie-account-detail-content">
   <header class="oie-account-detail-heading">
    @accountAvatar(v,a,avatar.SizeXL)
    if !v.Preview && !v.Unavailable && a.Protocol=="xmpp" {
     @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-profile-photo-action"),button.WithAttrs(templ.Attributes{
      "data-edit-account-photo":"", "disabled":connectionState(v,a.Id)!="connected",
      "x-on:click":"$dispatch('modal:open', {id: 'account-photo-dialog'})",
     })) { {v.Text.AccountAvatarEdit} }
    }
   </header>
   <div class="oie-profile-fields">
    <div class="oie-profile-field">
     <span class="oie-profile-field-label">{v.Text.AccountProfileName}</span>
     if !v.Preview && !v.Unavailable {
      @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-profile-row"),button.WithAttrs(templ.Attributes{
       "aria-label":v.Text.AccountRename, "aria-describedby":"account-profile-name",
       "x-on:click":"$dispatch('modal:open', {id: 'account-name-dialog'})",
      })) {
       @accountProfileName(a)
       @glyph(heroicons.Icon16SolidChevronRight)
      }
     } else {
      <div class="oie-profile-row">@accountProfileName(a)</div>
     }
    </div>
    <div class="oie-profile-field">
     <span class="oie-profile-field-label">{v.Text.AccountAddress}</span>
     <div class="oie-profile-row"><span title={a.Address}>{a.Address}</span></div>
    </div>
    if !v.Preview && a.Protocol == "xmpp" {
     @link.Link(v.contactsHref(a.Id,""),link.WithRootClass("oie-profile-row"),link.WithAttrs(templ.Attributes{"data-account-contacts-link":a.Id})) {
      <span>{v.Text.ContactsTitle}</span>
      @glyph(heroicons.Icon16SolidChevronRight)
     }
    }
    @link.Link(v.capabilitiesHref(a.Id),link.WithRootClass("oie-profile-row"),link.WithAttrs(templ.Attributes{"data-account-capabilities":a.Id})) {
     <span>{v.Text.Capabilities}</span>
     @glyph(heroicons.Icon16SolidChevronRight)
    }
   </div>
   if v.AccountCommunication != nil {
    @accountCommunication(v,a.Id,*v.AccountCommunication)
   }
   <p class="oie-history-status">{v.historyCaption(a.Id)}</p>
   <div id={"connection-error-"+a.Id} role="status" aria-live="polite">
    if problem:=v.connectionError(a.Id);problem!="" {
     <p class="oie-field-error">{problem}</p>
    }
   </div>
   @accountConnectionControls(v,a.Id)
  </div>
  <footer class="oie-account-detail-footer">
  <div data-account-disconnect-actions>@disconnectAction(v,a.Id)</div>
  if !v.Unavailable && !v.Preview {
  @link.Link(v.removeAccountHref(a.Id),link.WithAppearance(link.AppearanceButton),link.WithRootClass("oie-remove-account-link"),link.WithAttrs(templ.Attributes{"data-account-remove":""})){ {v.Text.RemoveAccount} }
  }
  </footer>
  if !v.Preview && !v.Unavailable {
   @modal.Dialog(modal.DialogConfig{ID:"account-name-dialog",Title:v.Text.AccountRename,Content:accountNameForm(v,a)}).WithExpressions(expressions.Modal{DialogCloseAriaLabel:v.Text.Close})
   if a.Protocol=="xmpp" {
    @modal.Dialog(modal.DialogConfig{ID:"account-photo-dialog",Title:v.Text.AccountAvatarEdit,Content:accountPhotoForm(v,a)}).WithExpressions(expressions.Modal{DialogCloseAriaLabel:v.Text.Close})
   }
  }
 </section>
}
templ accountProfileName(a engineapi.Account) {
 <span id="account-profile-name" data-account-name={a.Id} title={a.Label}>{a.Label}</span>
}
templ accountNameForm(v view,a engineapi.Account){
@form.Form(form.Config{ID:"account-name-form",Action:"/ui/accounts/label",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"account-label"}}){
<input type="hidden" name="csrf" value={v.CSRF}/>
<input type="hidden" name="engineId" value={v.EngineID}/>
<input type="hidden" name="accountId" value={a.Id}/>
<input type="hidden" name="expectedRevisionId" value={a.RevisionId}/>
<input type="hidden" name="returnTo" value={v.accountsHref(a.Id)}/>
<input type="hidden" name="formTarget" value={ "account-label-"+a.Id }/>
<input type="hidden" name="lang" value={v.Locale}/>
{{
 attrs := templ.Attributes{"autofocus": true}
 if v.FormTarget == "account-label-"+a.Id {
  attrs["data-draft"] = v.field("label")
  attrs["x-init"] = "$el.value = $el.dataset.draft; delete $el.dataset.draft"
 }
}}
@textinput.TextInput(textinput.Config{ID:"account-name-input",Name:"label",Label:v.Text.AccountLabel,Value:a.Label,Required:true,InputAttrs:attrs})
@button.Button(button.WithType("submit")){ {v.Text.AccountRenameSave} }
@accountEditorFeedback(v,"account-label-"+a.Id)
}
}
templ accountPhotoForm(v view,a engineapi.Account){
{{ ctx = expressions.With(ctx, expressions.Set{FileInput: expressions.FileInput{BrowseLabel: v.Text.RoomAvatarBrowse, EmptyText: v.Text.RoomAvatarEmpty}}) }}
@form.Form(form.Config{ID:"account-photo-form",Action:"/ui/accounts/avatar",Method:"post",RootAttrs:templ.Attributes{"enctype":"multipart/form-data","data-oie-action":"account-avatar"}}){
<input type="hidden" name="csrf" value={v.CSRF}/>
<input type="hidden" name="engineId" value={v.EngineID}/>
<input type="hidden" name="accountId" value={a.Id}/>
<input type="hidden" name="returnTo" value={v.accountsHref(a.Id)}/>
<input type="hidden" name="formTarget" value={ "account-avatar-"+a.Id }/>
<input type="hidden" name="lang" value={v.Locale}/>
<fieldset class="oie-account-photo-fields" data-account-photo-fields disabled?={connectionState(v,a.Id)!="connected"}>
<div class="oie-account-photo-preview">
 @profileAvatar(v,a.Id,a.Address,avatar.Config{Name:a.Label,Size:avatar.SizeXL})
 <img data-account-photo-preview data-max-bytes={strconv.Itoa(maxAvatarUpload)} alt={v.Text.AccountAvatarPreview} width="96" height="96" hidden/>
</div>
@fileinput.FileInput(fileinput.Config{ID:"account-photo-image",Name:"image",Label:v.Text.AccountAvatarLabel,Appearance:fileinput.AppearanceUpload,Accept:"image/png,image/jpeg,image/gif",HelperText:v.Text.RoomAvatarHint,Required:true})
@button.Button(button.WithType("submit")){ {v.Text.AccountAvatarSave} }
</fieldset>
@accountEditorFeedback(v,"account-avatar-"+a.Id)
}
}
templ accountEditorFeedback(v view,target string) {
 <div class="oie-account-editor-feedback" data-form-feedback role="status"
  if v.FormTarget==target && v.ErrorMessage!="" {
   data-error="true"
  }
 >
  if v.FormTarget==target {
   {v.ErrorMessage}
  }
 </div>
}
templ accountAvatar(v view,a engineapi.Account,size avatar.Size){
{{ border := v.AccountAvatarBorders[a.Id] }}
<div class="inline-flex shrink-0" data-account-status={a.Id} data-account-avatar-name={a.Label} data-account-avatar-border={border} data-connection-state={connectionState(v,a.Id)} title={v.connectionLabel(a.Id)} role="img" aria-label={v.connectionLabel(a.Id)}>
@profileAvatar(v,a.Id,a.Address,avatar.Config{Name:a.Label,Size:size,Status:connectionAvatarStatus(v,a.Id),Border:border!="",BorderColor:border})
</div>
}
templ accountConnectionControls(v view,id string){
<div id={"connection-controls-"+id} data-connection-state={connectionState(v,id)}>
if state:=connectionState(v,id);state=="not_connected"||state=="error" {
@form.Form(form.Config{ID:"connect-"+id,Action:"/ui/accounts/connect",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"connect","data-connect-account":""}}){
@mutationFields(v,"connect-"+id,newOperationKey())
<input type="hidden" name="accountId" value={id}/>
@textinput.TextInput(textinput.Config{ID:"password-"+id,Name:"password",Type:textinput.TypePassword,Label:v.Text.Password,Required:true,Autocomplete:"current-password",HelperText:v.Text.PasswordHelp})
@accordion.Accordion(accordion.AccordionConfig{ID:"connection-advanced-"+id,RootClass:"oie-account-advanced",Items:[]accordion.AccordionItem{{ID:"endpoint-advanced-"+id,Title:v.Text.AdvancedConnection,Content:connectionEndpoint(v,id),InitiallyExpanded:connectionField(v,id,"endpoint")!=""}}})
@button.Button(button.WithType("submit")){ {v.Text.Connect} }
<div data-form-feedback role="status" aria-live="polite"></div>
}
}
</div>
}
templ connectionEndpoint(v view,id string){
@textinput.TextInput(textinput.Config{ID:"endpoint-"+id,Name:"endpoint",Label:v.Text.Endpoint,HelperText:v.Text.EndpointHelp,Value:connectionField(v,id,"endpoint")})
}
templ disconnectAction(v view,id string){
if state:=connectionState(v,id);state=="connected"||state=="connecting"||state=="error" {
@form.Form(form.Config{ID:"disconnect-"+id,Action:"/ui/accounts/disconnect",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"disconnect","data-disconnect-account":""}}){
@mutationFields(v,"disconnect-"+id,newOperationKey())
<input type="hidden" name="accountId" value={id}/>
@button.Button(button.WithType("submit"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-profile-disconnect")){ {v.Text.Disconnect} }
}
}
}
func connectionField(v view,id,key string)string{if v.FormTarget=="connect-"+id{return v.field(key)};return ""}
func connectionState(v view,id string)string{if c:=v.Connections[id];c.Known{return string(c.Value.State)};return "unknown"}
func accountOptions(v view,all bool)[]selectfield.Option{
 out:=[]selectfield.Option{}
 if all{out=append(out,selectfield.Option{Value:"",Label:v.Text.AllAccounts,Selected:v.AccountFilter==""})}
 selected:=v.AccountFilter;if !all{selected=v.selectedAccount()}
 for _,a:=range v.Accounts{out=append(out,selectfield.Option{Value:a.Id,Label:a.Label+" · "+a.Address,Selected:selected==a.Id})};return out
}
templ newConversation(v view){
@workspaceDrawer(drawer.Config{ID:"newchat",Title:v.Text.DirectConversation}){
<div class="oie-settings">
if len(v.Accounts)==0 {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.EmptyTitle,Description:v.Text.NoChatsBody})
@link.Link(v.addAccountHref()){ {v.Text.AddAccount} }
}else{
@form.Form(form.Config{ID:"new-conversation-form",Action:"/ui/conversations/open",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"open"}}){
@mutationFields(v,"open",newOperationKey())
<div id="newchat-account-select">@selectfield.Select(selectfield.Config{ID:"sending-account",Name:"accountId",Label:v.Text.ChooseAccount,Options:accountOptions(v,false),Required:true})</div>
@textinput.TextInput(textinput.Config{ID:"peer-address",Name:"address",Label:v.Text.PeerAddress,Placeholder:v.Text.AddressPlaceholder,Value:v.field("address"),Required:true})
@button.Button(button.WithType("submit")){ {v.Text.StartConversation} }
<div data-form-feedback role="status" aria-live="polite"></div>
}
}
</div>
}
}

templ newConversationTrigger(v view) {
	@button.Button(button.WithType("button"), button.WithRootClass("oie-icon-button oie-new-chat"), button.WithAttrs(templ.Attributes{"aria-label":v.Text.NewChat,"title":v.Text.NewChat,"data-new-conversation":""})) {
		@glyph(heroicons.Icon16SolidPlus)
	}
}

func newConversationActions(v view) []dropdown.Item {
	items := []dropdown.Item{
		{ID:"new-conversation-direct",Label:v.Text.DirectConversation,Icon:glyph(heroicons.Icon16SolidUser),OnClick:"close(); $dispatch('oie:new-conversation', {id: 'newchat'})"},
	}
	if !v.Preview {
		items = append(items,
			dropdown.Item{ID:"new-conversation-join",Label:v.Text.JoinRoom,Icon:appicons.Icon(appicons.Config{Symbol:appicons.IconHeroiconsGroup16SolidUserGroup,Decorative:true,RootClass:"oie-icon"}),OnClick:"close(); $dispatch('oie:new-conversation', {id: 'join-room'})"},
			dropdown.Item{ID:"new-conversation-create",Label:v.Text.CreateRoom,Icon:glyph(heroicons.Icon16SolidPlus),OnClick:"close(); $dispatch('oie:new-conversation', {id: 'create-room'})"},
		)
	}
	return items
}
templ liveCopy(v view){
<div id="oie-star-copy" hidden data-star={v.Text.StarMessage} data-unstar={v.Text.UnstarMessage} data-retry={v.Text.RetryStar} data-uncertain={v.Text.StarUncertain} data-storage={v.Text.StarStorageUnavailable}></div>
<div id="oie-star-status" class="sr-only" role="status" aria-live="polite"></div>
<p id="oie-star-storage-warning" class="oie-star-warning" role="status" hidden>{v.Text.StarStorageUnavailable}</p>
<div id="oie-formatting-copy" hidden data-copy={v.Text.CopyOriginal} data-copied={v.Text.MessageCopied} data-failed={v.Text.CopyFailed}></div>
<div id="oie-copy-status" class="sr-only" role="status" aria-live="polite"></div>
<div id="oie-preview-copy" hidden data-refresh-failed={v.Text.RefreshPreviewFailed} data-refresh-loading={v.Text.PreviewLoading} data-loading={v.Text.LoadingImage} data-image={v.Text.ImageView} data-not-downloaded={v.Text.ImageNotDownloaded} data-failed={v.Text.ImageDownloadFailed}></div>
<div id="oie-live-copy" hidden data-reply-unavailable={v.Text.ReplyUnavailable} data-reply-preparing={v.Text.ReplyPreparing} data-reply-locked={v.Text.ReplyLocked} data-room-command-unknown={v.Text.RoomCommandUnknown} data-saving={v.Text.Saving} data-invalid-message={v.Text.InvalidMessage} data-pending={v.Text.PendingAcceptance} data-storage-unavailable={v.Text.DraftStorageUnavailable} data-locked={v.Text.DraftLocked} data-retry={v.Text.RetrySubmission} data-send={v.Text.Send} data-live-ready={v.Text.LiveReady} data-live-retry={v.Text.LiveRetry} data-live-connecting={v.Text.LiveConnecting} data-engine-changed={v.Text.EngineChanged} data-today={v.Text.Today}></div>
}
templ liveRegions(v view){
<div id="oie-live-regions" data-conversation-removed={strconv.FormatBool(v.conversationRemoved())} data-conversation-request={v.requestKind()} data-edit-message={v.latestEditMessage()} data-attachment-allowed={strconv.FormatBool(v.attachmentAllowed())} data-engine-id={v.EngineID} data-event-cursor={v.EventCursor} data-conversation-id={v.ChatID} data-account-id={selectedAccountID(v)} data-focus-message={v.FocusMessage} data-context-newer={strconv.FormatBool(v.ContextHasNewer)} data-context-missing={strconv.FormatBool(v.ContextMissing)} data-unavailable={strconv.FormatBool(v.Unavailable)} data-accounts-version={v.accountVersion()}>
@avatarData(v)
if v.Section=="scheduled"&&v.SchedulePage!=nil {
@scheduledResults(v)
}
if v.Section=="favorites" && v.FavoritesPage!=nil {
@favoritesResults(v)
}
if v.Section!="media" && v.Section!="favorites"{
@starData(v)
}
if v.Selected!=nil {
if v.InfoView=="shared" || v.InfoView=="stars" {
<div id="live-info-content" data-info-view={v.InfoView}>@chatInfoContent(v)</div>
}
<div id="live-conversation-details" data-details-conversation={v.Selected.Id}>
<div id="live-details-identity" data-version={v.detailsVersion("identity")}>@detailsIdentity(v)</div>
<div id="live-details-account" data-version={v.detailsVersion("account")}>@detailsAccount(v)</div>
<div id="live-details-metadata" data-version={v.detailsVersion("metadata")}>@detailsMetadata(v)</div>
</div>
}
<div id="live-room-session">@roomSessionStatus(v)</div>
<div id="live-context-notice">@contextNotice(v)</div>
if v.Section=="media"{
<div id="live-shared-content"><div id="live-shared-status">@sharedStatus(v)</div><div id="live-shared-results" data-version={v.sharedVersion()}>@sharedItems(v)</div><div id="live-shared-pagination">@sharedPagination(v)</div></div>
}
if !v.ReuseInbox && v.Section!="media" && v.Section!="scheduled" {
<div id="live-list" data-version={v.conversationListVersion()}>@conversationList(v)</div>
}
<div id="live-timeline" data-version={v.timelineVersion()}>@timeline(v)</div>
<div id="live-header" data-version={v.headerVersion()}>
if v.Selected!=nil {
@chatHeader(v)
}
</div>
<div id="live-account-blocks">
if v.accountScreen()=="detail" {
if a:=v.account(v.managedAccountID());a.Address!="" {
@accountDetail(v,a)
}
}
</div>
<div id="live-account-overview">@accountOverview(v)</div>
if v.accountScreen()=="capabilities" {
<div id="live-account-capabilities">@capabilityContent(v)</div>
}
<div id="live-account-menu">@accountMenu(v)</div>
<div id="live-account-trigger">@accountTrigger(v)</div>
<div id="live-newchat-account">@selectfield.Select(selectfield.Config{ID:"sending-account",Name:"accountId",Label:v.Text.ChooseAccount,Options:accountOptions(v,false),Required:true})</div>
</div>
}

templ conversationList(v view){
if v.Unavailable {
<div class="oie-list-state">
@engineUnavailableState(v)
</div>
}else if len(v.Accounts)==0 {
<div class="oie-list-state">
@emptystate.EmptyState(emptystate.Config{Title:v.Text.EmptyTitle,Description:v.Text.AddAccountHelp,Action:emptyAccountAction(v)})
</div>
}else if len(v.Chats)==0 {
<div class="oie-list-state">
if v.Query!=""||v.Filter!="all" {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.NoResults,Description:v.Text.NoResultsBody})
}else{
@emptystate.EmptyState(emptystate.Config{Title:v.Text.NoChats,Description:v.Text.NoChatsBody})
}
</div>
}else{
<ul class="oie-conversations">
for _,c:=range v.Chats {
@conversationRow(v,c)
}
</ul>
}
}

templ emptyAccountAction(v view) {
	@link.Link(v.addAccountHref(), link.WithAppearance(link.AppearanceButton)) {
		{ v.Text.AddAccount }
	}
}

templ timeline(v view){
@timelineEnvelope(v)
@timelineControl(v,"older",v.TimelineOlder)
<div class="oie-day-divider"><span>{v.Text.Today}</span></div>
for index,m:=range v.Messages {
@message(v,m,index>0&&messagesGrouped(v.Messages[index-1],m),index+1==len(v.Messages)||!messagesGrouped(m,v.Messages[index+1]))
}
@timelineControl(v,"newer",v.TimelineNewer)
}

templ nativeRecovery(v view){
<form action="/ui/messages/send" method="post" class="oie-native-recovery">
@mutationFields(v,"send",v.field("operationKey"))
<input type="hidden" name="conversationId" value={v.field("conversationId")}/><input type="hidden" name="accountId" value={v.field("accountId")}/>
@textarea.Textarea(textarea.Config{ID:"native-retained-message",Name:"originalText",Label:v.Text.Message,Value:v.field("originalText"),ReadOnly:true,Rows:4})
@button.Button(button.WithType("submit")){ {v.Text.RetrySubmission} }
</form>
}

// The scope belongs to Oie. Avatar's public SrcExpr consumes a fixed expression;
// opaque addresses are escaped HTML data, never JavaScript source.
templ profileAvatar(v view,account,address string,cfg avatar.Config){
@avatarScope(v,account,address,cfg,false)
}

templ avatarScope(v view,account,address string,cfg avatar.Config,deferEmpty bool){
{{ src:=v.avatarSource(account,address); deferred:=deferEmpty&&src=="" }}
<div class="oie-avatar-scope" data-avatar-account={account} data-avatar-address={address} data-avatar-src={src} x-data="{oieAvatarSrc: $el.dataset.avatarSrc}" x-ignore?={deferred} data-inbox-avatar-deferred?={deferred}>
@profileAvatarContent(v,account,address,cfg)
</div>
}

templ profileAvatarContent(v view,account,address string,cfg avatar.Config){
{{
 cfg.Src=v.avatarSource(account,address);cfg.SrcExpr="oieAvatarSrc"
 fallback:=cfg;fallback.Src="";fallback.SrcExpr=""
}}
<div class="oie-avatar-stack" x-data="{oieAvatarReady:false}" x-effect="oieAvatarSrc; oieAvatarReady=false" x-bind:data-avatar-ready="oieAvatarReady ? 'true' : 'false'"
 x-on:load.capture="if ($event.target.getAttribute('src') === oieAvatarSrc && $event.target.naturalWidth > 0) oieAvatarReady=true"
 x-on:error.capture="if ($event.target.getAttribute('src') === oieAvatarSrc) oieAvatarReady=false">
 <div class="oie-avatar-initials" data-avatar-initials>@avatar.Avatar(fallback)</div>
 <template x-if="oieAvatarSrc">
  <div class="oie-avatar-photo">@avatar.Avatar(cfg)</div>
 </template>
</div>
}

templ avatarData(v view){
<div id="oie-avatar-data" hidden>
for _,account:=range v.AvatarAccounts {
<div data-avatar-loaded-account={account}></div>
}
for identity,hash:=range v.Avatars {
<div data-avatar-entry data-account-id={identity.Account} data-address={identity.Address} data-hash={hash}></div>
}
</div>
}

// The public rich-content slot owns the header and corner control together, so
// positioning never depends on ChatBubble's private row or bubble selectors.
templ messageBubbleBody(v view,m messageView,grouped bool){
<div class={"oie-message-body",templ.KV("oie-message-body-compact",m.IsOwn||grouped)} data-message-bubble={m.Id}>
if m.Moderation==nil && m.Retraction==nil {
@messageReactionShortcut(v,m)
<div class="oie-message-menu-slot" data-message-menu-slot={m.Id} x-ignore?={v.CompactSource} data-source-menu-deferred?={v.CompactSource}>
@dropdown.Dropdown(dropdown.Config{ID:"message-menu-"+m.Id,Label:v.Text.MessageActions,Trigger:messageMenuTrigger(v,m.Id),RootClass:"oie-message-menu",MenuAlign:dropdown.AlignEnd,Sections:messageActions(v,m.Id)})
</div>
}
<div class="oie-message-body-content">
if !m.IsOwn && !grouped {
<div class="oie-message-heading"><strong class={v.messageAvatarBorder(m)}>{m.Sender.DisplayName}</strong></div>
}
if m.Moderation!=nil || m.Retraction!=nil {
@withdrawnMessageBody(v,m)
}else{
@messageBody(v,m)
@outgoingAttachments(v,m.Message)
}
</div>
<div class="oie-message-stamp">
@messageLeadingIndicators(v,m)
@messageSendIndicator(v,m)
@messageStarIndicator(v,m.Id)
{{ position := messageTimelineTime(m.Message) }}
<time data-message-time datetime={position.Format("2006-01-02T15:04:05Z07:00")}>{position.Format("15:04")}</time>
</div>
if m.Moderation==nil && m.Retraction==nil {
@messageReactions(v,m)
}
</div>
}

templ messageLeadingIndicators(v view,m messageView){
{{ mentioned := !m.IsOwn && v.Selected!=nil && v.Selected.Kind=="room" && m.mentionsYou() }}
if mentioned || m.IsOwn || messageEdited(m) || (m.Retraction!=nil && m.Retraction.OriginalAvailable) {
<div class="oie-message-leading-indicators">
if mentioned {
<span class="oie-message-mention" data-message-mention role="img" aria-label={v.Text.MentionedYou} title={v.Text.MentionedYou}>{ "@" }</span>
}
if m.IsOwn {
<span class="oie-message-edit-state" data-edit-state="editing">
@tooltip.Tooltip("message-editing-tip-"+m.Id,v.Text.EditMode,tooltip.WithTrigger(messageEditStateIcon(v.Text.EditMode,false)),tooltip.WithPortal(true))
</span>
<span class="oie-message-edit-state" data-edit-state="pending">
@tooltip.Tooltip("message-edit-pending-tip-"+m.Id,v.Text.EditPending,tooltip.WithTrigger(messageEditStateIcon(v.Text.EditPending,true)),tooltip.WithPortal(true))
</span>
}
if messageEdited(m) || (m.Retraction!=nil && m.Retraction.OriginalAvailable) {
@messageHistoryIndicator(v,m)
}
</div>
}
}

templ messageSendIndicator(v view,m messageView){
if m.IsOwn && sendIndicatorLabel(v,m.SendState)!="" {
<span class="oie-send-state-slot" data-message-status role="img" aria-label={sendIndicatorLabel(v,m.SendState)} title={sendIndicatorLabel(v,m.SendState)}>
switch m.SendState {
case "queued":
@glyph(heroicons.Icon16SolidClock)
case "dispatching":
@spinner.Spinner(spinner.Config{Size:spinner.SizeSM,RootClass:"oie-send-spinner"})
case "submitted":
@glyph(heroicons.Icon16SolidCheck)
case "cancelled":
@glyph(heroicons.Icon16SolidXMark)
default:
@glyph(heroicons.Icon16SolidExclamationCircle)
}
</span>
}
}

templ messageEditStateIcon(label string,pending bool){
<span class="oie-message-edit-symbol" role="img" aria-label={label} tabindex="0">
if pending {
@spinner.Spinner(spinner.Config{Size:spinner.SizeSM,RootClass:"oie-edit-spinner"})
}else{
@glyph(heroicons.Icon16SolidPencilSquare)
}
</span>
}

templ messageHistoryIndicator(v view,m messageView){
<span class="oie-message-edit-history">
@tooltip.Tooltip("message-edited-tip-"+m.Id,v.historyLabel(m),tooltip.WithTrigger(messageHistoryLink(v,m)),tooltip.WithPortal(true))
</span>
}

templ messageHistoryLink(v view,m messageView){
{{
	attrs:=templ.Attributes{"data-open-message-history":"","aria-label":v.historyLabel(m)}
	if m.Retraction!=nil {
		attrs["data-message-history-retracted"] = m.Retraction.At.Format("2006-01-02T15:04:05.999999999Z07:00")
	} else {
		attrs["data-message-edited"] = ""
		attrs["data-edited-at"] = messageEditedAt(m)
	}
}}
@link.Link(v.editHistoryHref(m),link.WithRootClass("oie-message-edited"),link.WithAttrs(attrs)){
	@glyph(heroicons.Icon16SolidPencilSquare)
}
}

templ messageStarIndicator(v view,id string){
<span class="oie-message-star-indicator" data-message-star-indicator hidden?={!v.StarsKnown||!v.Stars[id].Starred} role="img" aria-label={v.Text.MessageStarred} title={v.Text.MessageStarred}>@glyph(heroicons.Icon16SolidStar)</span>
}

// Rendered and original projections share one public ChatBubble content slot.
// A device preference switches visibility without replacing message rows.
templ messageBody(v view,m messageView){
@replyCard(v,m)
{{ scope := invitationScope{m.AccountId,m.ConversationId,v.Locale} }}
<div data-message-presentation data-presentation-known={strconv.FormatBool(m.PresentationKnown)} data-presentation-version={originalMessageJSON(m.presentationText())} data-search-source-digest={searchSourceDigest(m.OriginalText)}>
<div class="oie-rendered-message" data-rendered-message>
if m.Formatted!=nil {
@m.Formatted
}else{
<div class="oie-plain-fallback">@plainRoomLinks(m.presentationText(),scope)</div>
}
</div>
<div class="oie-original-message" data-original-message>@plainRoomLinks(m.presentationText(),scope)</div>
if !v.Preview {
	for _, address := range m.RoomInvitations {
		@roomInvitationCard(v, scope, address)
	}
}
</div>
<div class="oie-message-previews" data-message-previews={m.Id}>
for _,p:=range v.MessagePreviews[m.Id] {
@messagePreview(v,p)
}
</div>
<div data-message-videos={m.Id}>
for _,item:=range v.messageVideos(m.Id) {
@videoCard(v,item)
}
</div>
for _,item:=range v.MessageAudio[m.Id] {
@audioPlayer(v,item.Id,v.sharedTitle(item),documentSource(v,item),documentSource(v,item)+"&download=1",audioURLMediaType(item.Url))
}

}


templ starData(v view){
<div id="oie-star-data" hidden data-known={strconv.FormatBool(v.StarsKnown)}>
for _,star:=range v.Stars {
<div data-star-state data-star-source={star.MessageId} data-starred={strconv.FormatBool(star.Starred)} data-revision={starRevision(star)}></div>
}
</div>
}
templ starButton(v view,id string){
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithRootClass("oie-star-message"),button.WithAttrs(templ.Attributes{"data-star-message":id,"data-starred":strconv.FormatBool(v.Stars[id].Starred),"aria-label":v.starLabel(id),"title":v.starLabel(id),"aria-pressed":strconv.FormatBool(v.Stars[id].Starred),"hidden":!v.StarsKnown,"disabled":!v.StarsKnown})){
@glyph(heroicons.Icon16SolidStar)
}
}

templ messageMenuTrigger(v view,id string){
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-menu-chevron"),button.WithAttrs(templ.Attributes{"data-message-menu-trigger":id,"aria-label":v.Text.MessageActions,"title":v.Text.MessageActions,"aria-haspopup":"menu","aria-expanded":"false"})){@glyph(heroicons.Icon16SolidChevronDown)}
}
templ viewerSource(v view,m messageView){
{{ position := messageTimelineTime(m.Message) }}
<template data-viewer-source={m.Id}>
<div class="oie-viewer-source" data-viewer-source-id={m.Id}>
@profileAvatar(v,m.AccountId,v.messageAvatarAddress(m),avatar.Config{Name:m.Sender.DisplayName,Initials:initials(m.Sender.DisplayName),Size:avatar.SizeXS,Border:true,BorderColor:v.messageAvatarBorder(m)})
<div class="oie-viewer-sender"><strong title={m.Sender.DisplayName}>{m.Sender.DisplayName}</strong><time data-viewer-date datetime={position.Format("2006-01-02T15:04:05Z07:00")}>{position.Format("2006-01-02 15:04")}</time></div>
</div>
</template>
}

templ replyCard(v view,m messageView){
if m.Reply!=nil {
if replyNavigable(m.Reply) {
@link.Link(v.replyHref(m),link.WithRootClass("oie-reply-link"),link.WithAttrs(templ.Attributes{"data-reply-target":*m.Reply.MessageId,"data-reply-conversation":m.ConversationId})){
@card.Card(card.Config{Title:v.replySender(m.Reply),Body:replyExcerpt(v,m.Reply),Density:card.DensityCompact,RootClass:"oie-reply-card"})
}
}else{
<div data-reply-unavailable>@card.Card(card.Config{Title:v.replySender(m.Reply),Body:replyExcerpt(v,m.Reply),Density:card.DensityCompact,RootClass:"oie-reply-card"})</div>
}
}
}
templ replyExcerpt(v view,r *engineapi.MessageReply){
<p class="oie-reply-excerpt">{r.Excerpt}</p>
if !replyNavigable(r){
<small class="oie-reply-unavailable">{v.Text.OriginalUnavailable}</small>
}
}
templ contextNotice(v view){
if v.ContextMissing {
<p>{v.Text.OriginalUnavailable} @link.Link(v.latestHref(),link.WithAttrs(templ.Attributes{"data-return-latest":""})){ {v.Text.JumpToLatest} }</p>
}
}
