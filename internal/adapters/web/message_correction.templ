package web

import (
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/head"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/components/textarea"
	"net/url"
)

templ composerEdit(v view) {
	<div class="oie-composer-edit" data-composer-edit hidden data-edit-preparing={ v.Text.EditPreparing } data-edit-mode={ v.Text.EditMode } data-edit-save-label={ v.Text.SaveEdit } data-edit-unavailable={ v.Text.EditUnavailable } data-edit-changed={ v.Text.EditChanged } data-edit-queued={ v.Text.EditQueued } data-edit-dispatching={ v.Text.EditDispatching } data-edit-submitted={ v.Text.EditSubmitted } data-edit-unknown={ v.Text.EditUnknown } data-edit-acceptance-unknown={ v.Text.EditAcceptanceUnknown } data-edit-failed={ v.Text.EditFailed } data-edit-storage={ v.Text.EditStorageUnavailable }>
		<div>
			<strong>{ v.Text.EditMode }</strong>
			<p data-edit-feedback role="status" aria-live="polite"></p>
			<div class="oie-edit-recovery" data-edit-recovery hidden>
				@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"data-edit-check": ""})) {
					<span>{ v.Text.EditCheckStatus }</span>
				}
				@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"data-edit-retry": ""})) {
					<span>{ v.Text.EditRetry }</span>
				}
			</div>
		</div>
		@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"data-edit-dismiss": "", "hidden": true})) {
			<span>{ v.Text.Back }</span>
		}
	</div>
}

func editNativeValues(preparation *editPreparation, values url.Values, csrf, locale string) url.Values {
	result := url.Values{}
	for _, name := range []string{"engineId", "accountId", "conversationId", "messageId", "expectedRevisionId", "operationKey", "originalText"} {
		result.Set(name, values.Get(name))
	}
	if preparation != nil {
		result.Set("engineId", preparation.EngineID)
		result.Set("accountId", preparation.Target.AccountId)
		result.Set("conversationId", preparation.Target.ConversationId)
		result.Set("messageId", preparation.Target.MessageId)
		result.Set("expectedRevisionId", preparation.Target.CurrentRevisionId)
		result.Set("operationKey", preparation.OperationKey)
		result.Set("originalText", preparation.Target.OriginalText)
	}
	result.Set("csrf", csrf)
	result.Set("lang", locale)
	return result
}

templ messageEditDocument(v view, preparation *editPreparation, values url.Values, result editResult) {
	{{ fields := editNativeValues(preparation, values, v.CSRF, v.Locale) }}
	{{ initial := preparation != nil && preparation.Target.Eligible }}
	{{ unresolved := preparation == nil && !result.Rejected && (result.Command == nil || result.Command.State != "submitted" && result.Command.State != "failed") }}
	<!DOCTYPE html>
	<html lang={ v.Locale } data-mode={ v.Theme } class={ templ.KV("dark", v.Theme == "dark") }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ v.Text.EditMessage }</title>
			@head.Dependencies(head.WithLocalRuntime())
			<link rel="stylesheet" href="/ui/app.css"/>
			<link rel="stylesheet" href="/ui/message-correction.css"/><script src="/ui/theme.js"></script>
		</head>
		<body>
			<main class="oie-edit-document">
				<h1>{ v.Text.EditMessage }</h1>
				if preparation!=nil&&!preparation.Target.Eligible {
					<p role="status">{ v.Text.EditUnavailable }</p>
				}
				if result.Message!="" {
					<p role="status">{ result.Message }</p>
				}
				if initial||unresolved {
					<form action="/ui/messages/edit" method="post">
						for _,name:=range []string{"csrf","lang","engineId","accountId","conversationId","messageId","expectedRevisionId","operationKey"} {
							<input type="hidden" name={ name } value={ fields.Get(name) }/>
						}
						@textarea.Textarea(textarea.Config{ID: "native-edit-message", Name: "originalText", Label: v.Text.Message, Value: fields.Get("originalText"), Rows: 8, InputAttrs: templ.Attributes{"readonly": !initial, "maxlength": "16384"}})
						<footer>
							if initial {
								@button.Button(button.WithType("submit")) {
									<span>{ v.Text.SaveEdit }</span>
								}
							} else {
								@button.Button(button.WithType("submit"), button.WithAttrs(templ.Attributes{"formaction": "/ui/messages/edit-receipt"})) {
									<span>{ v.Text.EditCheckStatus }</span>
								}
								if result.Command==nil {
									@button.Button(button.WithType("submit"), button.WithAppearance(button.AppearancePlain)) {
										<span>{ v.Text.EditRetry }</span>
									}
								}
							}
						</footer>
					</form>
				}
				@link.Link(v.href("section", "chats", "account", fields.Get("accountId"), "chat", fields.Get("conversationId"), "lang", v.Locale, "theme", v.Theme)) {
					<span>{ v.Text.Back }</span>
				}
			</main>
		</body>
	</html>
}
