package web

import (
 "strconv"
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/icon/heroicons"
 "github.com/araihu/goshtoso/components/popover"
 "github.com/araihu/goshtoso/components/textinput"
 "github.com/araihu/goshtoso/expressions"
)

templ emojiPicker(v view) {
@popover.Popover(popover.Config{ID:"oie-emoji-picker",Trigger:emojiTrigger(v),Content:emojiContent(v),Placement:popover.PlacementTopEnd,Role:"dialog",Label:v.Text.EmojiPicker,RootClass:"oie-emoji-picker",PanelClass:"oie-emoji-panel"})
}

templ emojiTrigger(v view) {
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-icon-button"),button.WithAttrs(templ.Attributes{"data-emoji-trigger":"","aria-label":v.Text.EmojiPicker,"title":v.Text.EmojiPicker,"disabled":!v.composeAllowed()})){@glyph(heroicons.Icon16SolidFaceSmile)}
}

templ emojiContent(v view) {
{{ ctx=expressions.With(ctx,expressions.Set{TextInput:expressions.TextInput{SearchAriaLabel:v.Text.EmojiSearch}}) }}
<div class="oie-emoji-content" data-emoji-content data-emoji-url={"/ui/emoji/"+v.Locale+".json"} data-emoji-loading={v.Text.EmojiLoading} data-emoji-empty={v.Text.EmojiEmpty} data-emoji-failed={v.Text.EmojiFailed} data-emoji-no-recent={v.Text.EmojiNoRecent}>
@textinput.TextInput(textinput.Config{ID:"emoji-search",Type:textinput.TypeSearch,Placeholder:v.Text.EmojiSearch,Autocomplete:"off",InputAttrs:templ.Attributes{"aria-label":v.Text.EmojiSearch,"aria-controls":"emoji-grid","maxlength":"128"}})
<p data-emoji-status class="oie-emoji-status" role="status" aria-live="polite"></p>
<div class="oie-emoji-scroll" data-emoji-scroll>
<div id="emoji-grid" class="oie-emoji-sections" role="group" aria-label={v.Text.EmojiPicker}></div>
</div>
<nav class="oie-emoji-footer" aria-label={v.Text.EmojiCategories}>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-emoji-jump"),button.WithAttrs(templ.Attributes{"data-emoji-jump":"recent","aria-label":v.Text.EmojiRecent,"title":v.Text.EmojiRecent,"aria-controls":"emoji-grid","disabled":true})){@glyph(heroicons.Icon16SolidClock)}
for index,label:=range emojiCategoryLabels(v) {
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-emoji-jump"),button.WithAttrs(templ.Attributes{"data-emoji-jump":strconv.Itoa(index),"aria-label":label,"title":label,"aria-controls":"emoji-grid","disabled":true})){<span class="oie-emoji-category-symbol" aria-hidden="true">{emojiCategoryGlyph(index)}</span>}
}
</nav>
<template data-emoji-section-template><section class="oie-emoji-section"><h3 tabindex="-1"></h3><div class="oie-emoji-grid"></div></section></template>
@button.Button(button.WithType("button"),button.WithSize(button.SizeSmall),button.WithAppearance(button.AppearancePlain),button.WithAttrs(templ.Attributes{"data-emoji-retry":"","hidden":true})){ {v.Text.Retry} }
<template data-emoji-button>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-emoji-cell"),button.WithAttrs(templ.Attributes{"data-emoji-pick":""})){}
</template>
<template data-emoji-choice>
<span class="oie-emoji-choice" data-emoji-family>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-emoji-cell"),button.WithAttrs(templ.Attributes{"data-emoji-pick":""})){}
@popover.Popover(popover.Config{Trigger:emojiVariantsTrigger(v),Content:emojiVariantsContent(v),Placement:popover.PlacementBottomStart,Role:"dialog",Label:v.Text.EmojiVariants,RootClass:"oie-emoji-variants",PanelClass:"oie-emoji-variants-panel"})
</span>
</template>
</div>
}

templ emojiVariantsTrigger(v view) {
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-emoji-variants-trigger"),button.WithAttrs(templ.Attributes{"data-emoji-variants-trigger":"","data-emoji-variants-label":v.Text.EmojiVariantsFor,"aria-label":v.Text.EmojiVariants})){@glyph(heroicons.Icon16SolidChevronDown)}
}

templ emojiVariantsContent(v view) {
<div class="oie-emoji-variants-content">
<strong>{v.Text.EmojiVariants}</strong>
<div data-emoji-variants class="oie-emoji-grid" role="group" aria-label={v.Text.EmojiVariants}></div>
</div>
}
