package web

import (
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/components/modal"
	"github.com/araihu/goshtoso/expressions"
)

templ downloadRetentionSettings(v view) {
	<section class="oie-settings-section oie-device-downloads" aria-labelledby="device-downloads-title" data-download-retention={downloadRetentionPath} data-engine={v.EngineID} data-days-label={v.Text.DownloadRetentionDays} data-saved={v.Text.DownloadRetentionSaved} data-cleared={v.Text.DownloadsRemoved} data-failed={v.Text.DownloadRetentionUnavailable}>
		<h2 id="device-downloads-title">{v.Text.DownloadRetentionTitle}</h2>
		<div data-download-preferences>
			<fieldset disabled>
				<label for="device-download-days">{v.Text.DownloadRetentionPeriod}</label>
				<select id="device-download-days" name="days" class="oie-download-select">
					<option value="0">{v.Text.KeepDownloads}</option>
					<option value="7">{downloadDaysLabel(v.Text.DownloadRetentionDays, "7")}</option>
					<option value="30">{downloadDaysLabel(v.Text.DownloadRetentionDays, "30")}</option>
					<option value="90">{downloadDaysLabel(v.Text.DownloadRetentionDays, "90")}</option>
				</select>
				@button.Button(button.WithType("button"), button.WithTone(button.ToneWarning), button.WithAttrs(templ.Attributes{"data-remove-device-downloads": "", "aria-haspopup": "dialog"})) {
					@glyph(heroicons.Icon16SolidTrash)
					<span>{ v.Text.RemoveDownloads }</span>
				}
			</fieldset>
		</div>
		<p role="status" class="oie-download-feedback"></p>
	</section>
}

templ removeDownloadsDialog(v view) {
	@modal.Dialog(modal.DialogConfig{ID:"remove-device-downloads-dialog", Title:v.Text.RemoveDownloads, Content:confirmRemoveDownloads(v)}).WithExpressions(expressions.Modal{DialogCloseAriaLabel:v.Text.Close})
}

templ confirmRemoveDownloads(v view) {
	<p>{v.Text.RemoveDownloadsConfirm}</p>
	<div class="oie-room-action-buttons">
		@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAlpine(&button.AlpineConfig{OnClick:"$dispatch('modal:close',{id:'remove-device-downloads-dialog'})"})) {
			{v.Text.DeleteDataCancel}
		}
		@button.Button(button.WithType("button"), button.WithTone(button.ToneDanger), button.WithAttrs(templ.Attributes{"data-confirm-remove-downloads":""})) {
			{v.Text.RemoveDownloads}
		}
	</div>
}
