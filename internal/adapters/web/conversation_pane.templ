package web

import (
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/emptystate"
 "github.com/araihu/goshtoso/components/icon/heroicons"
 "github.com/araihu/goshtoso/components/link"
 "github.com/araihu/goshtoso/components/skeleton"
 "strconv"
)

// The inbox remains mounted while this conversation-owned region is replaced.
templ conversationPane(v view){
<div id="conversation-pane" data-conversation-request={v.requestKind()} class="oie-conversation-pane" data-conversation-scope={v.conversationScope()} data-route-locale={v.Locale} data-route-theme={v.Theme} data-csrf={v.CSRF} data-open-drawer={v.initialDrawer()} data-engine-id={v.EngineID} data-event-cursor={v.EventCursor} data-conversation-id={v.ChatID} data-account-id={selectedAccountID(v)} data-focus-message={v.FocusMessage} data-context-newer={strconv.FormatBool(v.ContextHasNewer)} data-context-missing={strconv.FormatBool(v.ContextMissing)} data-mock={strconv.FormatBool(v.Preview)} data-open-chat={strconv.FormatBool(v.ChatOpen)}>
@starData(v)
@avatarData(v)
		<section class="oie-chat-pane" aria-label={ v.Text.Conversations }>
			if v.Unavailable && v.ChatOpen {
				<div class="oie-chat-empty">
					@emptystate.EmptyState(emptystate.Config{Title: v.Text.Unavailable, Description: v.Text.UnavailableBody})
					@link.Link(v.href()) {
						{ v.Text.Retry }
					}
					@link.Link(v.href("chat", "")) {
						{ v.Text.Back }
					}
				</div>
			} else if v.NotFound {
				<div class="oie-chat-empty">
					@emptystate.EmptyState(emptystate.Config{Title: v.Text.NotFound, Description: v.Text.NotFoundBody}) @link.Link(v.href("chat", "")) {
	{ v.Text.Back }
}
				</div>
			} else if v.Section=="media" {
				<div class="oie-chat-empty">@glyph(heroicons.Icon16SolidRectangleGroup) @emptystate.EmptyState(emptystate.Config{Title: v.Text.MediaEmpty, Description: v.Text.MediaBody})</div>
			} else if v.Selected!=nil && !v.Unavailable {
				@chatHeader(v)
if v.requestKind()!="" {
 @conversationRequest(v)
}else{
@conversationPreferenceForms(v)
@conversationSearchBar(v)
				if v.Preview {
					<p class="oie-preview-note">{ v.Text.PreviewNote }</p>
				}
				<div id="context-notice" class="oie-context-notice" role="status">@contextNotice(v)</div>
<div class="oie-timeline-frame">
@conversationTimeline(v)
</div>
				@composer(v)
}
			} else {
				<div class="oie-chat-empty">
					<img src={templ.URL(brandURL("icon-192.png"))} alt="" width="90" height="90"/>
					@emptystate.EmptyState(emptystate.Config{Title: v.Text.SelectChat, Description: v.Text.SelectChatBody})
				</div>
			}
		</section>
@conversationSkeleton(v)
if v.requestKind()=="" {
@roomSessionDialog(v)
@conversationDetails(v)
if v.conversationSchedulesAvailable() {
@conversationSchedulesDrawer(v)
}
@senderDrawer(v)
@messageHistoryDrawer(v)
}
</div>
}

templ conversationSkeleton(v view) {
<div class="oie-chat-skeleton" data-conversation-loading hidden>
 <div class="sr-only" role="status">{v.Text.TimelineLoading}</div>
 <div class="oie-chat-skeleton-header">
  @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-chat-skeleton-back"),button.WithAttrs(templ.Attributes{"data-cancel-conversation-loading":"","aria-label":v.Text.Back})){
   @glyph(heroicons.Icon16SolidChevronLeft)
  }
  <div class="oie-chat-skeleton-identity" aria-hidden="true">
   @skeleton.Skeleton(skeleton.Config{Shape:skeleton.ShapeCircle,RootClass:"oie-chat-skeleton-avatar"})
   @skeleton.Skeleton(skeleton.Config{Count:2,RootClass:"oie-chat-skeleton-title"})
  </div>
 </div>
 <div class="oie-chat-skeleton-timeline" aria-hidden="true">
  @skeleton.Skeleton(skeleton.Config{Shape:skeleton.ShapeRectangle,RootClass:"oie-chat-skeleton-message"})
  @skeleton.Skeleton(skeleton.Config{Shape:skeleton.ShapeRectangle,RootClass:"oie-chat-skeleton-message oie-chat-skeleton-outgoing"})
  @skeleton.Skeleton(skeleton.Config{Shape:skeleton.ShapeRectangle,RootClass:"oie-chat-skeleton-message"})
  @skeleton.Skeleton(skeleton.Config{Shape:skeleton.ShapeRectangle,RootClass:"oie-chat-skeleton-message"})
  @skeleton.Skeleton(skeleton.Config{Shape:skeleton.ShapeRectangle,RootClass:"oie-chat-skeleton-message oie-chat-skeleton-outgoing"})
 </div>
 <div class="oie-chat-skeleton-composer" aria-hidden="true">
  @skeleton.Skeleton(skeleton.Config{Shape:skeleton.ShapeRectangle,ItemClass:"oie-chat-skeleton-input"})
 </div>
</div>
}

templ conversationTimeline(v view) {
<div class="oie-timeline" id="message-timeline" tabindex="0" aria-label={v.Text.Conversations} data-version={v.timelineVersion()} data-engine-id={v.EngineID} data-conversation-id={v.ChatID}
 if v.RoomArchive != nil {
  data-room-archive={string(v.RoomArchive.Availability)}
  data-archive-text-search={string(v.RoomArchive.TextSearch)}
  data-archive-initial={strconv.FormatBool(v.RoomArchive.InitialComplete)}
  data-archive-complete={strconv.FormatBool(v.RoomArchive.OlderComplete)}
  if v.RoomArchive.OldestCoveredAt != nil {
   data-archive-covered={strconv.FormatInt(v.RoomArchive.OldestCoveredAt.UnixMilli(),10)}
  }
 }
>
@timeline(v)
</div>
}

templ timelineNavigationFragment(v view) {
	<div>
		@starData(v)
		@avatarData(v)
		@conversationTimeline(v)
	</div>
}
