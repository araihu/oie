package web

import (
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/components/tooltip"
)

// Each mounted subpage declares its return destination. Only the active destination is shown in the header.
templ drawerReturn(label string, destination templ.Attributes) {
	<template data-drawer-return={ label } { destination... }></template>
}

templ drawerHeaderBack(id string) {
	<div data-drawer-leading hidden>
		@tooltip.Tooltip(id+"-back-tip", "", tooltip.WithTrigger(drawerBackButton()), tooltip.WithPosition(tooltip.PositionBottom), tooltip.WithPortal(true))
	</div>
}

templ drawerBackButton() {
	@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithRootClass("oie-drawer-back"), button.WithAttrs(templ.Attributes{"data-drawer-back": ""})) {
		@glyph(heroicons.Icon16SolidChevronLeft)
	}
}
