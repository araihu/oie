package web

import (
	"github.com/araihu/goshtoso/components/avatar"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/chatbubble"
	"github.com/araihu/goshtoso/components/checkbox"
	"github.com/araihu/goshtoso/components/modal"
	"github.com/araihu/goshtoso/components/textinput"
	"github.com/araihu/goshtoso/expressions"
)

templ forwardDialog(v view) {
	@modal.Dialog(modal.DialogConfig{ID: "forward-message-dialog", Title: v.Text.ForwardTitle, FullscreenMobile: true, Content: forwardDialogBody(v)}).WithExpressions(expressions.Modal{DialogCloseAriaLabel: v.Text.Close})
}

templ forwardDialogBody(v view) {
	<div data-forward-body data-retry={ v.Text.Retry } data-loading={ v.Text.ForwardLoading } data-failed={ v.Text.ForwardFailed } data-complete={ v.Text.ForwardComplete } data-unconfirmed={ v.Text.ForwardUnconfirmed } data-sending={ v.Text.ForwardSending }></div>
}

templ forwardForm(v view, source messageView, rooms []forwardRoom) {
	<form method="post" action="/ui/messages/forward" data-forward-form>
		<input type="hidden" name="engineId" value={ v.EngineID }/>
		<input type="hidden" name="csrf" value={ v.CSRF }/>
		<input type="hidden" name="messageId" value={ source.Id }/>
		<input type="hidden" name="revisionId" value={ source.RevisionId }/>
		<div id="forward-message-preview" class="oie-forward-preview" data-forward-preview data-source-revision={ source.RevisionId }>
			<div class={ "oie-starred-bubble", templ.KV("oie-message-own",source.IsOwn) }>
				@chatbubble.ChatBubble(chatbubble.Config{Side:messageSide(source.IsOwn),RootClass:"oie-bubble",MessageContent:starredBubbleBody(v,source,messageTimelineTime(source.Message))})
			</div>
		</div>
		if len(rooms) == 0 {
			<p role="status">{ v.Text.ForwardNoRooms }</p>
		} else {
			@textinput.TextInput(textinput.Config{ID: "forward-search", Label: v.Text.ForwardSearchRooms, Type: textinput.TypeSearch, InputAttrs: templ.Attributes{"data-forward-search": "", "aria-controls": "forward-rooms"}})
			<fieldset id="forward-rooms" class="oie-forward-rooms" aria-describedby="forward-no-results">
				<legend>{ v.Text.ForwardChooseRooms }</legend>
				<div class="oie-forward-room-list">
					for _, room := range rooms {
						{{ id := "forward-room-" + room.Id; labelID := id + "-title"; infoID := id + "-info" }}
						<div data-forward-room data-room-address={ room.Address } class="oie-forward-room">
							@checkbox.Checkbox(checkbox.Config{ID: id, Name: "conversationId", Value: room.Id, InputAttrs: templ.Attributes{"data-key": newOperationKey(), "aria-labelledby": labelID, "aria-describedby": infoID}})
							<label for={ id } class="oie-forward-room-label" data-forward-room-label>
								<span aria-hidden="true">
									@avatar.Avatar(avatar.Config{Name:room.Title, Src:v.avatarSource(room.AccountId,room.Address), Size:avatar.SizeSM})
								</span>
								<span class="oie-forward-room-text">
									<strong id={ labelID }>{ room.Title }</strong>
									<span id={ infoID } class="oie-forward-room-info">
										if room.Kind == "direct" && room.Address != room.Title {
											<span class="oie-forward-address" dir="auto">{ room.Address }</span>
										}
										if room.Topic != "" {
											<span class="oie-forward-topic" title={ room.Topic }>{ room.Topic }</span>
										}
										<small>{ v.accountLabel(room.AccountId) }</small>
									</span>
								</span>
							</label>
							<p class="oie-forward-result" data-forward-result role="status"></p>
						</div>
					}
				</div>
			</fieldset>
			<p id="forward-no-results" data-forward-no-results role="status" hidden>{ v.Text.ForwardNoRoomsFound }</p>
			<footer class="oie-forward-footer">
				@button.Button(button.WithType("submit"), button.WithAttrs(templ.Attributes{"data-forward-submit": "", "aria-disabled": "true", "data-send": v.Text.Forward, "data-retry": v.Text.Retry})){ { v.Text.Forward } }
			</footer>
		}
	</form>
}
