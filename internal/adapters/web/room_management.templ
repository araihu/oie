package web

import (
	"slices"
	"strconv"
	"strings"

	"github.com/araihu/goshtoso/components/avatar"
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/drawer"
	"github.com/araihu/goshtoso/components/dropdown"
	"github.com/araihu/goshtoso/components/fileinput"
	"github.com/araihu/goshtoso/components/form"
	selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/goshtoso/components/tabs"
	"github.com/araihu/goshtoso/components/textarea"
	"github.com/araihu/goshtoso/components/textinput"
	"github.com/araihu/goshtoso/expressions"
	"github.com/araihu/oie/internal/adapters/httpapi/engineapi"
)

templ roomManagementDrawer(v view) {
	if v.Selected != nil && v.Selected.Kind == "room" && v.requestKind() == "" && !v.Preview {
		@drawer.Drawer(drawer.Config{ID: "room-management", Title: v.Text.RoomManage, PanelClass: "oie-conversation-details-drawer"}) {
			<div class="oie-settings oie-room-management" data-room-management data-invite-title={ v.Text.RoomInvitePeople } data-manage-title={ v.Text.RoomManage } data-chat={ v.Selected.Id } data-account={ v.Selected.AccountId } data-engine={ v.EngineID } data-lang={ v.Locale } data-loading={ v.Text.RoomManagementLoading } data-unavailable={ v.Text.RoomManagementUnavailable }>
				@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"data-room-management-refresh": ""})) {
					{ v.Text.DetailsRefresh }
				}
				<div role="status" aria-live="polite" data-room-management-status></div>
				<div data-room-management-content></div>
			</div>
		}
	}
}

templ roomManagementContent(v view, state engineapi.RoomManagement, messageID, affiliation string, invite bool) {
	if state.State != "available" || state.Revision == nil {
		if state.State == "not_joined" {
			<p>{ v.Text.RoomJoinRequired }</p>
		} else if state.State == "not_connected" {
			<p>{ v.Text.NotConnected }</p>
		} else {
			<p>{ v.Text.RoomManagementUnavailable }</p>
		}
	} else if invite {
		if slices.Contains(state.Actions,engineapi.Invite) {
			@roomManagementForm(v, *state.Revision, "invite", "", v.Text.RoomInvite, nil)
		} else {
			<p>{ v.Text.RoomManagementDenied }</p>
		}
	} else if messageID != "" {
		if slices.Contains(state.Actions,engineapi.RoomManagementAction("moderate_message")) {
			@roomManagementForm(v, *state.Revision, "moderate_message", messageID, v.Text.RoomModerateMessage, nil)
		} else {
			<p>{ v.Text.RoomManagementDenied }</p>
		}
	} else {
		{{ ctx = expressions.With(ctx, expressions.Set{Tabs: expressions.Tabs{OptionsAriaLabel: v.Text.RoomManage}}) }}
		{{
			pages := []tabs.Tab{
				{ID: "details", Label: v.Text.RoomDetailsTab, Content: roomManagementDetails(v, state)},
				{ID: "participants", Label: v.Text.Participants, Content: roomManagementParticipants(v, state)},
			}
		}}
		if slices.Contains(state.Actions, engineapi.Affiliation) {
			{{
				pages = append(pages,
					tabs.Tab{ID: "access", Label: v.Text.RoomAccessTab, Content: roomManagementAccess(v, state, affiliation)},
					tabs.Tab{ID: "bans", Label: v.Text.RoomBans, Content: roomManagementBans(v, state, affiliation)},
				)
			}}
		}
		@tabs.Tabs(tabs.Config{ID: "room-management-tabs", RootClass: "oie-room-management-tabs", Tabs: pages})
	}
}

templ roomManagementDetails(v view, state engineapi.RoomManagement) {
	{{ canRename := slices.Contains(state.Actions, engineapi.Rename) }}
	{{ canEditTopic := slices.Contains(state.Actions, engineapi.Topic) }}
	<div class="oie-room-management-avatar">
		@profileAvatar(v, v.Selected.AccountId, v.Selected.Address, avatar.Config{Name: v.infoTitle(), Size: avatar.SizeXL})
	</div>
	if slices.Contains(state.Actions, engineapi.SetAvatar) {
		@roomAvatarControls(v, *state.Revision)
	}
	if !canRename {
		<strong>{ v.infoTitle() }</strong>
	}
	if canRename || canEditTopic {
		@roomDetailsForm(v, *state.Revision, canRename, canEditTopic)
	}
	if !canEditTopic && v.managementTopic() != "" {
		<p class="oie-details-plain">{ v.managementTopic() }</p>
	}
}

templ roomManagementParticipants(v view, state engineapi.RoomManagement) {
	if len(state.Occupants) > 0 {
		<ul class="oie-room-participants">
			for _, occupant := range state.Occupants {
				@roomParticipant(v, *state.Revision, occupant)
			}
		</ul>
	} else {
		<p>{ v.Text.RoomNoVisibleParticipants }</p>
	}
}

templ roomManagementAccess(v view, state engineapi.RoomManagement, affiliation string) {
	<div class="oie-room-entry-links" aria-label={ v.Text.RoomAccess }>
		for _, value := range []string{"member", "admin", "owner"} {
			@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"data-room-affiliation-list": value, "aria-pressed": strconv.FormatBool(affiliation == value)})) {
				{ roomManagementLabel(v.Text, value) }
			}
		}
	</div>
	if affiliation != "" && affiliation != "outcast" {
		@roomAccessList(v, state.Affiliations)
	}
	@roomManagementForm(v, *state.Revision, "affiliation", "", v.Text.RoomSetAffiliation, roomOptions(v.Text, []string{"member", "admin", "owner", "none"}))
}

templ roomAccessList(v view, addresses []string) {
	if len(addresses) == 0 {
		<p>{ v.Text.RoomNoAddresses }</p>
	} else {
		<ul class="oie-room-addresses">
			for _, address := range addresses {
				<li>{ address }</li>
			}
		</ul>
	}
}

templ roomManagementBans(v view, state engineapi.RoomManagement, affiliation string) {
	if affiliation == "outcast" {
		if len(state.Affiliations) == 0 {
			<p>{ v.Text.RoomNoBans }</p>
		} else {
			<ul class="oie-room-addresses" aria-label={ v.Text.RoomBannedAddresses }>
				for _, address := range state.Affiliations {
					{{ id := "unban-" + newOperationKey() }}
					<li>
						<span>{ address }</span>
						@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"id": id, "data-room-action-open": "", "aria-label": v.Text.RoomUnban + " · " + address})) {
							{ v.Text.RoomUnban }
						}
						@roomTargetAction(v, *state.Revision, id, address, "affiliation", "none", v.Text.RoomUnban, false)
					</li>
				}
			</ul>
		}
	}
	@roomTargetAction(v, *state.Revision, "", "", "affiliation", "outcast", v.Text.RoomBan, true)
}

type roomParticipantAction struct {
	action, value, label string
	danger               bool
}

func roomParticipantActions(text copy, occupant engineapi.RoomManagedOccupant) []roomParticipantAction {
	var actions []roomParticipantAction
	for _, role := range occupant.Roles {
		var label string
		switch role {
		case "none":
			label = text.RoomKick
		case "visitor":
			label = text.RoomRevokeVoice
		case "participant":
			label = text.RoomGrantVoice
			if occupant.Role == "moderator" {
				label = text.RoomDemoteModerator
			}
		case "moderator":
			label = text.RoomPromoteModerator
		}
		if label != "" {
			actions = append(actions, roomParticipantAction{"role", string(role), label, role == "none"})
		}
	}
	for _, affiliation := range occupant.Affiliations {
		var label string
		switch affiliation {
		case "none":
			label = text.RoomRevokeAccess
		case "member":
			label = text.RoomMakeMember
		case "admin":
			label = text.RoomMakeAdmin
		case "owner":
			label = text.RoomMakeOwner
		case "outcast":
			label = text.RoomBan
		}
		if label != "" {
			actions = append(actions, roomParticipantAction{"affiliation", string(affiliation), label, affiliation == "outcast"})
		}
	}
	return actions
}

templ roomParticipant(v view, revision string, occupant engineapi.RoomManagedOccupant) {
	{{
		id := "room-participant-" + strings.TrimPrefix(occupant.Id, "occupant:")
		label := strings.ReplaceAll(v.Text.RoomParticipantActions, "{name}", occupant.Nickname)
		actions := roomParticipantActions(v.Text, occupant)
	}}
	<li class="oie-room-participant" data-room-participant>
		<div class="oie-room-participant-row">
			<div>
				<strong>{ occupant.Nickname }</strong>
				<small>
					{ roomManagementLabel(v.Text, string(occupant.Role)) }
					if occupant.Affiliation != "none" {
						{ " · " + roomManagementLabel(v.Text, string(occupant.Affiliation)) }
					}
				</small>
			</div>
			if len(actions) > 0 {
				{{ items := make([]dropdown.Item, 0, len(actions)) }}
				for _, action := range actions {
					{{ items = append(items, dropdown.Item{ID: id + "-" + action.action + "-" + action.value, Label: action.label, OnClick: "void 0", Danger: action.danger}) }}
				}
				@dropdown.Dropdown(dropdown.Config{ID: id, Label: label, Trigger: menuTrigger(label), MenuAlign: dropdown.AlignEnd, Sections: []dropdown.Section{{Items: items}}})
			}
		</div>
		for _, action := range actions {
			@roomTargetAction(v, revision, id+"-"+action.action+"-"+action.value, occupant.Id, action.action, action.value, action.label, action.danger)
		}
	</li>
}

templ roomTargetAction(v view, revision, trigger, target, action, value, label string, danger bool) {
	{{
		key := newOperationKey()
		id := "manage-room-" + key
	}}
	@form.Form(form.Config{ID: id, Action: "/ui/rooms/manage", RootAttrs: templ.Attributes{"data-oie-action": "room-management", "data-room-action-form": trigger, "hidden": trigger != ""}}) {
		@roomManagementFields(v, revision, action, key)
		<input type="hidden" name="value" value={ value }/>
		if target == "" {
			@textinput.TextInput(textinput.Config{ID: id + "-address", Name: "target", Label: v.Text.RoomUserAddress, Required: true, InputAttrs: templ.Attributes{"maxlength": "2047", "spellcheck": "false", "autocapitalize": "none"}})
		} else {
			<input type="hidden" name="target" value={ target }/>
		}
		if value != "none" || action == "role" {
			@textinput.TextInput(textinput.Config{ID: id + "-reason", Name: "reason", Label: v.Text.RoomReason, InputAttrs: templ.Attributes{"maxlength": "500"}})
		}
		<div class="oie-room-action-buttons">
			{{
				tone := button.TonePrimary
				if danger {
					tone = button.ToneDanger
				}
			}}
			@button.Button(button.WithType("submit"), button.WithTone(tone)) {
				{ label }
			}
			if trigger != "" {
				@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"data-room-action-cancel": ""})) {
					{ v.Text.RoomCancelAction }
				}
			}
		</div>
		<div data-form-feedback role="status" aria-live="polite"></div>
	}
}

templ roomAvatarControls(v view, revision string) {
	<div class="oie-room-avatar-actions">
		@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"id": "room-change-avatar", "data-room-action-open": ""})) {
			{ v.Text.RoomChangeAvatar }
		}
		@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"id": "room-remove-avatar", "data-room-action-open": "", "hidden": true})) {
			{ v.Text.RoomRemoveAvatar }
		}
	</div>
	{{ ctx = expressions.With(ctx, expressions.Set{FileInput: expressions.FileInput{BrowseLabel: v.Text.RoomAvatarBrowse, EmptyText: v.Text.RoomAvatarEmpty}}) }}
	{{ key := newOperationKey() }}
	@form.Form(form.Config{ID: "room-avatar-upload", Action: "/ui/rooms/manage", RootAttrs: templ.Attributes{"enctype": "multipart/form-data", "data-oie-action": "room-management", "data-room-action-form": "room-change-avatar", "hidden": true}}) {
		@roomManagementFields(v, revision, "set_avatar", key)
		@fileinput.FileInput(fileinput.Config{ID: "room-avatar-image", Name: "image", Label: v.Text.RoomAvatarFile, Appearance: fileinput.AppearanceUpload, Accept: "image/png,image/jpeg,image/gif", HelperText: v.Text.RoomAvatarHint, Required: true})
		<div class="oie-room-action-buttons">
			@button.Button(button.WithType("submit")) {
				{ v.Text.RoomChangeAvatar }
			}
			@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"data-room-action-cancel": ""})) {
				{ v.Text.RoomCancelAction }
			}
		</div>
		<div data-form-feedback role="status" aria-live="polite"></div>
	}
	{{ removeKey := newOperationKey() }}
	@form.Form(form.Config{ID: "room-avatar-removal", Action: "/ui/rooms/manage", RootAttrs: templ.Attributes{"data-oie-action": "room-management", "data-room-action-form": "room-remove-avatar", "hidden": true}}) {
		@roomManagementFields(v, revision, "remove_avatar", removeKey)
		<div class="oie-room-action-buttons">
			@button.Button(button.WithType("submit"), button.WithTone(button.ToneDanger)) {
				{ v.Text.RoomRemoveAvatar }
			}
			@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"data-room-action-cancel": ""})) {
				{ v.Text.RoomCancelAction }
			}
		</div>
		<div data-form-feedback role="status" aria-live="polite"></div>
	}
}

func roomOptionLabel(text copy, action string) string {
	if action == "role" {
		return text.RoomRoleLabel
	}
	return text.RoomAccess
}

func (v view) managementTopic() string {
	if v.ConversationInfo != nil && v.ConversationInfo.Topic != nil {
		return *v.ConversationInfo.Topic
	}
	return ""
}

func roomOptions[T ~string](text copy, values []T) []selectfield.Option {
	out := make([]selectfield.Option, 0, len(values))
	for _, value := range values {
		out = append(out, selectfield.Option{Value: string(value), Label: roomManagementLabel(text, string(value))})
	}
	return out
}

templ roomManagementForm(v view, revision, action, target, label string, options []selectfield.Option) {
	{{
		key := newOperationKey()
		id := "manage-room-" + key
	}}
	@form.Form(form.Config{ID: id, Action: "/ui/rooms/manage", Method: "post", RootAttrs: templ.Attributes{"data-oie-action": "room-management"}}) {
		@roomManagementFields(v, revision, action, key)
		switch action {
			case "moderate_message":
				<input type="hidden" name="messageId" value={ target }/>
			default:
				if target=="" {
					@textinput.TextInput(textinput.Config{ID: id + "-address", Name: "target", Label: v.Text.RoomUserAddress, Required: true, InputAttrs: templ.Attributes{"maxlength": "2047", "spellcheck": "false", "autocapitalize": "none"}})
				} else {
					<input type="hidden" name="target" value={ target }/>
				}
				if len(options)>0 {
					@selectfield.Select(selectfield.Config{ID: id + "-value", Name: "value", Label: roomOptionLabel(v.Text, action), Options: options, Required: true, Placeholder: v.Text.RoomSelectAction})
				}
		}
		if action=="invite" || action=="moderate_message" || action=="role" || action=="affiliation" {
			@textinput.TextInput(textinput.Config{ID: id + "-reason", Name: "reason", Label: v.Text.RoomReason, InputAttrs: templ.Attributes{"maxlength": "500"}})
		}
		@button.Button(button.WithType("submit")) {
			{ label }
		}
		<div data-form-feedback role="status" aria-live="polite"></div>
	}
}

templ roomManagementFields(v view, revision, action, key string) {
	@mutationFields(v, "room-management", key)
	<input type="hidden" name="conversationId" value={ v.Selected.Id }/>
	<input type="hidden" name="accountId" value={ v.Selected.AccountId }/>
	<input type="hidden" name="lang" value={ v.Locale }/>
	<input type="hidden" name="managementAction" value={ action }/>
	<input type="hidden" name="expectedRevision" value={ revision }/>
}

templ roomDetailsForm(v view, revision string, canRename, canEditTopic bool) {
	{{
		key := newOperationKey()
		id := "manage-room-" + key
	}}
	@form.Form(form.Config{ID: id, Action: "/ui/rooms/manage", Method: "post", RootAttrs: templ.Attributes{"data-oie-action": "room-management"}}) {
		@roomManagementFields(v, revision, "update_details", key)
		if canRename {
			<input type="hidden" name="originalName" value={ v.infoTitle() }/>
			@textinput.TextInput(textinput.Config{ID: id + "-name", Name: "name", Label: v.Text.RoomManagedName, Value: v.infoTitle(), Required: true, InputAttrs: templ.Attributes{"maxlength": "100"}})
		}
		if canEditTopic {
			<input type="hidden" name="originalTopic" value={ v.managementTopic() }/>
			@textarea.Textarea(textarea.Config{ID: id + "-topic", Name: "topic", Label: v.Text.RoomTopic, Value: v.managementTopic(), Rows: 3, InputAttrs: templ.Attributes{"maxlength": "2000"}})
		}
		@button.Button(button.WithType("submit")) {
			{ v.Text.RoomSaveDetails }
		}
		<div data-form-feedback role="status" aria-live="polite"></div>
	}
}
