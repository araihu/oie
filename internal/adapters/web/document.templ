package web

import (
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/card"
 "github.com/araihu/goshtoso/components/icon/heroicons"
 "github.com/araihu/goshtoso/components/link"
 "github.com/araihu/goshtoso/components/modal"
 "github.com/araihu/oie/internal/adapters/httpapi/engineapi"
)

templ documentCard(v view,item engineapi.SharedContentItem){
<section class="oie-document-card" data-document-item={item.Id} data-document-engine={v.EngineID} data-document-account={item.Message.AccountId} data-document-conversation={item.Message.ConversationId} data-document-message={item.Message.Id} data-document-filename={v.sharedTitle(item)} data-document-format={documentFormat(item)} data-document-source={documentSource(v,item)} data-document-url={safePreviewURL(item.Url)}>
@card.Card(card.Config{Title:v.sharedTitle(item),TitlePrefix:glyph(heroicons.Icon16SolidDocumentText),Body:documentCardAction(v),Density:card.DensityCompact,RootClass:"oie-document-card-surface"})
</section>
}
templ documentCardAction(v view){
@button.Button(button.WithType("button"),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"data-document-open":""})){ {v.Text.DocumentOpen} }
}

templ documentViewer(v view){
<div data-document-copy hidden data-loading={v.Text.DocumentLoading} data-failed={v.Text.DocumentLoadFailed} data-unsupported={v.Text.DocumentUnsupported} data-empty={v.Text.DocumentEmpty} data-page={v.Text.DocumentPage}></div>
@modal.Dialog(modal.DialogConfig{ID:"oie-document-viewer",Title:v.Text.DocumentViewer,HeaderContent:documentHeader(v),Content:documentContent(v),FullscreenMobile:true})
}
templ documentHeader(v view){
<header class="oie-document-header">
<h2 id="oie-document-title" data-document-title>{v.Text.DocumentViewer}</h2>
<div class="oie-document-actions">
@link.Link("#",link.WithRootClass("oie-document-action"),link.WithAttrs(templ.Attributes{"data-document-download":"","download":"","aria-label":v.Text.DocumentDownload,"title":v.Text.DocumentDownload})){@glyph(heroicons.Icon16SolidArrowDownTray)}
@link.Link("#",link.WithRootClass("oie-document-action"),link.WithAttrs(templ.Attributes{"data-document-original":"","target":"_blank","rel":"noopener noreferrer","aria-label":v.Text.DocumentOriginal,"title":v.Text.DocumentOriginal})){@glyph(heroicons.Icon16SolidArrowTopRightOnSquare)}
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-document-action"),button.WithAttrs(templ.Attributes{"data-document-close":"","aria-label":v.Text.Close,"title":v.Text.Close})){@glyph(heroicons.Icon16SolidXMark)}
</div>
</header>
}
templ documentContent(v view){
<div class="oie-document-viewer-body">
<p data-document-status role="status" aria-live="polite"></p>
<div class="oie-document-pdf-controls" data-document-pdf-controls hidden>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"data-document-previous":"","aria-label":v.Text.DocumentPrevious,"title":v.Text.DocumentPrevious})){@glyph(heroicons.Icon16SolidChevronLeft)}
<span data-document-page></span>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"data-document-next":"","aria-label":v.Text.DocumentNext,"title":v.Text.DocumentNext})){@glyph(heroicons.Icon16SolidChevronRight)}
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"data-document-fit":""})){ {v.Text.DocumentFit} }
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"data-document-zoom-out":"","aria-label":v.Text.DocumentZoomOut,"title":v.Text.DocumentZoomOut})){<span aria-hidden="true">−</span>}
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"data-document-zoom-in":"","aria-label":v.Text.DocumentZoomIn,"title":v.Text.DocumentZoomIn})){@glyph(heroicons.Icon16SolidPlus)}
</div>
<div class="oie-document-scroll" data-document-scroll tabindex="0" aria-label={v.Text.DocumentViewer}>
<pre class="oie-document-text" data-document-text hidden></pre>
<div class="oie-document-pdf-page" data-document-pdf-page hidden>
<canvas data-document-canvas role="img" aria-label={v.Text.DocumentViewer}></canvas>
<div class="textLayer" data-document-text-layer></div>
</div>
</div>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"data-document-retry":"","hidden":true})){ {v.Text.DocumentRetry} }
</div>
}
