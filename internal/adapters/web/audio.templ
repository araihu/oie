package web

import (
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/icon/heroicons"
)

templ audioPlayer(v view, id, filename, source, download string) {
	<section class="oie-audio-card" data-audio-source={source} data-audio-error={v.Text.AudioUnavailable} data-audio-id={id} data-audio-filename={filename} data-audio-download={download} data-audio-download-failed={v.Text.SharedActionFailed}>
		<strong title={filename}>{filename}</strong>
		<div class="oie-audio-controls">
			@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"data-audio-play": "", "aria-label": v.Text.AudioPlay+" · "+filename})) {
				@glyph(heroicons.Icon16SolidPlay)
				{v.Text.AudioPlay}
			}
			<audio controls preload="none" data-audio-player hidden tabindex="0" aria-label={v.Text.SharedAudio+" · "+filename}></audio>
		</div>
	</section>
}
