package web

import (
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/icon/heroicons"
)

templ audioPlayer(v view, id, filename, source, download, mediaType string) {
	<section class="oie-audio-card" data-audio-id={id} data-audio-filename={filename}
		data-audio-download={download} data-audio-download-failed={v.Text.SharedActionFailed} data-audio-error={v.Text.AudioUnavailable}>
		<div class="oie-audio-controls oie-message-audio" data-message-audio
			data-audio-source={source} data-audio-type={mediaType}
			data-audio-play-label={v.Text.AudioPlay} data-audio-pause-label={v.Text.AudioPause}
			data-audio-position-label={v.Text.AudioPosition}
			data-audio-loading={v.Text.AudioLoading} data-audio-unavailable={v.Text.AudioUnavailable}>
			@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-message-audio-play"),button.WithAttrs(templ.Attributes{
				"data-message-audio-play":"", "aria-label":v.Text.AudioPlay+" · "+filename, "hidden":true,
			})){
				<span data-record-play-icon>@glyph(heroicons.Icon16SolidPlay)</span>
				<span data-record-pause-icon hidden>@glyph(heroicons.Icon16SolidPause)</span>
			}
			<div class="oie-message-audio-wave" data-message-audio-wave hidden></div>
			<span class="oie-message-audio-time" hidden>
				<span class="sr-only">{v.Text.AudioDuration}</span>
				<span data-message-audio-time>–:––</span>
			</span>
			<audio src={templ.URL(source)} controls controlslist="nodownload" preload="none" data-audio-player tabindex="0" aria-label={v.Text.SharedAudio+" · "+filename}></audio>
			<span class="sr-only" role="status" data-message-audio-status></span>
			@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAttrs(templ.Attributes{"data-audio-retry": "", "hidden": true, "aria-label": v.Text.Retry+" · "+filename})) {
				{v.Text.Retry}
			}
		</div>
		<strong title={filename}>{filename}</strong>
	</section>
}
