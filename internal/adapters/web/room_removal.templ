package web

import (
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/form"
	"github.com/araihu/goshtoso/components/modal"
	"github.com/araihu/goshtoso/expressions"
)

templ roomRemovalDialog(v view) {
	if v.Selected != nil && v.Selected.Kind == "room" && !v.Preview && !removedRoom(v.Selected) {
		@modal.Dialog(modal.DialogConfig{ID: "room-removal", Title: v.Text.RoomRemoveFromChats, Content: roomRemovalForm(v)}).WithExpressions(expressions.Modal{DialogCloseAriaLabel: v.Text.Close})
	}
}

templ roomRemovalForm(v view) {
	@form.Form(form.Config{ID: "room-removal-form", Action: "/ui/rooms/remove", Method: "post", RootClass: "grid gap-4", RootAttrs: templ.Attributes{"data-oie-action": "remove-room"}}) {
		@mutationFields(v, "room-removal", newOperationKey())
		<input type="hidden" name="conversationId" value={ v.Selected.Id }/>
		<input type="hidden" name="accountId" value={ v.Selected.AccountId }/>
		<input type="hidden" name="expectedRevisionId" value={ v.Selected.RevisionId }/>
		<input type="hidden" name="lang" value={ v.Locale }/>
		<strong>{ v.Selected.Title }</strong>
		<p>{ v.Text.RoomRemoveWarning }</p>
		<div class="oie-room-action-buttons">
			@button.Button(button.WithType("button"), button.WithAppearance(button.AppearancePlain), button.WithAlpine(&button.AlpineConfig{OnClick: "$dispatch('modal:close',{id:'room-removal'})"})) {
				{ v.Text.RoomCancelAction }
			}
			@button.Button(button.WithType("submit"), button.WithTone(button.ToneDanger)) {
				{ v.Text.RoomRemoveFromChats }
			}
		</div>
		<div data-form-feedback role="status" aria-live="polite">
			if v.FormTarget == "room-removal" {
				{ v.ErrorMessage }
			}
		</div>
	}
}
