package web

import (
 "slices"
 "strconv"
 "strings"
 "github.com/araihu/goshtoso/components/avatar"
 "github.com/araihu/goshtoso/components/badge"
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/checkbox"
 "github.com/araihu/goshtoso/components/combobox"
 "github.com/araihu/goshtoso/components/emptystate"
 "github.com/araihu/goshtoso/components/icon/heroicons"
 "github.com/araihu/goshtoso/components/link"
 "github.com/araihu/goshtoso/components/spinner"
 "github.com/araihu/goshtoso/components/textinput"
 "github.com/araihu/goshtoso/components/tooltip"
 "github.com/araihu/goshtoso/expressions"
 "github.com/araihu/oie/internal/adapters/httpapi/engineapi"
)

templ messageSearchSlot(v view){
<div id="message-search-slot" class="oie-message-search-slot" hidden?={!v.GlobalMessageSearch}>
@messageSearchContent(v)
</div>
}
templ messageSearchWorkspace(v view){
<section id="workspace" class="oie-message-search-workspace" aria-label={v.Text.SearchMessages}>
<header class="oie-message-search-heading">
@navigationControl(v)
<h2>{v.Text.SearchMessages}</h2>
@link.Link(v.href("section","chats","q","")){ {v.Text.Back} }
</header>
@messageSearchContent(v)
</section>
}
templ messageSearchContent(v view){
<div class="oie-message-search" data-message-search-root data-search-open={strconv.FormatBool(v.GlobalMessageSearch||v.NativeMessageSearch)} data-native={strconv.FormatBool(v.NativeMessageSearch)} data-title-query={v.Query} data-inbox-filter={v.Filter} data-inbox-section={v.Section} data-search-loading={v.Text.SearchLoading} data-search-failed={v.Text.SearchFailed} data-search-invalid={v.Text.SearchInvalid} data-search-engine-changed={v.Text.EngineChanged} data-search-all={v.Text.SearchAllConversations} data-search-everything={v.Text.SearchEverything}>
if v.NativeMessageSearch {
<p class="oie-message-search-help">{v.Text.SearchSavedMessages}</p>
}
if !v.NativeMessageSearch {
<nav class="oie-search-categories" aria-label={v.Text.SharedMedia}>
@link.Link(v.messageSearchCategoryHref("media"),link.WithRootClass("oie-search-category"),link.WithAttrs(templ.Attributes{"data-message-search-category":"media"})){ {v.Text.SharedMediaTab} }
@link.Link(v.messageSearchCategoryHref("links"),link.WithRootClass("oie-search-category"),link.WithAttrs(templ.Attributes{"data-message-search-category":"links"})){ {v.Text.SharedLinksTab} }
@link.Link(v.messageSearchCategoryHref("documents"),link.WithRootClass("oie-search-category"),link.WithAttrs(templ.Attributes{"data-message-search-category":"documents"})){ {v.Text.SharedDocsTab} }
</nav>
}

<form id="message-search-form" action="/search" method="get" role="search" hx-get="/ui/message-search" hx-trigger="oie:message-search" hx-target="#message-search-page-buffer" hx-select="[data-message-search-response]" hx-swap="innerHTML show:none" hx-sync="this:replace">
<input type="hidden" name="engineId" value={v.EngineID}/><input type="hidden" name="conversationId" value={v.MessageSearch.ConversationID}/><input type="hidden" name="lang" value={v.Locale}/><input type="hidden" name="theme" value={v.Theme}/><input type="hidden" name="limit" value={strconv.Itoa(v.MessageSearch.Limit)}/>
if v.NativeMessageSearch {
@textinput.TextInput(textinput.Config{ID:"message-search-query",Name:"q",Type:textinput.TypeSearch,Label:v.Text.SearchQuery,Placeholder:v.Text.SearchQuery,Value:v.MessageSearch.Query,InputAttrs:templ.Attributes{"aria-label":v.Text.SearchQuery,"maxlength":"400","aria-controls":"message-search-results","autocomplete":"off"}})
}else{
<input type="hidden" name="q" value={v.MessageSearch.Query}/>
}

@messageSearchAccountFilter(v)
<div class="oie-message-search-scope" data-message-search-scope hidden?={v.MessageSearch.ConversationID==""}>
<span>{v.Text.SearchScope}: <strong data-message-search-scope-name>{v.MessageSearch.ConversationTitle}</strong></span>
@link.Link(v.messageSearchAllHref(),link.WithAttrs(templ.Attributes{"data-message-search-clear-scope":""})){ {v.Text.SearchAllConversations} }
</div>
<div class="oie-search-history-option">
@checkbox.Checkbox(checkbox.Config{ID:"message-search-history",Name:"includeEditHistory",Value:"true",Label:v.Text.IncludeEditHistory,Checked:v.MessageSearch.IncludeHistory})
@tooltip.Tooltip("message-search-history-help",v.Text.IncludeEditHistory,tooltip.WithDescription(v.Text.SearchHistoryHelp),tooltip.WithTrigger(searchHistoryInfo(v)),tooltip.WithActivation(tooltip.ActivationClick),tooltip.WithPortal(true),tooltip.WithPosition(tooltip.PositionBottom))
</div>
<noscript>@button.Button(button.WithType("submit")){ {v.Text.SearchMessages} }</noscript>
</form>
<div class="oie-message-search-feedback" data-message-search-loading hidden role="status">@spinner.Spinner(spinner.Config{Size:spinner.SizeSM})<span>{v.Text.SearchLoading}</span></div>
<p id="message-search-feedback" class="oie-message-search-feedback" role="status" hidden></p>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithAttrs(templ.Attributes{"data-message-search-retry":"","hidden":true})){ {v.Text.Retry} }
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithAttrs(templ.Attributes{"data-message-search-restart":"","hidden":true})){ {v.Text.SearchRestart} }
<div id="message-search-scroll" class="oie-message-search-scroll" tabindex="0" aria-label={v.Text.SearchMessages}>
<div id="message-search-results">@messageSearchResponse(v)</div>
<div id="message-search-pagination"></div>
</div>
<div id="message-search-page-buffer" hidden></div>
<template data-message-search-blank>@messageSearchResponse(v.blankMessageSearchView())</template>
</div>
}

templ messageSearchAccountFilter(v view){
{{ ctx=expressions.With(ctx,expressions.Set{Combobox:expressions.Combobox{ClearLabel:v.Text.SearchClearAccounts,SelectedLabel:v.messageSearchAccountCount}});cfg:=v.messageSearchAccountCombobox();selected:=v.MessageSearch.accounts() }}
@combobox.Combobox(cfg,cfg.InitialState())
<noscript>
<fieldset data-message-search-native-accounts><legend>{v.Text.Accounts}</legend>
<input type="hidden" name="nativeAccountFilter" value="1"/>
for _,a:=range v.Accounts {
@checkbox.Checkbox(checkbox.Config{ID:"message-search-native-"+a.Id,Name:"nativeAccountId",Value:a.Id,Label:a.Label+" · "+a.Address,Checked:slices.Contains(selected,a.Id)})
}
</fieldset>
</noscript>
}

templ messageSearchResponse(v view){
<div data-message-search-response data-search-engine={v.EngineID} data-search-query={v.MessageSearch.Query} data-search-account={strings.Join(v.MessageSearch.accounts(),",")} data-search-conversation={v.MessageSearch.ConversationID} data-search-history={strconv.FormatBool(v.MessageSearch.IncludeHistory)} data-search-cursor={v.MessageSearch.Cursor} data-search-state={v.MessageSearch.State} data-search-next={v.messageSearchNext()}>
<div data-message-search-items>
if v.MessageSearch.ConversationID==""&&v.MessageSearch.Query!=""&&v.MessageSearch.Page!=nil&&len(v.MessageSearch.Page.Items)==0&&len(v.MessageSearch.Conversations)==0&&len(v.MessageSearch.Contacts)==0&&!v.MessageSearch.ContactsKnown {
<p class="oie-message-search-help" data-message-search-contact-coverage>{v.Text.SearchContactsCoverage}</p>
@link.Link(v.messageSearchNativeHref(""),link.WithAttrs(templ.Attributes{"data-message-search-retry":""})){ {v.Text.Retry} }
}

@messageSearchContacts(v)
@messageSearchConversations(v)
if v.MessageSearch.State=="blank" {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.SearchBlankTitle,Description:v.Text.SearchBlankBody})
}else if v.MessageSearch.State=="invalid" {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.SearchInvalid,Description:v.Text.SearchBlankBody})
@link.Link(v.messageSearchNativeHref(""),link.WithAttrs(templ.Attributes{"data-message-search-restart":""})){ {v.Text.SearchRestart} }
}else if v.MessageSearch.State=="missing" {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.SearchMissing})
}else if v.MessageSearch.State=="engine_changed" {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.EngineChanged})
}else if v.MessageSearch.Page==nil {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.SearchFailed})
@link.Link(v.messageSearchNativeHref(v.MessageSearch.Cursor),link.WithAttrs(templ.Attributes{"data-message-search-retry":""})){ {v.Text.Retry} }
}else if len(v.MessageSearch.Page.Items)==0 {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.SearchEmptyTitle,Description:v.Text.SearchEmptyBody})
}else{
for _,hit:=range v.MessageSearch.Page.Items {
@messageSearchHit(v,hit)
}
}
</div>
<div data-message-search-pagination>
if v.MessageSearch.Page!=nil&&v.MessageSearch.Page.MetadataIndexing.State=="pending" {
<p class="oie-message-search-help" data-message-search-indexing>{v.Text.SearchMetadataPending} {strconv.FormatInt(v.MessageSearch.Page.MetadataIndexing.IndexedMessages,10)} / {strconv.FormatInt(v.MessageSearch.Page.MetadataIndexing.TotalMessages,10)}</p>
}
if next:=v.messageSearchNext();next!="" {
@link.Link(v.messageSearchNativeHref(next),link.WithAttrs(templ.Attributes{"data-message-search-next":"","data-search-cursor":next})){ {v.Text.SearchMore} }
}
</div>
</div>
}
templ messageSearchHit(v view,hit engineapi.MessageSearchHit){
{{ senderAvatar:=avatar.Config{Name:hit.Message.Sender.DisplayName,Initials:initials(hit.Message.Sender.DisplayName),Size:avatar.SizeXS};if hit.SenderAvatarHash!=nil {senderAvatar.Src=avatarImageSource(*hit.SenderAvatarHash)} }}
<article data-message-search-hit={hit.Message.Id+":"+hit.MatchedRevisionId} data-search-message={hit.Message.Id} data-search-revision={hit.MatchedRevisionId} data-search-historical={strconv.FormatBool(hit.Historical)} data-search-match-kind={string(hit.MatchKind)}>
@link.Link(v.messageSearchSourceHref(hit.Message),link.WithRootClass("oie-message-search-hit"),link.WithAttrs(templ.Attributes{"data-message-search-source":""})){
<div class="oie-search-result-identity">
<div class="oie-search-avatar" aria-hidden="true">@avatar.Avatar(senderAvatar)</div>
<div class="oie-search-result-copy">
<div class="oie-message-search-hit-heading"><strong>{hit.ConversationTitle}</strong><time data-message-search-time datetime={hit.Message.CreatedAt.Format("2006-01-02T15:04:05Z07:00")}>{hit.Message.CreatedAt.Format("2006-01-02 15:04")}</time></div>
<small>{hit.AccountLabel} · {hit.Message.Sender.DisplayName}</small>
</div>
</div>
if hit.Historical {
@badge.Badge(badge.Config{Label:v.Text.SearchPriorVersion,Size:badge.SizeSM,Appearance:badge.AppearanceSoft})
}
if hit.MatchKind=="metadata" {
@badge.Badge(badge.Config{Label:v.Text.SearchMetadata,Size:badge.SizeSM,Appearance:badge.AppearanceSoft})
}
<p class="oie-message-search-excerpt">{hit.Excerpt}</p>
}
</article>
}

templ messageSearchConversations(v view){
if len(v.MessageSearch.Conversations)>0 {
<section class="oie-search-conversations" data-message-search-conversations>
<h3>{v.Text.SearchConversations}</h3>
for _,c:=range v.MessageSearch.Conversations {
@link.Link(v.messageSearchConversationHref(c),link.WithRootClass("oie-search-conversation"),link.WithAttrs(templ.Attributes{"data-message-search-conversation":c.Id})){
<div class="oie-search-result-identity">
<div class="oie-search-avatar" aria-hidden="true">@profileAvatar(v,c.AccountId,c.Address,avatar.Config{Name:c.Title,Initials:chatInitials(c),Size:avatar.SizeXS})</div>
<div class="oie-search-result-copy"><strong>{c.Title}</strong><small>{c.Address}</small></div>
</div>
}
}
if v.MessageSearch.ConversationsLimited {
<p class="oie-message-search-help">{v.Text.SearchConversationsLimited}</p>
}
</section>
}
if v.MessageSearch.Query!=""&&v.MessageSearch.Cursor==""&&v.MessageSearch.ConversationID=="" {
<h3 class="oie-search-messages-heading">{v.Text.SearchMessagesGroup}</h3>
}
}

templ messageSearchContacts(v view){
if len(v.MessageSearch.Contacts)>0 {
<section class="oie-search-contacts" data-message-search-contacts data-search-contacts-known={strconv.FormatBool(v.MessageSearch.ContactsKnown)}>
<h3>{v.Text.SearchContacts}</h3>
for _,c:=range v.MessageSearch.Contacts {
@link.Link(v.messageSearchContactHref(c),link.WithRootClass("oie-search-conversation"),link.WithAttrs(templ.Attributes{"data-message-search-contact":c.Id})){<strong>{c.DisplayName}</strong><small>{c.AccountLabel} · {c.Address}</small>}
}
if v.MessageSearch.ContactsPartial {
<p class="oie-message-search-help">{v.Text.SearchContactsPartial}</p>
}
if v.MessageSearch.ContactsLimited {
<p class="oie-message-search-help">{v.Text.SearchContactsLimited}</p>
}
</section>
}
}

// Keep the help action outside the checkbox label so it never toggles the filter.
templ searchHistoryInfo(v view){
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithRootClass("oie-search-history-info"),button.WithAttrs(templ.Attributes{"aria-label":v.Text.IncludeEditHistory})){
@glyph(heroicons.Icon16SolidInformationCircle)
}
}
