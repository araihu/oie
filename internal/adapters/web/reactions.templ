package web

import (
 "strconv"
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/icon/heroicons"
 "github.com/araihu/goshtoso/components/modal"
 "github.com/araihu/goshtoso/components/popover"
 "github.com/araihu/goshtoso/components/tooltip"
 "github.com/araihu/goshtoso/components/spinner"
 "github.com/araihu/goshtoso/components/textinput"
 "github.com/araihu/goshtoso/expressions"
)

templ messageReactions(v view,m messageView){
<div class="oie-reactions" data-reaction-source={m.Id} data-reaction-state={v.reactionStateJSON(m.Id)} role="group" aria-label={v.Text.Reactions}>
@popover.Popover(popover.Config{ID:"message-reactions-"+m.Id,Trigger:reactionSummaryTrigger(v,m),Content:reactionDetails(v,m),Placement:reactionSummaryPlacement(m.IsOwn),Role:"dialog",Label:v.Text.Reactions,RootClass:"oie-reaction-summary-popover",PanelClass:"oie-reaction-details-panel",TrapFocus:true})
<div data-reaction-pending></div>
</div>
}

templ reactionSummaryTrigger(v view,m messageView){
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-reaction-summary"),button.WithAttrs(templ.Attributes{"data-reaction-summary":m.Id,"hidden":len(v.Reactions[m.Id].Items)==0,"aria-label":v.Text.Reactions})) {<span data-reaction-summary-emojis aria-hidden="true">{reactionSummaryEmojis(v.Reactions[m.Id])}</span><small data-reaction-summary-count>{strconv.Itoa(reactionSummaryCount(v.Reactions[m.Id]))}</small>}
}

templ reactionDetails(v view,m messageView){
<section class="oie-reaction-details" data-reaction-details={m.Id}>
<header><strong>{v.Text.Reactions}</strong><span data-reaction-total></span></header>
<div class="oie-reaction-filters" data-reaction-filters role="group" aria-label={v.Text.Reactions}></div>
<div class="oie-reaction-detail-list" data-reaction-detail-list></div>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-reaction-add"),button.WithAttrs(templ.Attributes{"data-reaction-open":m.Id,"aria-label":v.Text.ReactMessage})) {@glyph(heroicons.Icon16SolidFaceSmile)<span>{v.Text.ReactMessage}</span>}
</section>
}

templ messageReactionShortcut(v view,m messageView){
<div class="oie-reaction-shortcut-slot" data-reaction-shortcut-slot={m.Id} hidden={ !v.reactionAllowed(m.Id) }>
@tooltip.Tooltip("react-shortcut-tip-"+m.Id,v.Text.ReactMessage,tooltip.WithTrigger(reactionShortcutButton(v,m)),tooltip.WithPortal(true))
</div>
}

templ reactionShortcutButton(v view,m messageView){
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-reaction-shortcut"),button.WithAttrs(templ.Attributes{"data-reaction-open":m.Id,"aria-label":v.Text.ReactMessage})) {@glyph(heroicons.Icon16SolidFaceSmile)}
}

templ reactionDialog(v view){
if v.Selected!=nil {
@modal.Dialog(modal.DialogConfig{ID:"oie-reaction-picker",Title:v.Text.ReactMessage,Content:reactionPickerContent(v),Compact:true})
}
}

templ reactionPickerContent(v view){
{{ ctx=expressions.With(ctx,expressions.Set{TextInput:expressions.TextInput{SearchAriaLabel:v.Text.EmojiSearch}}) }}
<section class="oie-reaction-picker" data-reaction-picker data-emoji-url={"/ui/emoji/"+v.Locale+".json"} data-unavailable={v.Text.ReactionUnavailable} data-unknown={v.Text.ReactionUnknown} data-failed={v.Text.ReactionFailed} data-pending={v.Text.ReactionPending} data-check={v.Text.ReactionCheck} data-remove={v.Text.ReactionRemove} data-retry={v.Text.Retry} data-react={v.Text.ReactMessage} data-loading={v.Text.EmojiLoading} data-load-failed={v.Text.EmojiFailed} data-empty={v.Text.EmojiEmpty} data-all={v.Text.All} data-you={v.Text.You} data-react-summary={v.Text.Reactions}>
<header><strong>{v.Text.ReactMessage}</strong>@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-icon-button"),button.WithAttrs(templ.Attributes{"data-reaction-close":"","aria-label":v.Text.Close})){@glyph(heroicons.Icon16SolidXMark)}</header>
@textinput.TextInput(textinput.Config{ID:"reaction-emoji-search",Type:textinput.TypeSearch,Placeholder:v.Text.EmojiSearch,Autocomplete:"off",InputAttrs:templ.Attributes{"aria-label":v.Text.EmojiSearch,"aria-controls":"reaction-emoji-grid","maxlength":"128"}})
<p data-reaction-picker-status class="oie-reaction-picker-status" role="status" aria-live="polite"></p>
<div id="reaction-emoji-grid" class="oie-reaction-grid" role="group" aria-label={v.Text.Reactions}></div>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithAttrs(templ.Attributes{"data-reaction-catalog-retry":"","hidden":true})){<span>{v.Text.Retry}</span>}
<template data-reaction-emoji-template>@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-emoji-cell"),button.WithAttrs(templ.Attributes{"data-reaction-choice":""})) {}</template>
<template data-reaction-chip-template>@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-reaction-chip"),button.WithAttrs(templ.Attributes{"data-reaction-emoji":""})){<span data-reaction-glyph aria-hidden="true"></span><small data-reaction-count></small><span data-reaction-busy hidden>@spinner.Spinner(spinner.Config{Size:spinner.SizeSM,RootClass:"oie-reaction-spinner"})</span>}</template>
<template data-reaction-filter-template>@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-reaction-filter"),button.WithAttrs(templ.Attributes{"data-reaction-filter":""})) {<span></span>}</template>
<template data-reaction-remove-template>@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-reaction-remove"),button.WithAttrs(templ.Attributes{"data-reaction-emoji":"","aria-label":v.Text.ReactionRemove,"title":v.Text.ReactionRemove})) {@glyph(heroicons.Icon16SolidXMark)}</template>
<template data-reaction-status-template>@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-reaction-chip oie-reaction-recovery"),button.WithAttrs(templ.Attributes{"data-reaction-check":""})){<span data-reaction-check-icon>@glyph(heroicons.Icon16SolidArrowPath)</span><span data-reaction-status-spinner hidden>@spinner.Spinner(spinner.Config{Size:spinner.SizeSM,RootClass:"oie-reaction-spinner"})</span>}</template>
</section>
}
