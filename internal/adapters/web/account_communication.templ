package web

import (
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/form"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/goshtoso/components/toggle"
	selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/oie/internal/adapters/httpapi/engineapi"
)

templ accountCommunication(v view, account string, preferences engineapi.AccountCommunicationPreferences) {
	@form.Form(form.Config{ID:"account-communication-form",Action:"/ui/accounts/communication",Method:"post",RootAttrs:templ.Attributes{"data-oie-action":"account-communication"}}){
		@mutationFieldsAt(v,"account-communication","",v.accountsHref(account))
		<input type="hidden" name="accountId" value={account}/>
		<input type="hidden" name="lang" value={v.Locale}/>
		{{ selected := preferences.Presence }}
		{{ choice := engineapi.AccountCommunicationPreferencesPresence(v.field("presence")) }}
		{{ restoreDraft := v.FormTarget == "account-communication" && choice.Valid() }}
		{{ revision := "" }}
		if preferences.RevisionId != nil {
			{{ revision = *preferences.RevisionId }}
		}
		if restoreDraft {
			{{ selected = choice }}
			{{ revision = v.field("expectedRevisionId") }}
		}
		<input type="hidden" name="expectedRevisionId" value={revision}/>
		@selectfield.Select(selectfield.Config{
			ID:"account-presence",Name:"presence",Label:v.Text.AccountPresence,
			Options:[]selectfield.Option{
				{Value:"available",Label:v.Text.PresenceAvailable,Selected:selected=="available"},
				{Value:"away",Label:v.Text.PresenceAway,Selected:selected=="away"},
				{Value:"dnd",Label:v.Text.PresenceBusy,Selected:selected=="dnd"},
			},
		})
		if preferences.SendTyping != nil {
			<input type="hidden" name="sendTypingField" value="true"/>
			@toggle.Toggle(toggle.Config{ID:"account-send-typing",Name:"sendTyping",Value:"on",Label:v.Text.SendTyping,Checked:restoreDraft && v.field("sendTyping")=="on" || !restoreDraft && *preferences.SendTyping})
		}
		if preferences.SendReadReceipts != nil {
			<input type="hidden" name="sendReadReceiptsField" value="true"/>
			@toggle.Toggle(toggle.Config{ID:"account-send-read-receipts",Name:"sendReadReceipts",Value:"on",Label:v.Text.SendReadReceipts,Checked:restoreDraft && v.field("sendReadReceipts")=="on" || !restoreDraft && *preferences.SendReadReceipts})
		}
		@button.Button(button.WithType("submit"),button.WithSize(button.SizeSmall)){ {v.Text.AccountPresenceSave} }
		<p data-form-feedback role="status" aria-live="polite">
			if v.FormTarget == "account-communication" {
				{v.ErrorMessage}
			}
		</p>
		<div hidden data-communication-refresh>
			@link.Link(v.accountsHref(account)) { {v.Text.AccountCommunicationReload} }
		</div>
	}
}
