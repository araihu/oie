package web

import (
	"github.com/araihu/goshtoso/components/button"
	selectfield "github.com/araihu/goshtoso/components/select"
	"github.com/araihu/goshtoso/components/textinput"
)

templ diagnosticsSettings(v view) {
	@settingsSubpage("diagnostics", v.Text.Diagnostics, v.Text.BackToSettings) {
		<section class="oie-diagnostics" data-diagnostics data-loading={ v.Text.DiagnosticsLoading } data-empty={ v.Text.DiagnosticsEmpty } data-unavailable={ v.Text.DiagnosticsUnavailable } data-enter-key={ v.Text.DiagnosticsEnterKey } data-truncated={ v.Text.DiagnosticsTruncated } data-copied={ v.Text.DiagnosticsCopied } data-copy-failed={ v.Text.DiagnosticsCopyFailed } data-download-failed={ v.Text.DiagnosticsDownloadFailed }>
			<div class="oie-diagnostics-filters">
				if v.RemoteDiagnostics {
					@selectfield.Select(selectfield.Config{
						ID: "diagnostics-source", Label: v.Text.DiagnosticsSource,
						InputAttrs: templ.Attributes{"data-diagnostics-source": ""},
						Options: []selectfield.Option{
							{Value: "local", Label: v.Text.DiagnosticsDevice, Selected: true},
							{Value: "server", Label: v.Text.DiagnosticsServer},
						},
					})
				}
				@selectfield.Select(selectfield.Config{
					ID: "diagnostics-range", Label: v.Text.DiagnosticsRange,
					InputAttrs: templ.Attributes{"data-diagnostics-hours": ""},
					Options: []selectfield.Option{
						{Value: "1", Label: v.Text.DiagnosticsHour},
						{Value: "24", Label: v.Text.DiagnosticsDay, Selected: true},
						{Value: "168", Label: v.Text.DiagnosticsWeek},
					},
				})
			</div>
			<div class="flex flex-wrap items-center gap-2">
				@button.Button(button.WithType("button"), button.WithAttrs(templ.Attributes{"data-diagnostics-refresh": ""})) { { v.Text.DiagnosticsRefresh } }
				@button.Button(button.WithType("button"), button.WithAttrs(templ.Attributes{"data-diagnostics-copy": "", "disabled": true})) { { v.Text.DiagnosticsCopy } }
				@button.Button(button.WithType("button"), button.WithAttrs(templ.Attributes{"data-diagnostics-download": "", "disabled": true})) { { v.Text.DiagnosticsDownload } }
			</div>
			<p role="status" class="oie-diagnostics-status" data-diagnostics-status></p>
			<div class="oie-diagnostics-content">
				<pre data-diagnostics-records tabindex="0" aria-label={ v.Text.Diagnostics }></pre>
				<form class="oie-diagnostics-access" method="post" data-diagnostics-access hidden>
					@textinput.TextInput(textinput.Config{
						ID: "diagnostics-key", Label: v.Text.DiagnosticsKey, Type: textinput.TypePassword,
						MaxLength: 512, Autocomplete: "off",
					})
					@button.Button(button.WithType("submit")) { { v.Text.DiagnosticsUnlock } }
				</form>
			</div>
		</section>
	}
}
