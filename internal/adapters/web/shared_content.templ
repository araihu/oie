package web

import (
 "github.com/araihu/goshtoso/components/avatar"
 "github.com/araihu/goshtoso/components/card"
 "github.com/araihu/goshtoso/components/checkbox"
 "github.com/araihu/goshtoso/components/emptystate"
 "github.com/araihu/goshtoso/components/icon/heroicons"
 "github.com/araihu/goshtoso/components/link"
 "github.com/araihu/goshtoso/components/navbar"
 "github.com/araihu/goshtoso/components/skeleton"
 "github.com/araihu/goshtoso/components/combobox"
 "github.com/araihu/goshtoso/components/textinput"
 "github.com/araihu/goshtoso/components/toolbar"
 "github.com/araihu/goshtoso/expressions"
 "github.com/araihu/oie/internal/adapters/httpapi/engineapi"
 "strconv"
)

templ sharedWorkspace(v view){
<section id="workspace" class="oie-shared-workspace" aria-label={v.Text.SharedMedia}>
<header class="oie-shared-header">
@navigationControl(v)
<h2>{v.Text.SharedMedia}</h2>

</header>
<form action="/" method="get" id="shared-content-search" class="oie-shared-search" role="search" hx-sync="this:replace">
<input type="hidden" name="section" value="media"/><input type="hidden" name="contentType" value={v.SharedType}/><input type="hidden" name="contentConversation" value={v.SharedConversation}/><input type="hidden" name="lang" value={v.Locale}/><input type="hidden" name="theme" value={v.Theme}/>
<input type="hidden" name="account" value={v.AccountFilter}/>
<input type="hidden" name="contentAccount" value="" data-shared-all-accounts disabled?={v.AccountFilter == "" || v.SharedAccountIDs == nil || len(v.SharedAccountIDs) > 0}/>
@toolbar.Toolbar(toolbar.Config{Label:v.Text.SharedTools,RootClass:"oie-shared-toolbar",SearchClass:"oie-shared-search-region",FiltersClass:"oie-shared-filter-region",Search:sharedSearch(v),Filters:sharedAccountFilter(v)})
@sharedRetractionFilter(v,"shared-include-retracted","contentIncludeRetracted")
</form>
@sharedSearchResults(v)
</section>
}
templ sharedFragment(v view){
<div data-shared-fragment data-engine-id={v.EngineID} data-account-filter={v.AccountFilter}>
@avatarData(v)
@accountTrigger(v)
@accountMenu(v)
@sharedAccountFilter(v)
@sharedSearchResults(v)
</div>
}
templ sharedSearchResults(v view){
<div id="shared-search-results" class="oie-shared-search-results" data-search-query={v.Query}>
@sharedTypeNavigation(v)
if v.SharedConversation!="" {
@link.Link(v.sharedHref("contentConversation","","contentCursor",""),link.WithRootClass("oie-shared-scope")){ {v.Text.SharedAllChats} }
}
<div class="oie-shared-results-frame">
<div id="shared-content-scroll" class="oie-shared-scroll" tabindex="0" aria-label={v.Text.SharedMedia}>
<div id="shared-content-status" role="status">@sharedStatus(v)</div>
<div id="shared-content-results" data-version={v.sharedVersion()} data-content-type={v.SharedType}>@sharedItems(v)</div>
<div id="shared-content-pagination">@sharedPagination(v)</div>
</div>
@sharedSkeleton(v,false)
</div>
</div>
}
templ sharedSkeleton(v view,entry bool){
<div class="oie-shared-skeleton" data-shared-skeleton?={!entry} data-shared-entry-skeleton?={entry} data-shared-catalog?={!v.SharedInDetails} hidden>
 <div class="sr-only" role="status">{v.Text.SharedLoading}</div>
 <div class="oie-shared-grid" data-shared-placeholders aria-hidden="true"></div>
 <template data-shared-placeholder>
  @skeleton.Skeleton(skeleton.Config{Shape:skeleton.ShapeRectangle,RootClass:"oie-shared-placeholder"})
 </template>
</div>
}
templ sharedSearch(v view){
{{ ctx=expressions.With(ctx,expressions.Set{TextInput:expressions.TextInput{SearchAriaLabel:v.Text.SharedSearch}}) }}
@textinput.TextInput(textinput.Config{ID:"shared-search",Name:"q",Value:v.Query,Type:textinput.TypeSearch,Placeholder:v.Text.SharedSearch,InputAttrs:templ.Attributes{"hx-get":"/","hx-trigger":"oie:shared-search","hx-include":"#shared-content-search","hx-target":"#shared-search-results","hx-select":"#shared-search-results","hx-swap":"outerHTML show:none","hx-sync":"closest form:replace","hx-headers":`{"X-Oie-Fragment":"shared"}`,"hx-push-url":"false","hx-replace-url":"true","aria-controls":"shared-search-results"}})
}
templ sharedAccountFilter(v view){
{{ ctx=expressions.With(ctx,expressions.Set{Combobox:expressions.Combobox{ClearLabel:v.Text.SearchClearAccounts,SelectedLabel:v.messageSearchAccountCount}}) }}
{{ cfg:=sharedAccountCombobox(v) }}
@combobox.Combobox(cfg,cfg.InitialState())
}
func sharedTypeNavigation(v view) templ.Component {
  category := func(kind, label string) navbar.SecondaryLink {
    current := navbar.SecondaryCurrentNone
    if v.SharedType == kind {
      current = navbar.SecondaryCurrentPage
    }
    return navbar.SecondaryLink{
      Label: label,
      Href: v.sharedHref("contentType", kind, "contentCursor", ""),
      Current: current,
      LinkAttrs: templ.Attributes{"data-shared-tab": kind},
    }
  }
  return navbar.SecondaryRow(navbar.SecondaryConfig{
    AriaLabel: v.Text.SharedContentTypes,
    RootClass: "oie-shared-navigation",
    Links: []navbar.SecondaryLink{
      category("media", v.Text.SharedMediaTab),
      category("links", v.Text.SharedLinksTab),
      category("documents", v.Text.SharedDocsTab),
    },
  })
}
templ sharedStatus(v view){
if v.Unavailable {
<p>{v.Text.UnavailableBody}</p>
@link.Link(v.sharedHref()){ {v.Text.Retry} }
}else if v.SharedInvalid {
<p>{v.Text.SharedPageUnavailable}</p>
@link.Link(v.sharedHref("contentCursor","")){ {v.Text.SharedNewest} }
}else if v.SharedContent==nil {
<p>{v.Text.SharedUnavailable}</p>
@link.Link(v.sharedHref(),link.WithAttrs(templ.Attributes{"data-shared-retry":""})){ {v.Text.Retry} }
}else if v.SharedContent.Indexing.State=="pending" {
<p data-shared-indexing>{v.Text.SharedFinding} <span>{strconv.FormatInt(v.SharedContent.Indexing.IndexedMessages,10)} / {strconv.FormatInt(v.SharedContent.Indexing.TotalMessages,10)}</span></p>
}
}
templ sharedItems(v view){
if v.SharedContent!=nil {
if len(v.SharedContent.Items)==0 {
@emptystate.EmptyState(emptystate.Config{Title:v.Text.SharedEmpty,Description:v.Text.SharedEmptyHelp})
}else{
for _,item:=range v.SharedContent.Items {
@sharedItem(v,item)
}
}
}
}
templ sharedItem(v view,item engineapi.SharedContentItem){
{{ position := messageTimelineTime(item.Message) }}
{{ sticker := item.Kind=="image" && item.Message.StickerUrl!=nil && item.Url==*item.Message.StickerUrl && item.Message.Moderation==nil && item.Message.Retraction==nil }}
<article class="oie-shared-item" if sticker { data-sticker-description={sharedStickerDescription(item)} } data-shared-item={item.Id} data-shared-record-version={sharedItemVersion(item)} data-shared-created-at={position.Format("2006-01-02T15:04:05Z07:00")} data-shared-created-ms={strconv.FormatInt(position.UnixMilli(),10)} data-shared-conversation={item.Message.ConversationId}>
@sharedViewerSource(v,item)
@sharedItemActions(v,item)
if item.Kind=="video" {
@videoCard(v,item)
}else if item.Kind=="audio" {
@retainedAudioPlayer(sharedCardView(v),item)
}else if item.Kind=="document" {
@documentCard(v,item)
}else if item.Preview!=nil {
@messagePreview(sharedCardView(v),*item.Preview)
}else{
@card.Card(card.Config{Title:v.sharedTitle(item),TitlePrefix:sharedKindIcon(string(item.Kind)),Body:sharedReference(v,item),Density:card.DensityCompact,RootClass:"oie-shared-reference"})
}
<footer class="oie-shared-source">
if item.Message.Retraction != nil || item.Message.Moderation != nil {
<small>{v.Text.MessageRetracted}</small>
}
<strong>{item.ConversationTitle}</strong><small>{v.sharedAccountLabel(item)} · {item.Message.Sender.DisplayName}</small>
<time data-shared-source-date datetime={position.Format("2006-01-02T15:04:05Z07:00")}>{position.Format("2006-01-02 15:04")}</time>
</footer>
</article>
}
templ sharedKindIcon(kind string){
switch kind {
case "video":
@glyph(heroicons.Icon16SolidPlay)
case "document":
@glyph(heroicons.Icon16SolidDocumentText)
default:
@glyph(heroicons.Icon16SolidLink)
}
}
templ sharedReference(v view,item engineapi.SharedContentItem){
<p class="oie-shared-kind">{v.sharedKindLabel(string(item.Kind))}</p>
@link.Link(safePreviewURL(item.Url),link.WithAttrs(templ.Attributes{"target":"_blank","rel":"noopener noreferrer","data-shared-reference":""})){ {v.Text.SharedOpenLink} }
}
templ sharedPagination(v view){
@sharedPageControls(v)
}
templ sharedViewerSource(v view,item engineapi.SharedContentItem){
{{ position := messageTimelineTime(item.Message) }}
<template data-viewer-source={item.Message.Id}>
<div class="oie-viewer-source" data-viewer-source-id={item.Message.Id}>
@profileAvatar(v,item.Message.AccountId,v.sharedSenderAddress(item),avatar.Config{Name:item.Message.Sender.DisplayName,Size:avatar.SizeXS})
<div class="oie-viewer-sender"><strong title={item.Message.Sender.DisplayName}>{item.Message.Sender.DisplayName}</strong><time data-viewer-date datetime={position.Format("2006-01-02T15:04:05Z07:00")}>{position.Format("2006-01-02 15:04")}</time></div>
</div>
</template>
}

templ sharedRetractionFilter(v view, id, name string) {
	@checkbox.Checkbox(checkbox.Config{ID:id,Name:name,Value:"true",Label:v.Text.IncludeRetracted,Checked:v.SharedIncludeRetracted,InputAttrs:templ.Attributes{"data-shared-retraction-filter":""}})
}
