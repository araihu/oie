package web

import (
	"github.com/araihu/goshtoso/components/button"
	"github.com/araihu/goshtoso/components/form"
	"github.com/araihu/goshtoso/components/link"
	"github.com/araihu/oie/internal/adapters/httpapi/engineapi"
)

templ accountRemoval(v view, a engineapi.Account) {
	<section class="oie-account-intro">
		<h2 tabindex="-1" data-account-remove-title>{ v.Text.RemoveAccount }</h2>
		<p><strong>{ a.Label }</strong> · { a.Address }</p>
		<p>{ v.Text.RemoveAccountWarning }</p>
	</section>
	@form.Form(form.Config{ID: "remove-account-form", Action: "/ui/accounts/remove", Method: "post", RootAttrs: templ.Attributes{
		"data-oie-action": "remove-account", "data-remove-failed": v.Text.RemoveAccountFailed, "data-removing": v.Text.RemovingAccount,
	}}) {
		@mutationFieldsAt(v, "remove-account", "", v.removeAccountHref(a.Id))
		<input type="hidden" name="accountId" value={ a.Id }/>
		<input type="hidden" name="viewAccount" value={ selectedAccountID(v) }/>
		<input type="hidden" name="confirmation" value="remove"/>
		<input type="hidden" name="lang" value={ v.Locale }/>
		<div class="flex flex-wrap items-center gap-3">
			@link.Link(v.href("open", "accounts", "managedAccount", a.Id, "accountFocus", "remove"), link.WithAttrs(templ.Attributes{"data-remove-cancel": ""})) {
				{ v.Text.DeleteDataCancel }
			}
			@button.Button(button.WithType("submit"), button.WithTone(button.ToneDanger)) {
				<span class="oie-remove-submit-label">
					<span>{ v.Text.RemoveAccount }</span>
					<span>{ v.Text.RemovingAccount }</span>
				</span>
			}
		</div>
		<div class="sr-only" data-form-feedback role="status" aria-live="polite"></div>
	}
}
