package web

import (
	"github.com/araihu/goshtoso/components/icon"
	"github.com/araihu/goshtoso/components/icon/heroicons"
	"github.com/araihu/goshtoso/components/radio"
	"strconv"
)

// Keep the existing per-device preference route and fragment lifecycle.
func appearanceOption(v view, value, label string, symbol icon.Symbol) radio.Config {
	return radio.Config{
		ID:           "appearance-" + value,
		Name:         "theme",
		Value:        value,
		Label:        label,
		LabelLeading: glyph(symbol),
		Segmented:    true,
		Checked:      v.Theme == value || value == "system" && v.Theme == "",
		Alpine:       &radio.AlpineConfig{Model: "appearance"},
		HTMX:         &radio.HTMXConfig{Get: "/?theme="+value, Target: "#appearance-settings", Swap: "outerHTML show:none", PushURL: false},
		InputAttrs:   templ.Attributes{"hx-select": "#appearance-settings", "hx-headers": `{"X-Oie-Fragment":"appearance"}`, "hx-params": "none"},
	}
}

templ appearanceSettings(v view) {
<section id="appearance-settings" data-mode={v.Theme}>
	<h2>{ v.Text.Appearance }</h2>
	<div role="radiogroup" aria-label={ v.Text.Appearance } x-data={ "{ appearance: " + strconv.Quote(v.Theme) + " }" }>
		@radio.RadioBar() {
			@radio.Radio(appearanceOption(v, "system", v.Text.System, heroicons.Icon16SolidWindow))
			@radio.Radio(appearanceOption(v, "light", v.Text.Light, heroicons.Icon16SolidSun))
			@radio.Radio(appearanceOption(v, "dark", v.Text.Dark, heroicons.Icon16SolidMoon))
		}
	</div>
</section>
}
