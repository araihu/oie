package web

import (
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/card"
 "github.com/araihu/goshtoso/components/chatbubble"
 "github.com/araihu/goshtoso/components/dropdown"
 "github.com/araihu/goshtoso/components/icon/heroicons"
 "github.com/araihu/goshtoso/components/spinner"
)

// A local submission is separate from authoritative timeline rows. It is retired
// only after the accepted message ID appears, never by matching message text.
templ pendingSendTemplate(v view) {
 <template data-pending-send-template>
  <div class="oie-message oie-message-own" data-pending-send tabindex="-1">
   <div class="oie-message-content" data-pending-send-content>
    @chatbubble.ChatBubble(chatbubble.Config{Side:chatbubble.Sent,RootClass:"oie-bubble",MessageContent:pendingSendBody(v)})
   </div>
    <span class="sr-only" role="status" aria-live="polite" aria-atomic="true" data-pending-send-status>
     <span class="sr-only" data-pending-state="sending">{v.Text.SendPending}</span>
     <span data-pending-state="uncertain" hidden>{v.Text.SendUnconfirmed}</span>
     <span class="sr-only" data-pending-state="accepted" hidden>{v.Text.SendAccepted}</span>
    </span>
  </div>
 </template>
}

templ pendingSendBody(v view) {
 <div class="oie-message-body oie-message-body-compact">
  <div class="oie-message-menu-slot">
   @dropdown.Dropdown(dropdown.Config{ID:"pending-send-menu",Label:v.Text.MessageActions,Trigger:messageMenuTrigger(v,"pending-send"),RootClass:"oie-message-menu",MenuAlign:dropdown.AlignEnd,Sections:[]dropdown.Section{{Items:[]dropdown.Item{{ID:"retry-pending-send",Label:v.Text.RetrySubmission,Icon:glyph(heroicons.Icon16SolidArrowPath),OnClick:"void 0"}}}}})
  </div>
  <div data-pending-send-reply hidden>
   @card.Card(card.Config{Body:pendingSendReplyExcerpt(),Density:card.DensityCompact,RootClass:"oie-reply-card"})
  </div>
  <div class="oie-plain-fallback" data-pending-send-text></div>
 <div class="oie-message-attachments" data-pending-send-attachments hidden></div>
 <template data-pending-send-file>
  <a>
   <img alt="" width="224" height="128" loading="lazy"/>
   <span></span>
  </a>
 </template>
  <div class="oie-message-stamp">
   <span class="oie-send-state-slot">
    <span data-pending-state="sending" role="img" aria-label={v.Text.SendPending} title={v.Text.SendPending}>@spinner.Spinner(spinner.Config{Size:spinner.SizeSM,RootClass:"oie-send-spinner"})</span>
    <span data-pending-state="accepted" hidden role="img" aria-label={v.Text.Queued} title={v.Text.Queued}>@glyph(heroicons.Icon16SolidClock)</span>
    <span data-pending-state="uncertain" hidden>
     @button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-send-retry"),button.WithAttrs(templ.Attributes{"data-pending-send-retry":"","aria-label":v.Text.SendUnconfirmed+" · "+v.Text.RetrySubmission,"title":v.Text.SendUnconfirmed+" · "+v.Text.RetrySubmission})){@glyph(heroicons.Icon16SolidArrowPath)}
    </span>
   </span>
   <time data-pending-send-time></time>
  </div>
 </div>
}

templ pendingSendReplyExcerpt() {
 <p class="oie-reply-excerpt" data-pending-send-excerpt></p>
}
