package web

import (
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/card"
 "github.com/araihu/goshtoso/components/icon/heroicons"
 "github.com/araihu/goshtoso/components/link"
 "github.com/araihu/oie/internal/adapters/httpapi/engineapi"
)

// Native controls receive a same-origin source only after an explicit gesture.
// Initial markup has neither src nor source children, including in galleries.
templ videoCard(v view,item engineapi.SharedContentItem){
<section class="oie-video-card" data-video-item={item.Id} data-video-engine={v.EngineID} data-video-account={item.Message.AccountId} data-video-conversation={item.Message.ConversationId} data-video-message={item.Message.Id} data-video-source={"/ui/shared-content/"+item.Id+"/content?engineId="+v.EngineID} data-video-loading={v.Text.VideoLoading} data-video-playing={v.Text.VideoPlaying} data-video-paused={v.Text.VideoPaused} data-video-ready={v.Text.VideoReady} data-video-unavailable={v.Text.VideoUnavailable} data-video-unsupported={v.Text.VideoUnsupported}>
@card.Card(card.Config{Media:videoPlayer(v),MediaClass:"oie-video-media",Body:videoMetadata(v,item),Density:card.DensityCompact,RootClass:"oie-video-surface"})
</section>
}

templ videoPlayer(v view){
<div class="oie-video-stage">
<video data-video-player controls playsinline preload="none" tabindex="0" hidden aria-label={v.Text.SharedVideo}>{v.Text.VideoUnsupported}</video>
<div class="oie-video-cover" data-video-cover>
@button.Button(button.WithType("button"),button.WithSize(button.SizeSmall),button.WithRootClass("oie-video-play"),button.WithAttrs(templ.Attributes{"data-video-play":""})){@glyph(heroicons.Icon16SolidPlay)<span class="oie-video-play-label">{v.Text.VideoPlay}</span>}
</div>
</div>
}

templ videoMetadata(v view,item engineapi.SharedContentItem){
<div data-video-metadata>
<strong data-video-label>{v.sharedTitle(item)}</strong>
<p data-video-status role="status" aria-live="polite" data-state="ready">{v.Text.VideoReady}</p>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"data-video-retry":"","hidden":true})){ {v.Text.VideoRetry} }
@link.Link(safePreviewURL(item.Url),link.WithAttrs(templ.Attributes{"target":"_blank","rel":"noopener noreferrer","data-video-original":""})){ {v.Text.SharedOpenLink} }
</div>
}
