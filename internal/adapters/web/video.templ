package web

import (
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/card"
 "github.com/araihu/goshtoso/components/panel"
 "github.com/araihu/goshtoso/components/icon/heroicons"
 "github.com/araihu/oie/internal/adapters/httpapi/engineapi"
)

// Native controls receive a same-origin source only after an explicit gesture.
// Initial markup has neither src nor source children, including in galleries.
templ videoCard(v view,item engineapi.SharedContentItem){
<section class="oie-video-card" data-video-compact?={v.Section=="media"||v.SharedInDetails} data-video-thumbnail-state={videoThumbnailState(item)} data-video-poster={videoPoster(item)} data-thumbnail-load-label={v.Text.VideoThumbnailLoad} data-thumbnail-retry-label={v.Text.Retry} data-video-thumbnail-loading={v.Text.VideoThumbnailLoading} data-video-thumbnail-failed={v.Text.VideoThumbnailFailed} data-video-item={item.Id} data-video-engine={v.EngineID} data-video-account={item.Message.AccountId} data-video-conversation={item.Message.ConversationId} data-video-message={item.Message.Id} data-video-revision={item.Message.RevisionId} data-video-source={"/ui/shared-content/"+item.Id+"/content?engineId="+v.EngineID} data-video-loading={v.Text.VideoLoading} data-video-playing={v.Text.VideoPlaying} data-video-paused={v.Text.VideoPaused} data-video-ready={v.Text.VideoReady} data-video-unavailable={v.Text.VideoUnavailable} data-video-unsupported={v.Text.VideoUnsupported}>
if v.Section=="media"||v.SharedInDetails {
@panel.Panel(panel.Config{Body:videoGalleryMedia(v,item),BodyClass:"oie-video-media",Appearance:panel.AppearancePlain,Density:panel.DensityCompact,RootClass:"oie-video-surface"})
}else{
@card.Card(card.Config{Media:videoPlayer(v,item),MediaClass:"oie-video-media",Body:videoMetadata(v,item),Density:card.DensityCompact,RootClass:"oie-video-surface"})
}
<p class="sr-only" data-video-thumbnail-status role="status" aria-live="polite" hidden></p>
</section>
}

templ videoGalleryMedia(v view,item engineapi.SharedContentItem){
@videoPlayer(v,item)
@videoMetadata(v,item)
}

templ videoPlayer(v view,item engineapi.SharedContentItem){
<div class="oie-video-stage">
<video data-video-player controls playsinline preload="none" tabindex="0" hidden aria-label={v.Text.SharedVideo}
if v.Section=="media"||v.SharedInDetails {
controlslist="nodownload"
}
>{v.Text.VideoUnsupported}</video>
<div class="oie-video-cover" data-video-cover>
<img class="oie-video-poster" data-video-poster-image alt="" aria-hidden="true" hidden?={videoPoster(item)==""} if videoPoster(item)!="" { src={videoPoster(item)} }/>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-video-play"),button.WithAttrs(templ.Attributes{"data-video-play":"","aria-label":v.Text.VideoPlay,"title":v.Text.VideoPlay})){@glyph(heroicons.Icon16SolidPlay)}
</div>
</div>
}

templ videoMetadata(v view,item engineapi.SharedContentItem){
<div data-video-metadata hidden?={v.Section=="media"||v.SharedInDetails}>
<strong data-video-label hidden?={v.Section=="media"||v.SharedInDetails}>{v.sharedTitle(item)}</strong>
<p class="sr-only" data-video-status role="status" aria-live="polite" data-state="ready" hidden></p>
</div>
}

templ videoFallbackControls(v view){
<template data-video-fallback-template>
<div class="oie-fallback-player">
<div class="oie-fallback-picture"></div>
<div class="oie-fallback-controls">
<button type="button" data-fallback-toggle data-play={v.Text.VideoPlay} data-pause={v.Text.VideoPause} aria-label={v.Text.VideoPause}><span data-fallback-pause-icon>@glyph(heroicons.Icon16SolidPause)</span><span data-fallback-play-icon hidden>@glyph(heroicons.Icon16SolidPlay)</span></button>
<input data-fallback-seek type="range" min="0" max="0" value="0" step="0.1" aria-label={v.Text.VideoSeek}/>
<button type="button" data-fallback-sound hidden aria-label={v.Text.VideoEnableSound}>{v.Text.VideoEnableSound}</button>
<input data-fallback-volume type="range" min="0" max="1" value="1" step="0.05" aria-label={v.Text.VideoVolume}/>
<a data-fallback-download download aria-label={v.Text.VideoDownloadOriginal} title={v.Text.VideoDownloadOriginal}>@glyph(heroicons.Icon16SolidArrowDownTray)</a>
</div>
</div>
</template>
}
