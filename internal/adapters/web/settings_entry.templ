package web

import "github.com/araihu/goshtoso/components/icon/heroicons"
import "github.com/araihu/goshtoso/components/link"

// The same navigation footer owns the sole settings entry on both layouts.
templ navigationFooter(v view,id string){
<div class="flex shrink-0 items-center gap-1 px-2" data-navigation-footer={id} x-data="{}">
<div class="min-w-0 flex-1">@profile(v,id)</div>
@link.Link("#settings",link.WithRole("button"),link.WithRootClass("oie-icon-button"),link.WithAttrs(templ.Attributes{"data-navigation-settings":"","aria-label":v.Text.Settings,"title":v.Text.Settings,"aria-haspopup":"dialog","x-on:click.prevent":"$dispatch('drawer:open', {id: 'settings'})","x-on:keydown.space.prevent":"$el.click()"})){@glyph(heroicons.Icon16SolidCog6Tooth)}
</div>
}
