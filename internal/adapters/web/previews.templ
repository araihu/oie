package web

import (
 "github.com/araihu/goshtoso/components/button"
 "github.com/araihu/goshtoso/components/dropdown"
 "github.com/araihu/goshtoso/components/icon/heroicons"
 "github.com/araihu/goshtoso/components/link"
 "github.com/araihu/goshtoso/components/modal"
 "github.com/araihu/goshtoso/components/popover"
 "github.com/araihu/oie/internal/adapters/httpapi/engineapi"
)

// Provider text is plain HTML data. The Alpine expression is fixed application
// code, and image sources are exclusively BFF paths built from validated hashes.
templ messagePreview(v view,p engineapi.MessagePreview){
<section class="oie-message-preview" data-preview-id={p.Id} data-preview-revision={p.RevisionId} data-preview-kind={string(p.Kind)} data-preview-title={previewValue(p.Title)} data-preview-message={p.MessageId} data-preview-url={safePreviewURL(p.Url)} data-preview-name={previewFilename(p)} data-preview-mime={previewMime(p)} data-preview-size={previewSize(p)} data-preview-description={previewValue(p.Description)} data-preview-site={previewValue(p.SiteName)} data-preview-image={mediaSource(p.ImageHash)} data-preview-favicon={mediaSource(p.FaviconHash)} data-preview-host={previewHost(p)} data-preview-path={linkPreviewPath(p.Url)} data-preview-file={mediaSource(p.FileHash)} data-preview-state={string(p.State)} data-preview-download={string(p.DownloadState)} data-preview-status={v.previewStatus(p)} x-data="{previewTitle:$el.dataset.previewTitle,previewDescription:$el.dataset.previewDescription,previewSite:$el.dataset.previewSite,previewImage:$el.dataset.previewImage,previewFavicon:$el.dataset.previewFavicon,previewHost:$el.dataset.previewHost,previewPath:$el.dataset.previewPath,previewFaviconFailed:false,get previewLinkTitle(){const title=this.previewTitle.trim();return title && title.toLowerCase()!==this.previewHost.toLowerCase()?title:this.previewPath||this.previewHost},previewFile:$el.dataset.previewFile,previewState:$el.dataset.previewState,previewDownload:$el.dataset.previewDownload,previewStatus:$el.dataset.previewStatus,previewBusy:false,previewImageFailed:false}">
if p.Kind=="link" {
@linkFallbackCard(v,p)
}else{
<div class="oie-image-preview">
if !v.SharedCard && len(v.imagePreviews(p.MessageId))>1 {
@dropdown.Dropdown(dropdown.Config{ID:"image-menu-"+p.Id,Label:v.Text.ImageActions,Trigger:imageMenuTrigger(v,p.Id),RootClass:"oie-image-menu",MenuAlign:dropdown.AlignEnd,Sections:imageActions(v,p)})
}
@previewThumbnail(v,p)
<p class="oie-preview-status" x-show="previewStatus" x-text="previewStatus">{v.previewStatus(p)}</p>
@previewImageActions(v)
</div>
}
</section>
}

templ previewThumbnail(v view,p engineapi.MessagePreview){
if p.Kind=="link" {
<img class="oie-preview-thumbnail" if source:=mediaSource(p.ImageHash);source!="" {
src={source}
} alt="" x-cloak x-show="previewImage && !previewImageFailed" x-bind:src="previewImage || null" x-effect="previewImage; previewImageFailed=false" x-on:error="previewImageFailed=true"/>
}else{
@button.Button(button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-preview-image-button"),button.WithAttrs(templ.Attributes{"type":"button","data-preview-expand":"","x-cloak":"","aria-label":v.Text.OpenImage,"x-show":"previewImage && !previewImageFailed","x-bind:disabled":"previewBusy"})){
<img class="oie-preview-thumbnail" if source:=mediaSource(p.ImageHash);source!="" {
src={source}
} alt={v.Text.OpenImage} x-bind:src="previewImage || null" x-effect="previewImage; previewImageFailed=false" x-on:error="previewImageFailed=true"/>
}
}
}

templ previewDescription(v view,p engineapi.MessagePreview){
<div class="oie-preview-description">
<p class="oie-preview-title" x-show="previewTitle" x-text="previewTitle">{previewValue(p.Title)}</p>
<p class="oie-preview-excerpt" x-show="previewDescription" x-text="previewDescription">{previewValue(p.Description)}</p>
<p class="oie-preview-site" x-show="previewSite" x-text="previewSite">{previewValue(p.SiteName)}</p>
<p class="oie-preview-status" x-show="previewStatus" x-text="previewStatus">{v.previewStatus(p)}</p>
</div>
}

templ previewImageActions(v view){
<div class="oie-preview-image-actions" if v.SharedCard { x-show="!previewImage || previewImageFailed" }>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"data-preview-download":"","x-cloak":"","x-show":"!previewImage || previewImageFailed","x-bind:disabled":"previewBusy || previewDownload==='queued' || previewDownload==='downloading'"})){ {v.Text.LoadImage} }
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithAttrs(templ.Attributes{"data-preview-expand":"","x-cloak":"","x-show":"previewFile && (!previewImage || previewImageFailed)","x-bind:disabled":"previewBusy"})){ {v.Text.OpenImage} }
<p data-preview-feedback role="status" aria-live="polite"></p>
</div>
}

templ imageViewer(v view){
<div data-image-viewer x-data="{viewerSrc:'',viewerLabel:'',viewerStatus:'',viewerFailed:false,viewerActive:false,viewerUrl:'',viewerFilename:'',viewerMime:'',viewerSize:''}">
@modal.Dialog(modal.DialogConfig{ID:"oie-image-viewer",Title:v.Text.ImageView,HeaderContent:imageViewerHeader(v),Content:imageViewerContent(v),FullscreenMobile:true})
</div>
}

templ imageViewerContent(v view){
<div class="oie-image-viewer-layout">
<div class="oie-image-viewer-content">
<p role="status" aria-live="polite" x-show="viewerStatus" x-text="viewerStatus"></p>
<img class="oie-expanded-image" alt={v.Text.ImageView} data-failed={v.Text.ImageDownloadFailed} x-cloak x-show="viewerSrc && !viewerFailed" x-bind:src="viewerSrc || null" x-bind:alt="viewerLabel" x-on:error="viewerFailed=true;viewerStatus=$el.dataset.failed"/>
</div>

</div>
}

templ imageInfoTrigger(v view){
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithSize(button.SizeSmall),button.WithRootClass("oie-image-info-trigger"),button.WithAttrs(templ.Attributes{"data-viewer-info":"","aria-label":v.Text.ImageInfo,"title":v.Text.ImageInfo,"x-on:keydown.escape.stop":"handleEscape($event)"})){
@glyph(heroicons.Icon16SolidInformationCircle)
}
}

templ imageInfoContent(v view){
<div id="oie-image-info" class="oie-image-info" x-on:keydown.escape.stop="handleEscape($event)">
<dl>
<div><dt>{v.Text.ImageSource}</dt><dd>@link.Link("",link.WithRootClass("oie-image-source"),link.WithAttrs(templ.Attributes{"data-image-source":"","x-bind:href":"viewerUrl || null","x-text":"viewerUrl","target":"_blank","rel":"noopener noreferrer"})){ }</dd></div>
<div x-show="viewerFilename"><dt>{v.Text.ImageFilename}</dt><dd data-image-filename x-text="viewerFilename"></dd></div>
<div x-show="viewerMime"><dt>{v.Text.ImageType}</dt><dd data-image-type x-text="viewerMime"></dd></div>
<div x-show="viewerSize"><dt>{v.Text.ImageSize}</dt><dd data-image-size x-text="viewerSize"></dd></div>
</dl>
</div>
}

templ imageMenuTrigger(v view,id string){
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-menu-chevron"),button.WithAttrs(templ.Attributes{"data-image-menu-trigger":id,"aria-label":v.Text.ImageActions,"title":v.Text.ImageActions})){@glyph(heroicons.Icon16SolidChevronDown)}
}
templ imageViewerHeader(v view){
<header class="oie-viewer-header">
<div class="oie-viewer-identity" data-viewer-identity></div>
<div class="oie-viewer-toolbar">
@starButton(v,"")
<template x-if="viewerActive">
@popover.Popover(popover.Config{ID:"oie-image-info-popover",Trigger:imageInfoTrigger(v),Content:imageInfoContent(v),Placement:popover.PlacementBottomEnd,Role:"dialog",Label:v.Text.ImageInfo,PanelClass:"oie-image-info-panel",TrapFocus:true})
</template>
@button.Button(button.WithType("button"),button.WithAppearance(button.AppearancePlain),button.WithRootClass("oie-viewer-action"),button.WithAttrs(templ.Attributes{"data-viewer-close":"","aria-label":v.Text.Close,"title":v.Text.Close}),button.WithAlpine(&button.AlpineConfig{OnClick:"$dispatch('modal:close',{id:'oie-image-viewer'})"})){@glyph(heroicons.Icon16SolidXMark)}
</div>
</header>
}
